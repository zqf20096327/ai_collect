re** 是一套同时兼容 Claude Code 与 Codex 的投资研究 Skill 合集，将巴菲特、芒格、段永平、李录四位价值投资大师的方法论系统化、结构化，通过 AI Agent 实现专业级投资研究。", "本仓库保留同一套 canonical workflow，并分别提供 Claude Code commands 与 Codex skills。按你使用的客户端安装即可。"]}, {"term": "ChatGPT", "rel": "mention", "lines": [240, 245], "note": "Codex 安装脚本托管于 chatgpt.com 域名，非竞品陈述", "quotes": ["curl -fsSL https://chatgpt.com/codex/install.sh | sh", "Windows 用户可使用官方 PowerShell 安装命令：`powershell -ExecutionPolicy ByPass -c \"irm https://chatgpt.com/codex/install.ps1 | iex\""]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "70889ab2cd08": {"fn": "QwenLM/Qwen3-Coder", "sha": "70889ab2cd08", "source": "readme", "identity": {"one_liner": "为开发者提供的代码生成与 Agentic Coding 开源大语言模型系列", "review": "Qwen 团队发布的 Qwen3 系列代码模型，含 Qwen3-Coder-Next（基于 Qwen3-Next-80B-A3B-Base，混合注意力与 MoE 架构）、480B-A35B 与 30B-A3B 三个规模，另有 Base 与 FP8/GGUF 版本。模型原生支持 256K 上下文（可用 Yarn 扩展至 1M），覆盖 358 种编程语言，支持 FIM 代码补全，仅支持非思考模式。提供 transformers 推理示例；function calling 依赖 SGLang 与 vLLM 中的新工具解析器。权重发布于 Hugging Face 与 ModelScope。", "highlights": ["支持 358 种编程语言与 256K 原生上下文（Yarn 可扩展至 1M）", "支持 FIM（fill-in-the-middle）代码补全任务", "兼容 Qwen Code、CLINE、Claude Code 等平台的函数调用格式", "提供 Instruct/Base 与 FP8/GGUF 多种权重版本"], "use_cases": ["在本地或私有环境中运行代码生成模型辅助开发", "接入 Qwen Code、Claude Code、Cline 等编码 Agent 工具", "仓库级代码理解与长上下文代码任务", "IDE 内的代码片段补全（FIM）"]}, "filters": {"ai_role": "ai-native", "license_risk": "none", "deploy": "self-host", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": "research"}, "eval": {"target_user": "开发者", "paper_url": "https://arxiv.org/abs/2603.00729", "demo_url": "https://qianwen-res.oss-accelerate-overseas.aliyuncs.com/Qwen3-Coder-Next/openclaw/claw_mix.mp4", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["代码生成", "编码Agent", "开源大模型", "代码补全"], "domain": "AI 模型/代码生成", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["vllm"]}, "intel": {"maintainer_type": "com