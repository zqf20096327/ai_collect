ags": ["本地LLM", "硬件检测", "模型推荐", "CLI工具"], "domain": "LLM 基础设施/本地部署工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L16: Find out which open-source Large Language Models (LLMs) your hardware can comfortably run. `llmfit` inspects your CPU, s", "L25: - **Model Compatibility Engine**: Analyzes model parameter counts, context lengths, and quantization formats (GGUF, AWQ,", "L27: - **REST API Endpoint**: Exposes standard HTTP JSON endpoints (`/api/v1/system`, `/api/v1/models`) for integration into "], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "llama.cpp", "rel": "mention", "lines": [33], "quotes": ["Ships with an interactive TUI (default) and a classic CLI mode. Supports multi-GPU setups, MoE architectures, dynamic qu"]}, {"term": "ollama", "rel": "mention", "lines": [33, 40, 230], "quotes": ["Ships with an interactive TUI (default) and a classic CLI mode. Supports multi-GPU setups, MoE architectures, dynamic qu", "- llmfit-gui — a Windows desktop GUI (PowerShell + WinForms) for llmfit: browse recommendations, download into LM Studio", "If you're looking for a different approach, check out llm-checker -- a Node.js CLI tool with Ollama integration that can"]}, {"term": "deepseek", "rel": "mention", "lines": [230], "quotes": ["If you're looking for a different approach, check out llm-checker -- a Node.js CLI tool with Ollama integration that can"]}, {"term": "mistral", "rel": "mention", "lines": [230], "quotes": ["If you're looking for a different approach, check out llm-checker -- a Node.js CLI tool with Ollama integration that can"]}], "install": [{"term": "cargo", "rel": "support", "lines": [141], "quotes": ["cargo build --release"]}, {"term": "brew", "rel": "support", "lines": [66, 71], "quotes": ["brew install A