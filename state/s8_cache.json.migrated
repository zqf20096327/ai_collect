dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "0b8fe4e41b68": {"fn": "titanwings/distilly", "sha": "0b8fe4e41b68", "source": "readme", "identity": {"one_liner": "把人物经验沉淀为可复用 Agent 技能的人物建模工具", "review": "从聊天记录、文档、访谈、公开资料等素材中提炼人物的经验、判断与表达方式，生成可移植、有出处依据的 Person Profile，并打包为 Agent Skill 供兼容宿主安装调用。覆盖同事、关系、名人三类人物族，各有人物素材收集策略与分析维度。支持八种 Agent 宿主的本地 Skill 发现，数据源包括 Lark、钉钉、Slack、微信（经 WeChatMsg/PyWxDump 导出）、邮件与手动上传。安装方式为将仓库克隆到宿主的 Skills 目录。README 注明当前仍为 demo 版本。", "highlights": ["三类人物族（colleague/relationship/celebrity）单一工作流生成 Person Profile", "支持 Claude Code、Codex、DeepSeek Harness 等八种 Agent 宿主的本地 Skill 发现", "数据源覆盖 Lark/钉钉/Slack API、微信聊天记录 SQLite、PDF/邮件/Markdown 手动上传", "生成的 Skill 支持 delta 合并、对话纠正写入 Correction 层、自动版本归档回滚"], "use_cases": ["同事离职前沉淀其工作流程与判断方式供团队 Agent 复用", "整理与家人朋友的聊天记录生成关系型 Persona Skill", "基于公开访谈与著作为公众人物构建研究型 Profile"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": "https://arxiv.org (COLLEAGUE.SKILL technical report, L229)", "demo_url": null, "self_declared_early": {"flag": true, "lines": [225]}}, "links": {"scenario_tags": ["agent-skills", "人物建模", "数字分身", "知识蒸馏"], "domain": "AI Agent 生态/技能生成", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["创建者 @titanwings", "支持微信/钉钉/飞书数据源", "示例含 ByteDance 工程师"]}, "trust": {"confidence": "high", "evidence": ["L24: Distilly is the person-modeling layer for agents. It turns the materials you provide into a portable, source-grounded Pe", "L74: The old version only ran in Claude Code. Distilly now supports native local Skill discovery across eight agent hosts.", "L88: Each generated Person Profile is packaged as an Agent Skill and can be installed into any supported host."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [40, 74, 76, 136], "note": "Claude Code 为宿主支持与 CLAUDE.md 路径提及", "quotes": ["> 🧬 **2026.08.24 Update** — The creator is now named **Distilly** end to end and documents native local Skill discovery ", "The old version only ran in Claude Code. Distilly now supports native local Skill discovery across eight agent hosts.", " Claude Code", "**New personal agent?** Say *\"Use Distilly to set up my profile.\"* Distilly interviews you for about five minutes, shows"]}, {"term": "deepseek", "rel": "mention", "lines": [40, 81], "note": "DeepSeek Harness 列为支持的宿主之一", "quotes": ["> 🧬 **2026.08.24 Update** — The creator is now named **Distilly** end to end and documents native local Skill discovery ", " DeepSeek Harness"]}, {"term": "xai", "rel": "mention", "lines": [40, 83, 86, 94], "note": "Grok Build/Grok Bot 列为支持或预览宿主", "quotes": ["> 🧬 **2026.08.24 Update** — The creator is now named **Distilly** end to end and documents native local Skill discovery ", " Grok Build", "**Grok Bot preview:** Grok Bot supports saved/private Skills, but its official docs do not describe direct local `SKILL.", " Grok Bot Grok Bot saved Skill · preview"]}], "install": [{"term": "source", "rel": "support", "lines": [128, 129], "quotes": ["```bash", "git clone https://github.com/titanwings/distilly <DISTILLY_SKILL_DIR>"]}], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [40, 74, 76, 136], "note": "支持的宿主平台之一，非替代/竞品对象", "quotes": ["> 🧬 **2026.08.24 Update** — The creator is now named **Distilly** end to end and documents native local Skill discovery ", "The old version only ran in Claude Code. Distilly now supports native local Skill discovery across eight agent hosts.", " Claude Code", "**New personal agent?** Say *\"Use Distilly to set up my profile.\"* Distilly interviews you for about five minutes, shows"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "768ac87ec835": {"fn": "SYSTRAN/faster-whisper", "sha": "768ac87ec835", "source": "readme", "identity": {"one_liner": "基于 CTranslate2 的 Whisper 语音转写推理库", "review": "使用 CTranslate2 推理引擎重新实现的 OpenAI Whisper 语音转写库，提供 Python API 加载模型并对音频文件转写。支持 CPU 与 GPU 运行，支持 int8/fp16 量化与批量转写管线，内置 Silero VAD 过滤无语音片段，可输出词级时间戳。模型可按尺寸从 Hugging Face Hub 自动下载，也可用脚本将 Transformers 兼容的 Whisper 模型转换为 CTranslate2 格式。经 PyPI 安装，GPU 运行需另行安装 cuBLAS 与 cuDNN 9。", "highlights": ["基于 CTranslate2 的 Whisper 推理，支持 int8/fp16 量化", "BatchedInferencePipeline 批量转写，接口与单条转写兼容", "集成 Silero VAD 过滤静音段，支持词级时间戳", "提供模型转换脚本，可加载微调后的 Whisper 模型"], "use_cases": ["把音频文件批量转写为带时间戳的文字", "在 CPU 或 GPU 上本地运行 Whisper 语音识别", "将自定义微调的 Whisper 模型转为 CTranslate2 格式部署"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["语音识别", "语音转文本", "推理引擎", "模型量化"], "domain": "语音识别/推理基础设施", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L5: **faster-whisper** is a reimplementation of OpenAI's Whisper model using CTranslate2, which is a fast inference engine f", "L7: This implementation is up to 4 times faster than openai/whisper for the same accuracy while using less memory. The effic"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "cpu-infer", "rel": "none", "lines": [], "quotes": []}], "install": [{"term": "pypi", "rel": "support", "lines": [96, 99], "quotes": ["The module can be installed from PyPI:", "pip install faster-whisper"]}, {"term": "pypi", "rel": "mention", "lines": [68], "note": "依赖库 ctranslate2 降级的 pip 安装说明", "quotes": ["**Note**: The latest versions of `ctranslate2` only support CUDA 12 and cuDNN 9. For CUDA 11 and cuDNN 8, the current wo"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "0798f75890c5": {"fn": "shap/shap", "sha": "0798f75890c5", "source": "readme", "identity": {"one_liner": "给机器学习模型输出提供 Shapley 值解释的 Python 库", "review": "基于博弈论 Shapley 值，为任意机器学习模型的输出计算特征归因（SHAP 值），并提供 force plot、beeswarm、scatter、bar、dependence plot 等可视化接口。针对不同模型类型提供多种解释器：TreeExplainer（树模型精确高速 C++ 实现）、DeepExplainer 与 GradientExplainer（TensorFlow/Keras/PyTorch 深度模型近似）、LinearExplainer（线性模型）、KernelExplainer（模型无关）。以 Python 包形式发布，支持 PyPI 与 conda-forge 安装，可选 CUDA extra 启用 GPU 加速的 Tree SHAP。", "highlights": ["TreeExplainer 对 XGBoost/LightGBM/CatBoost/scikit-learn/pyspark 树模型提供 C++ 精确算法", "DeepExplainer/GradientExplainer 支持 TensorFlow/Keras/PyTorch 深度模型", "KernelExplainer 为模型无关方法，可解释任意函数", "TreeExplainer 支持 SHAP interaction values 的成对交互精确计算"], "use_cases": ["解释树集成模型（如 XGBoost）每个特征对预测的贡献", "可视化深度学习模型（如图像分类）的输入归因", "分析特征交互与特征重要性排序", "对 NLP transformers 模型输出做特征归因解释"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "科研", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["模型可解释性", "特征归因", "机器学习", "可视化"], "domain": "机器学习/模型可解释性", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L10: **SHAP (SHapley Additive exPlanations)** is a game theoretic approach to explain the output of any machine learning mode", "L40: While SHAP can explain the output of any machine learning model, we have developed a high-speed exact algorithm for tree"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [14, 17, 27], "quotes": ["SHAP can be installed from either PyPI or conda-forge:", "pip install shap", "pip install shap[cuda]"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "ec7a1a4bd0ec": {"fn": "browserbase/stagehand", "sha": "ec7a1a4bd0ec", "source": "readme", "identity": {"one_liner": "面向 agent 开发者的浏览器自动化 SDK：浏览、操作并提取网页数据", "review": "以 SDK 形式提供的浏览器代理工具库，提供 goto/click/locator/screenshot 等 Playwright 风格 API，并以自然语言驱动 act/observe/extract 三类操作与数据抽取；支持通过无障碍树裁剪控制 token 用量，站点变更时自愈刷新动作。提供 TypeScript、Python、Go 三种 SDK，可本地运行（需安装 Chrome），也可指向 Browserbase 云端运行并配置 Model Gateway 接入模型；另提供托管 MCP server、Search/Fetch 接口与多框架集成。MIT 协议。", "highlights": ["Playwright 风格 API（goto/click/locator/screenshot）加自然语言 act/observe/extract", "TypeScript、Python、Go 三语言 SDK", "托管 MCP server 可供 Claude Code、Cursor、Codex 等 MCP 客户端使用", "Search/Fetch 支持无浏览器的网页搜索与 URL 转 markdown"], "use_cases": ["让 agent 自动浏览网页并抽取结构化数据", "为编码 agent（Claude Code/Cursor/Codex）接入浏览器能力", "将现有 Playwright 测试套件迁移到 agent 化自动化", "无需启动浏览器的网页抓取与搜索"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["浏览器自动化", "browser-agent", "数据抽取", "MCP", "Playwright"], "domain": "开发者工具/浏览器自动化", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L7:  Stagehand is the 