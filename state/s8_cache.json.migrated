ull, "install_friction": "medium", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": true, "lines": [3]}}, "links": {"scenario_tags": ["CLI工具", "Office自动化", "AI Agent", "文档生成", "Skill"], "domain": "办公文档自动化/LLM 基础设施", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["README 提供中文版本（L14）"]}, "trust": {"confidence": "mid", "evidence": ["L3: > **OfficeCLI is the world's first and the best Office suite designed for AI agents.**", "L68: This copies the binary to your PATH and installs the **officecli skill** into every AI coding agent it detects — Claude "], "xcheck": {"install_missing": ["pypi"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "none", "lines": [], "quotes": []}], "install": [{"term": "npm", "rel": "support", "lines": [73], "quotes": ["# 1. Install (macOS / Linux) — or: brew install officecli / npm install -g @officecli/officecli"]}, {"term": "brew", "rel": "support", "lines": [73, 168, 169], "quotes": ["# 1. Install (macOS / Linux) — or: brew install officecli / npm install -g @officecli/officecli", "# Homebrew (macOS / Linux)", "brew install officecli"]}, {"term": "pypi", "rel": "none", "lines": [], "quotes": []}, {"term": "source", "rel": "none", "lines": [], "quotes": []}], "hardware": [], "products": [{"term": "GitHub Copilot", "rel": "mention", "lines": [68], "quotes": ["This copies the binary to your PATH and installs the **officecli skill** into every AI coding agent it detects — Claude "]}, {"term": "Claude Code", "rel": "mention", "lines": [68], "quotes": ["This copies the binary to your PATH and installs the **officecli skill** into every AI coding agent it detects — Claude "]}, {"term": "Cursor", "rel": "mention", "lines": [68], "quotes": ["This copies the binary to your PATH and installs the **officecli skill** into every AI coding agent it detects — Claude "]}, {"term": "Windsurf", "rel": "mention", "lines": [68], "quotes": ["This copies the binary to your PATH and installs the **officecli skill** into every AI coding agent it detects — Claude "]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "a288f6af6173": {"fn": "openai/openai-python", "sha": "a288f6af6173", "source": "readme", "identity": {"one_liner": "OpenAI API 官方 Python 客户端库", "review": "面向 Python 3.10+ 应用的 OpenAI REST API 官方 SDK，由 OpenAPI 规范生成，包含全部请求参数与响应字段的类型定义，提供同步与异步客户端。功能覆盖 Responses API、Chat Completions、流式响应（SSE）、Realtime API（WebSocket 音视频对话）、视觉输入、自动分页、文件上传与 Webhook 签名校验；支持 API key、Kubernetes/Azure/GCP 工作负载身份及 X.509 mTLS 多种认证方式，错误按状态码映射为类型化异常。", "highlights": ["同步与异步客户端，HTTPX2 默认传输，可选 aiohttp", "支持 SSE 流式与 Realtime WebSocket 多模态会话", "多认证方式：API key、K8s/Azure/GCP 工作负载身份、X.509 mTLS", "自动分页迭代器与 TypedDict/Pydantic 类型定义"], "use_cases": ["在 Python 应用中调用 OpenAI 模型生成文本或处理图像", "构建低延迟多模态语音/文本实时对话应用", "在云托管环境中用工作负载身份短时令牌替代长期 API key", "接收并校验 OpenAI Webhook 回调事件"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["SDK/API客户端", "Python", "LLM", "官方库"], "domain": "LLM 基础设施/SDK", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L5: The OpenAI Python library provides convenient access to the OpenAI REST API from any Python 3.10+", "L9: It is generated from our OpenAPI specification.", "L19: pip install openai"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "azure", "rel": "mention", "lines": [52, 63, 124], "note": "README 中作为工作负载身份认证的云环境提及", "quotes": ["For secure, automated environments like cloud-managed Kubernetes, Azure, and Google Cloud Platform, you can use workload", "#### Azure (managed identity)", "client to change the identity. Azure clients do not support X.509 workload"]}, {"term": "bedrock", "rel": "none", "lines": [], "quotes": []}], "install": [{"term": "pypi", "rel": "support", "lines": [3, 18, 19, 176], "quotes": ["PyPI version)", "# install from PyPI", "pip install openai", "pip install openai[aiohttp]"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "81bafdcd5ef9": {"fn": "getzep/graphiti", "sha": "81bafdcd5ef9", "source": "readme", "identity": {"one_liner": "为 AI Agent 构建可查询的时序知识图谱框架", "review": "Graphiti 是构建和查询时序上下文图谱的开源框架，面向处理动态数据的 AI Agent。事实带时间有效期窗口、追溯至原始数据（episodes），支持 Pydantic 定义或从数据涌现的本体，新数据增量集成无需全图重算，检索采用语义嵌入+BM25 关键词+图遍历的混合方式。图数据库后端支持 Neo4j、FalkorDB、Amazon Neptune、Kuzu（已弃用），默认使用 OpenAI 做推理与嵌入，另附 MCP server 实现。", "highlights": ["事实带时间有效期窗口，历史查询无需全图重算", "混合检索：语义嵌入 + BM25 关键词 + 图遍历", "增量图构建，支持规定式与习得式本体（Pydantic 模型）", "提供 MCP server，供 AI 助手调用图谱能力"], "use_cases": ["为 AI Agent 构建随交互持续演化的知识图谱", "对频繁变化的数据做时间点查询与事实失效追踪", "替代静态文档切片的 RAG，做结构化上下文检索"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["知识图谱", "RAG", "AI Agent", "记忆/上下文"], "domain": "LLM 基础设施/知识图谱", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L27: Graphiti is a framework for building and querying temporal context graphs for AI agents. Unlike static knowledge graphs,", "L143: - Neo4j 5.26 / FalkorDB 1.1.2 / Amazon Neptune Database Cluster or Neptune Analytics Graph + Amazon OpenSearch", "L165: pip install graphiti-core"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "groq", "rel": "mention", "lines": [154, 238], "quotes": ["- Google Gemini, Anthropic, or Groq API key (for alternative LLM providers)", "> Support for Anthropic, Gemini, and Groq is available, too. Other LLM providers — both hosted OpenAI-compatible APIs"]}, {"term": "deepseek", "rel": "mention", "lines": [239], "quotes": ["> (DeepSeek, Together, OpenRouter, …) and local servers (Ollama, vLLM, llama.cpp, LM Studio) — may be used via their"]}, {"term": "openrouter", "rel": "mention", "lines": [239], "quotes": ["> (DeepSeek, Together, OpenRouter, …) and local servers (Ollama, vLLM, llama.cpp, LM Studio) — may be used via their"]}, {"term": "ollama", "rel": "mention", "lines": [239], "quotes": ["> (DeepSeek, Together, OpenRouter, …) and local servers (Ollama, vLLM, llama.cpp, LM Studio) — may be used via their"]}, {"term": "vllm", "rel": "mention", "lines": [239], "quotes": ["> (DeepSeek, Together, OpenRouter, …) and local servers (Ollama, vLLM, llama.cpp, LM Studio) — may be used via their"]}, {"term": "azure", "rel": "mention", "lines": [358], "quotes": ["## Using Graphiti with Azure OpenAI"]}], "install": [{"term": "docker", "rel": "support", "lines": [256, 263, 271], "quotes": ["### Running with Docker Compose", "  docker compose up", "  docker compose --profile falkordb up"]}, {"term": "pypi", "rel": "support", "lines": [165, 171], "quotes": ["pip install graphiti-core", "uv add graphiti-core"]}], "hardware": [], "products": [{"term": "LangChain", "rel": "mention", "lines": [530], "quotes": ["- Building an agent with LangChain's LangGraph and Graphiti"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": true, "lines": [144, 188]}, "audit_note": "Kuzu 后端已声明弃用，上游项目不再维护"}}, "db32b2f48f69": {"fn": "ScrapeGraphAI/Scrapegraph-ai", "sha": "db32b2f48f69", "source": "readme", "identity": {"one_liner": "基于 LLM 的 Python 网页抓取库，自然语言即抽取", "review": "使用 LLM 与图（graph）逻辑构建抓取流水线的 Python 库，支持网站与本地文档（XML、HTML、JSON、Markdown）的信息抽取，用户给出提示词与来源即可输出结构化字典。内置 SmartScraperGraph、SearchGraph、SpeechGraph、ScriptCreatorGraph 等多种流水线及多页并行版本，可通过 OpenAI、Groq、Azure、Gemini、MiniMax 等 API 或 Ollama 本地模型调用 LLM。安装需配合 Playwright，另有官方托管云 API（Python/Node SDK）与匿名遥测（可关闭）。", "highlights": ["提示词驱动的抓取流水线（SmartScraperGraph 等 6 种及 multi 并行版本）", "支持 OpenAI/Groq/Azure/Gemini/MiniMax 等 API 与 Ollama 本地模型", "可抓取网站与本地文档（XML/HTML/JSON/Markdown），并可生成 Python 脚本或音频文件", "同时提供开源库与托管云 API 两种形态（MIT 许可）"], "use_cases": ["给定 URL 和提示词，抽取单页或多页的结构化信息", "结合搜索引擎结果做多页信息聚合", "用本地 Ollama 模型在自有环境运行抽取流程", "让库生成 Python 抓取脚本供后续复用"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["网页抓取", "数据抽取", "RAG", "LLM应用"], "domain": "数据采集/LLM 应用", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["ollama"]}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L24: ScrapeGraphAI is a *web scraping* python library that uses LLM and direct graph logic to create scraping pipelines for w", "L103: It is possible to use different LLM through APIs, such as **OpenAI**, **Groq**, **Azure**, **Gemini**, **MiniMax** and m"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "groq", "rel": "mention", "lines": [103, 120], "quotes": ["It is possible to use different LLM through APIs, such as **OpenAI**, **Groq**, **Azure**, **Gemini**, **MiniMax** and m", "|**LLM**|Bring your own (OpenAI, Groq, Gemini, Azure, local via Ollama)|Managed for you|"]}, {"term": "ollama", "rel": "support", "lines": [103, 105, 120, 130], "quotes": ["It is possible to use different LLM through APIs, such as **OpenAI**, **Groq**, **Azure**, **Gemini**, **MiniMax** and m", "Remember to have Ollama installed and download the models using the **ollama pull** command, if you want to use local mo", "|**LLM**|Bring your own (OpenAI, Groq, Gemini, Azure, local via Ollama)|Managed for you|", "**Choose the open-source library** if you want full control, on-prem/self-hosted data, local LLMs (Ollama), or fine-grai"]}], "install": [{"term": "pypi", "rel": "support", "lines": [46, 49], "quotes": ["The reference page for Scrapegraph-ai is available on the official page of PyPI: pypi.", "pip install scrapegraphai"]}, {"term": "colab", "rel": "mention", "lines": [109], "quotes": ["Open In Colab"]}], "hardware": [], "products": [{"term": "LangChain", "rel": "mention", "lines": [40], "quotes": ["- **LLM Frameworks**: Langchain, Llama Index, Crew.ai, Agno, CamelAI"]}, {"term": "Dify", "rel": "mention", "lines": [41], "quotes": ["- **Low-code Frameworks**: Pipedream, Bubble, Zapier, n8n, Dify, Toolhouse"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "935261dffc73": {"fn": "jumpserver/jumpserver", "sha": "935261dffc73", "source": "readme", "identity": {"one_liner": "为 DevOps/IT 团队提供带 AI 能力的开源堡垒机（PAM）平台", "review": "JumpServer 是开源的特权访问管理（PAM）平台，即堡垒主机。它为 DevOps 与 IT 团队提供统一工作区，安全接入 SSH、RDP、Kubernetes、数据库、网站、RemoteApp、VirtualApp 等资产。采用多组件架构：JumpServer 核心平台、Lina Web 界面、Luna Web 终端与原生客户端、KoKo 协议连接代理、Chen 数据库连接器、Kael AI 组件；另有企业版组件（Windows 应用连接器、RDP/数据库/VNC 协议代理、会话录像转码等）。支持 11 种语言界面，通过一键脚本在 64 位 Linux 服务器上部署，默认管理员账号 admin。", "highlights": ["统一接入 SSH、RDP、Kubernetes、数据库、网站、RemoteApp、VirtualApp 等多种协议与资产", "内置 AI 能力：终端 AI 提示与 AI 助手（Kael 组件）", "KoKo TUI 终端支持资产搜索与多会话管理", "组件化架构，社区版与企业版组件分层"], "use_cases": ["为企业服务器与数据库的特权访问做集中审计与管控", "运维团队通过 Web 终端/原生客户端统一管理大量资产", "替代手工分发凭据，按授权分配可访问目标"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "viral", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "企业", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["堡垒机", "PAM", "运维审计", "SSH/RDP 接入"], "domain": "网络安全/运维工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["版权方 FIT2CLOUD", "README 提供简体/繁体中文语言版本"]}, "trust": {"confidence": "high", "evidence": ["L17: JumpServer is an open-source Privileged Access Management (PAM) platform with AI-powered capabilities. It gives DevOps a", "L83:  JumpServer AI component", "L142: Copyright (c) 2014-2026 FIT2CLOUD, All rights reserved."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [{"term": "8 GB of RAM", "rel": "support", "lines": [23], "quotes": ["Prepare a clean 64-bit Linux server with at least 4 CPU cores and 8 GB of RAM."]}], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "928aa2d92438": {"fn": "Zackriya-Solutions/meetily", "sha": "928aa2d92438", "source": "readme", "identity": {"one_liner": "本地运行的隐私优先 AI 会议记录与摘要应用", "review": "Meetily 是一款运行在用户本机的会议助手，基于 Tauri（Rust 后端 + Next.js 前端）构建，可捕获麦克风与系统音频、用 Whisper 或 Parakeet 模型实时转录，并生成会议摘要。全部处理与存储在本地完成，不发送数据到云端。摘要支持多种 AI 提供方（推荐本地 Ollama），也可接 Claude、Groq、OpenRouter 或自定义 OpenAI 兼容端点。提供 Windows 安装包、macOS dmg，Linux 需从源码构建；说话人分离在社区版尚未提供（规划于 PRO）。", "highlights": ["Whisper/Parakeet 模型本地实时转录，无需云端", "多 AI 提供方摘要：Ollama（本地）、Claude、Groq、OpenRouter、OpenAI 兼容端点", "麦克风与系统音频同时采集，含 ducking 与削波防护", "GPU 加速：macOS Metal/CoreML 自动启用，Windows 包含 Vulkan 构建"], "use_cases": ["在本地处理会议录音并生成纪要，数据不出设备", "离线环境下对导入的音频文件生成转录与摘要", "组织使用自建 OpenAI 兼容端点生成会议摘要"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "permissive", "deploy": "desktop", "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "企业", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["会议纪要", "语音转录", "本地AI", "隐私优先", "桌面应用"], "domain": "会议/办公效率工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "mid", "evidence": ["L23: A privacy-first AI meeting assistant that captures, transcribes, and summarizes meetings entirely on your infrastructure", "L37: Meetily is a privacy-first AI meeting assistant that runs entirely on your local machine. It captures your meetings, tra", "L67: - **Flexible AI Provider Support:** Choose from Ollama (local), Claude, Groq, OpenRouter, or use your own OpenAI-compati"], "xcheck": {"install_missing": ["npm"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [67, 119], "quotes": ["- **Flexible AI Provider Support:** Choose from Ollama (local), Claude, Groq, OpenRouter, or use your own OpenAI-compati", "Generate meeting summaries with your choice of AI provider. **Ollama** (local) is recommended, with support for Claude, "]}, {"term": "groq", "rel": "mention", "lines": [67, 119], "quotes": ["- **Flexible AI Provider Support:** Choose from Ollama (local), Claude, Groq, OpenRouter, or use your own OpenAI-compati", "Generate meeting summaries with your choice of AI provider. **Ollama** (local) is recommended, with support for Claude, "]}, {"term": "openrouter", "rel": "mention", "lines": [67, 119], "quotes": ["- **Flexible AI Provider Support:** Choose from Ollama (local), Claude, Groq, OpenRouter, or use your own OpenAI-compati", "Generate meeting summaries with your choice of AI provider. **Ollama** (local) is recommended, with support for Claude, "]}, {"term": "ollama", "rel": "mention", "lines": [67, 119], "note": "README 推荐本地使用，但未见专门适配细节", "quotes": ["- **Flexible AI Provider Support:** Choose from Ollama (local), Claude, Groq, OpenRouter, or use your own OpenAI-compati", "Generate meeting summaries with your choice of AI provider. **Ollama** (local) is recommended, with support for Claude, "]}], "install": [{"term": "binary", "rel": "support", "lines": [73, 80, 81, 82], "quotes": ["1. Download the latest `x64-setup.exe` from Releases", "1. Download `meetily_0.4.1_aarch64.dmg` from Releases", "2. Open the downloaded `.dmg` file", "3. Drag **Meetily** to your Applications folder"]}, {"term": "source", "rel": "support", "lines": [87, 95, 98], "quotes": ["Build from source following our detailed guides:", "git clone https://github.com/Zackriya-Solutions/meeting-minutes", "./build-gpu.sh"]}, {"term": "npm", "rel": "mention", "lines": [97], "note": "pnpm 安装前端依赖，非本产品安装途径", "quotes": ["pnpm install --frozen-lockfile"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "note": "社区版 MIT（L206），PRO 为商业产品但非双许可同一代码库", "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "9f9d3535ab23": {"fn": "Lightning-AI/pytorch-lightning", "sha": "9f9d3535ab23", "source": "readme", "identity": {"one_liner": "为深度学习开发者提供的 PyTorch 训练框架，自动化工程代码", "review": "组织 PyTorch 代码的深度学习框架，将反向传播、混合精度、多 GPU 与分布式训练等工程代码自动化，用户保留模型逻辑控制。提供两个核心包：PyTorch Lightning（Trainer 抽象）与 Lightning Fabric（专家级控制）。通过 pip/conda 安装，支持从 CPU 到多节点 GPU/TPU 运行，提供 40+ 高级特性如早停、检查点、ONNX/TorchScript 导出，并维护多平台 CI 测试矩阵。", "highlights": ["Trainer 接口无需改代码即可切换 CPU/GPU/TPU、多 GPU 与多节点训练", "Fabric 提供对训练循环与扩展策略（DDP/FSDP/DeepSpeed）的专家级控制", "支持 TorchScript 与 ONNX 导出用于生产部署", "早停、检查点、实验管理等 40+ 高级特性"], "use_cases": ["在多个 GPU 节点上预训练或微调大模型", "将现有 PyTorch 代码重构为可扩展的训练脚本", "复现学术论文中的分类、分割、摘要等训练实验"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "科研", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["深度学习框架", "训练加速", "分布式训练", "PyTorch"], "domain": "机器学习/深度学习训练框架", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L3: **The deep learning framework to pretrain and finetune AI models.**", "L34: Training models in plain PyTorch requires writing and maintaining a lot of repetitive engineering code. Handling backpro", "L45: PyTorch Lightning: Train and deploy PyTorch at scale.", "L264:  Use state-of-the-art distributed training strategies (DDP, FSDP, DeepSpeed) and mixed precision out of the box"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [15, 57, 65, 93], "quotes": ["PyPI - Python Version", "pip install lightning", "pip install lightning['extra']", "pip install -iU https://test.pypi.org/simple/ pytorch-lightning"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "21031d37a7d0": {"fn": "googleworkspace/cli", "sha": "21031d37a7d0", "source": "readme", "identity": {"one_liner": "面向人类与 AI agent 的 Google Workspace 统一命令行工具", "review": "单一 CLI 覆盖 Drive、Gmail、Calendar、Sheets、Docs、Chat、Admin 等 Workspace API：运行时读取 Google Discovery Service 动态生成命令面，新端点自动纳入。输出为结构化 JSON，支持 --dry-run 预览与自动分页；附带 100+ 个 SKILL.md 格式的 agent 技能与 50 个工作流配方，支持 npx skills add 与 OpenClaw 安装，并作为 Gemini CLI 扩展接入。认证覆盖交互式 OAuth、Service Account、预取 token 等多种方式；凭据以 AES-256-GCM 加密存放于系统钥匙串。预编译二进制发布于 GitHub Releases，也可经 npm、cargo、Homebrew、Nix 安装。README 声明非 Google 官方支持产品，v1.0 前可能有破坏性变更。", "highlights": ["运行时读取 Discovery Service 动态构建全部命令，无需随 API 更新发版", "输出结构化 JSON，附带 100+ agent 技能与 50 个 Gmail/Drive/Docs/Calendar/Sheets 配方", "多种认证工作流：交互式 OAuth、Service Account、预取 token、无头 CI 导出", "带 + 前缀的手工 helper 命令（+agenda、+send、+triage 等）与 Model Armor 提示注入扫描"], "use_cases": ["让 LLM agent 通过技能直接管理 Google Workspace 邮件、日历与文档", "在终端用一条命令调用任意 Workspace API 并获得 JSON 输出", "在无头/CI 环境导出凭据后运行 Workspace 自动化脚本", "用 Model Armor 模板扫描 API 响应中的提示注入后再交给 agent"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": true, "lines": [7, 19]}}, "links": {"scenario_tags": ["CLI", "Google Workspace", "agent技能", "自动化", "Gemini CLI 扩展"], "domain": "开发者工具/办公自动化", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L3: **One CLI for all of Google Workspace — built for humans and AI agents.**", "L190: The repo ships 100+ Agent Skills (`SKILL.md` files) — one for every supported API, plus higher-level helpers for common "], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "npm", "rel": "support", "lines": [25, 33, 36, 194, 197, 198], "note": "npm install -g @googleworkspace/cli 为官方安装途径之一", "quotes": ["- **Node.js 18+** — for `npm install` (or download a pre-built binary from GitHub Releases)", "For convenience, you can also use `npm` to automate downloading the appropriate binary from GitHub Releases:", "npm install -g @googleworkspace/cli", "npx skills add https://github.com/googleworkspace/cli", "npx skills add https://github.com/googleworkspace/cli/tree/main/skills/gws-drive", "npx skills add https://github.com/googleworkspace/cli/tree/main/skills/gws-gmail"]}, {"term": "source", "rel": "support", "lines": [39], "note": "提供 build from source 途径", "quotes": ["Or build from source:"]}, {"term": "cargo", "rel": "support", "lines": [42], "note": "cargo install 从源码构建", "quotes": ["cargo install --git https://github.com/googleworkspace/cli --locked"]}, {"term": "go", "rel": "none", "lines": [42], "note": "误命中：该行为 cargo 命令，非 Go 构建途径", "quotes": ["cargo install --git https://github.com/googleworkspace/cli --locked"]}, {"term": "brew", "rel": "support", "lines": [51, 54], "note": "macOS/Linux 支持 Homebrew 安装", "quotes": ["On macOS and Linux, you can also install via Homebrew:", "brew install googleworkspace-cli"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "5aa412f59d09": {"fn": "ahujasid/mcp-for-blender", "sha": "5aa412f59d09", "source": "readme", "identity": {"one_liner": "让 AI 通过 MCP 协议控制 Blender 进行 3D 建模的社区插件", "review": "由两部分组成：Blender 插件内建 socket 服务器接收并执行命令，以及实现 Model Context Protocol 的 Python 服务器连接两者。AI 可创建/修改/删除 3D 物体、控制材质、直接编写 Blender Python 代码，并通过多角度/线框/渲染视图自查结果。接入 Poly Haven、Sketchfab、Poly Pizza 资产及 Tripo、Hyper3D Rodin、Hunyuan3D 生成 3D 模型。提供一键安装脚本、pipx 与 Docker 运行方式；socket 服务器无认证加密，建议保持 localhost 或使用安全模式。", "highlights": ["双向 socket 通信：AI 读写 Blender 对象、材质与场景", "多角度/线框/X 光/渲染视图供 AI 自检成果", "集成 Poly Haven、Sketchfab、Poly Pizza 与 Tripo/Hyper3D Rodin/Hunyuan3D 模型生成", "BLENDER_MCP_SAFE_MODE=1 可在执行前校验脚本并拦截风险代码"], "use_cases": ["用自然语言驱动 Blender 建模与场景搭建", "让 AI 在 Blender 中生成或修改材质与物体", "在对话式 AI 客户端中查看并操作 3D 视口"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "desktop", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["3D建模", "MCP", "Blender插件", "AI辅助创作"], "domain": "3D 创作/AI 工具集成", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L10: Prompt-assisted 3D modeling, scene creation, and manipulation — driven by AI.", "L132: 1. **Blender Addon** (`addon.py`) — a Blender addon that creates a socket server within Blender to receive and execute c", "L133: 2. **MCP Server** (`src/blender_mcp/server.py`) — a Python server that implements the Model Context Protocol and connect"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [51, 72, 84], "note": "Claude Desktop/Code 为支持的 MCP 客户端，非模型 provider 适配声明", "quotes": ["It installs uv if needed, finds the MCP clients on your machine (Claude Desktop, Claude Code, Codex, Cursor, VS Code, De", " Claude Desktop — Settings → Developer → Edit Config", "claude mcp add blender uvx mcp-for-blender"]}], "install": [{"term": "pypi", "rel": "support", "lines": [5, 30], "quotes": ["*formerly `blender-mcp` — the PyPI package is now `mcp-for-blender`.*", "> **Note:** the PyPI package `blender-mcp` is now **`mcp-for-blender`**. Existing setups"]}, {"term": "brew", "rel": "mention", "lines": [63, 163], "note": "依赖 uv 的安装方式，非本产品安装途径", "quotes": ["brew install uv", "brew install uv"]}, {"term": "docker", "rel": "support", "lines": [239], "quotes": ["docker build -t mcp-for-blender ."]}, {"term": "source", "rel": "mention", "lines": [346], "note": "git clone 用于 Codex 插件安装", "quotes": ["git clone https://github.com/ahujasid/blender-mcp.git"]}], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [51, 84, 331], "quotes": ["It installs uv if needed, finds the MCP clients on your machine (Claude Desktop, Claude Code, Codex, Cursor, VS Code, De", "claude mcp add blender uvx mcp-for-blender", "Use the Claude Code CLI to add the MCP for Blender server:"]}, {"term": "Cursor", "rel": "mention", "lines": [51, 93, 194], "quotes": ["It installs uv if needed, finds the MCP clients on your machine (Claude Desktop, Claude Code, Codex, Cursor, VS Code, De", " Cursor / VS Code / OpenCode / Antigravity", "MCP clients started from a GUI (Claude Desktop, Cursor, VS Code from the Dock/Start menu) do **not** inherit your termin"]}, {"term": "Windsurf", "rel": "mention", "lines": [51], "quotes": ["It installs uv if needed, finds the MCP clients on your machine (Claude Desktop, Claude Code, Codex, Cursor, VS Code, De"]}, {"term": "Devin", "rel": "mention", "lines": [51], "quotes": ["It installs uv if needed, finds the MCP clients on your machine (Claude Desktop, Claude Code, Codex, Cursor, VS Code, De"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": true, "lines": [5, 30, 31], "note": "PyPI 包名由 blender-mcp 更名为 mcp-for-blender，旧名仍可运行"}}}, "63d85426fd34": {"fn": "storytold/artcraft", "sha": "63d85426fd34", "source": "readme", "identity": {"one_liner": "面向艺术家与影像创作者的 AI 图像/视频生成 IDE", "review": "ArtCraft 定位为交互式 AI 图像与视频创作的 IDE：支持 2D 合成、3D 场景搭建、角色摆姿、镜头规划等可视化创作工具，并可调用多种模型生成图像、视频、音乐、3D 网格与世界（Gaussian splats），目录共列出 62 个模型。提供 Windows 与 macOS 稳定版下载，也可从源码构建（含 Linux）。部分模型标注为当前禁用或桌面端受限。", "highlights": ["2D/3D 场景合成与镜头规划工具（Image to Location、Kitbashing 等）", "62 模型目录覆盖图像、视频、音乐/音效、3D 网格与世界生成", "支持 Grok、Midjourney、Sora、World Labs 等模型提供方", "Windows/macOS 稳定版下载，支持从源码构建（含 Linux）"], "use_cases": ["在生成前用 3D 场景工具规划构图、角色身份与机位", "通过文本提示在多种图像/视频模型间探索创意", "将图像转为可摆放旋转的 3D 物体或世界场景"]}, "filters": {"ai_role": "ai-native", "license_risk": "dual", "deploy": null, "model_dep": "locked-api", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "消费者", "paper_url": null, "demo_url": null, "self_decla