[], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "391a4dd90d13": {"fn": "udecode/plate", "sha": "391a4dd90d13", "source": "readme", "identity": {"one_liner": "为 React 开发者提供带 AI 能力的富文本编辑器框架", "review": "基于 Slate 的 React 富文本编辑器框架，README 提供三种起步模板：Notion 风格模板（含插件与 AI）、playground 模板、最小模板。核心机制通过插件体系组织功能，文档站与中文文档、Discord 中文频道支持中文使用者。README 本身内容简短，功能细节需查阅文档。", "highlights": ["基于 Slate 的 React 富文本编辑器框架", "提供 Notion 风格、playground、minimal 三种模板", "模板可组合插件与 AI 能力", "提供中文文档与 Discord 中文频道"], "use_cases": ["在 React 应用中搭建所见即所得编辑器", "参照 Notion 风格模板快速搭建文档类产品编辑器", "中文团队查阅中文文档接入编辑器"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "none", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["富文本编辑器", "React", "WYSIWYG", "AI写作"], "domain": "前端/编辑器组件", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["提供中文文档与 Discord 中文频道"]}, "trust": {"confidence": "high", "evidence": ["L1: Plate", "L11: |Option|Plate|Plugins|AI|Backend|", "L25: ## 中文文档"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "684a54c08fd0": {"fn": "triggerdotdev/trigger.dev", "sha": "684a54c08fd0", "source": "readme", "identity": {"one_liner": "为开发者提供 TypeScript 平台构建部署持久化 AI 工作流", "review": "开源的 TypeScript AI 工作流构建平台：以 SDK 形式在用户代码库中编写任务，部署后获得无超时的长运行任务、自动重试、队列与幂等、检查点与版本化，并附全量日志追踪的可观测面板。支持人审节点暂停、流式输出回传前端、批量触发与多环境管理；可使用云托管或通过 Docker Compose / Helm 自托管。任务运行时可运行浏览器、Python 脚本、FFmpeg 等系统包。", "highlights": ["长运行任务无超时，带自动重试、队列与幂等机制", "人机协同节点：任务可暂停等待人工审批或反馈", "实时运行订阅与 LLM 流式输出支持", "提供 Docker Compose 与 Kubernetes Helm chart 自托管路径"], "use_cases": ["把需要长时间运行的 AI 代理任务从 serverless 平台迁移到无超时环境", "在关键决策点加入人工审核的自动化工作流", "为前端应用实时订阅任务进度和流式 AI 输出"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["工作流编排", "AI Agent", "后台任务", "TypeScript SDK"], "domain": "LLM 基础设施/工作流编排", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L19: Trigger.dev is the open-source platform for building AI workflows in TypeScript. Long-running tasks with retries, queues", "L103: - Docker self-hosting guide - use Docker Compose to spin up a Trigger.dev instance"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "docker", "rel": "support", "lines": [103], "quotes": ["- Docker self-hosting guide - use Docker Compose to spin up a Trigger.dev instance"]}, {"term": "helm", "rel": "support", "lines": [104], "quotes": ["- Kubernetes self-hosting guide - use our official Helm chart to deploy Trigger.dev to your Kubernetes cluster"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "3c5dc68b229b": {"fn": "memvid/memvid", "sha": "3c5dc68b229b", "source": "readme", "identity": {"one_liner": "为 AI Agent 提供单文件、免数据库的持久记忆层", "review": "Memvid 将数据、嵌入、检索结构与元数据打包为单个 .mv2 文件，作为 AI Agent 的可移植记忆层，无需运行 RAG 流水线或服务器式向量数据库。核心机制是把记忆组织为不可变的 Smart Frame 序列（借鉴视频编码思路），支持追加写入、按时间线回溯与分支、崩溃安全。提供 CLI、Node.js、Python、Rust SDK；检索支持 BM25 全文、本地 ONNX 向量嵌入（BGE/Nomic/GTE）与 OpenAI 云端嵌入，需 Rust 1.85+。README 中含 LoCoMo 等基准数据，此处不作评价。", "highlights": ["数据、嵌入与索引打包为单个 .mv2 文件，无 sidecar 文件", "Smart Frame 追加式设计：支持时间线回溯、分支与查询过去状态", "本地 ONNX 嵌入（BGE/Nomic/GTE）与 OpenAI API 嵌入可选", "提供 npm、pip、cargo 多语言 SDK 与 CLI"], "use_cases": ["给长时间运行的 AI Agent 添加持久记忆", "构建离线优先、可携带的知识库", "需要审计与回放记忆状态的 Agent 工作流"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://github.com/memvid/memvid", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["Agent记忆", "RAG替代", "向量检索", "知识库"], "domain": "LLM 基础设施/Agent 记忆", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L6:  Memvid is a single-file memory layer for AI agents with instant retrieval and long-term memory.", "L38: Memvid is a portable AI memory system that packages your data, embeddings, search structure, and metadata into a single ", "L42: The result is a model-agnostic, infrastructure-free memory layer that gives AI agents persistent, long-term memory they "], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "cargo", "rel": "support", "lines": [17, 103, 115], "quotes": [" Crates.io", "|**Rust**|`cargo add memvid-core`|Crates.io|", "memvid-core = \"2.0\""]}, {"term": "npm", "rel": "support", "lines": [100, 101], "quotes": ["|**CLI**|`npm install -g memvid-cli`|npm|", "|**Node.js SDK**|`npm install @memvid/sdk`|npm|"]}, {"term": "pypi", "rel": "support", "lines": [102], "quotes": ["|**Python SDK**|`pip install memvid-sdk`|PyPI|"]}, {"term": "source", "rel": "support", "lines": [153, 154, 161], "quotes": ["```bash", "git clone https://github.com/memvid/memvid.git", "cargo build"]}], "hardware": [], "products": [{"term": "Hugging Face", "rel": "mention", "lines": [295, 297, 303, 305, 311], "quotes": ["curl -L 'https://huggingface.co/BAAI/bge-base-en-v1.5/resolve/main/onnx/model.onnx' \\", "curl -L 'https://huggingface.co/BAAI/bge-base-en-v1.5/resolve/main/tokenizer.json' \\", "curl -L 'https://huggingface.co/nomic-ai/nomic-embed-text-v1.5/resolve/main/onnx/model.onnx' \\", "curl -L 'https://huggingface.co/nomic-ai/nomic-embed-text-v1.5/resolve/main/tokenizer.json' \\", "curl -L 'https://huggingface.co/thenlper/gte-large/resolve/main/onnx/model.onnx' \\"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "bbdfe0f27f35": {"fn": "piskvorky/gensim", "sha": "bbdfe0f27f35", "source": "readme", "identity": {"one_liner": "面向 NLP/IR 社区的 Python 主题建模与相似度检索库", "review": "Gensim 是处理大规模语料的 Python 库，提供主题建模、文档索引与相似度检索。算法对语料规模内存无关，可流式处理超出 RAM 的输入；提供 LSA、LDA、RP、HDP、word2vec 等算法的多核实现，并支持在集群上分布式运行 LSA/LDA。通过依赖 NumPy 调用底层 BLAS 库（如 MKL、ATLAS、OpenBLAS）获得性能。目前处于稳定维护模式，不接受新特性，仅接受 bug 与文档修复；4.0.0 起不再支持 Python 2.7。", "highlights": ["内存无关的流式处理，可处理大于 RAM 的语料", "LSA/LDA/RP/HDP/word2vec 等算法的多核实现", "支持在计算机集群上分布式运行 LSA 与 LDA", "提供文档与 Jupyter Notebook 教程"], "use_cases": ["对大规模文本语料做主题建模", "构建文档相似度检索与文档去重", "训练 word2vec 等词向量用于下游 NLP 任务"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "viral", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "research"}, "eval": {"target_user": "科研", "paper_url": "http://is.muni.cz/publication/884893/en", "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["主题建模", "NLP", "信息检索", "词向量"], "domain": "自然语言处理/机器学习", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L10: Gensim is a Python library for *topic modelling*, *document indexing*", "L12: *natural language processing* (NLP) and *information retrieval* (IR)", "L17: ## ⚠️ Gensim is in stable maintenance mode: we are not accepting new features, but bug and documentation fixes are still"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [55, 64], "quotes": ["    pip install --upgrade gensim", "    pip install ."]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": [17]}}}, "2d5484ab78be": {"fn": "pipecat-ai/pipecat", "sha": "2d5484ab78be", "source": "readme", "identity": {"one_liner": "给开发者构建实时语音与多模态 AI 代理的 Python 框架", "review": "Pipecat 是一个用于构建实时语音与多模态对话代理的开源 Python 框架，由 Daily 与社区维护。它编排音频/视频、AI 服务、传输层与对话管道，支持单代理或多代理系统（交接、并行分发、共享总线，可跨进程与机器分布式运行）。传输层支持 WebSockets 与 WebRTC。核心框架默认轻量，第三方 AI 服务依赖通过 extras 按需添加。需要 Python 3.11+，用 uv 安装；提供 CLI 脚手架、客户端 SDK（JS/React/Swift/Kotlin/C++/ESP32）、调试工具与 Pipecat Cloud 部署。", "highlights": ["语音优先管道：集成语音识别、TTS 与对话处理，支持多模态（语音/视频/图像）", "多代理系统：每个管道即一个代理，支持 handoff、并行 fan-out、sidecar 与分布式部署", "大量可插拔服务：LLM、STT、TTS、传输、视频、VAD 等数十家服务商", "官方多平台客户端 SDK：JavaScript/React/React Native/Swift/Kotlin/C++/ESP32"], "use_cases": ["构建语音助手或 AI 陪伴类实时对话应用", "搭建多代理协作系统（交接、并行、共享总线）", "开发客服/客户接待等业务型语音代理", "为语音 AI 应用接入 WebRTC/WebSocket 传输与电话序列化器"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["语音代理", "多模态", "实时AI", "Agent框架", "Python框架"], "domain": "LLM 基础设施/语音与多模态代理框架", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic", "groq", "deepseek", "xai", "together", "openrouter", "ollama"]}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L7: **Pipecat** is an open-source Python framework for building real-time voice and multimodal conversational agents. Build ", "L26: - **Multi-Agent Ready**: Each pipeline is an agent. Compose them with handoff, parallel fan-out, sidecar workers, or dis", "L87: |LLMs|Anthropic, AWS, Azure, Baseten, Cerebras, Crusoe, DeepSeek, Fireworks AI, Gemini, Grok, Groq, Inception, Mistral, "], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [48, 63, 87], "note": "LLM 服务列表中提供 Anthropic，且有 Claude Code 插件通道", "quotes": ["The Pipecat CLI ships with `pipecat-ai` — install it with `uv tool install \"pipecat-ai[cli]\"`. Run `pipecat init` to sta", "claude plugin marketplace add pipecat-ai/skills", "|LLMs|Anthropic, AWS, Azure, Baseten, Cerebras, Crusoe, DeepSeek, Fireworks AI, Gemini, Grok, Groq, Inception, Mistral, "]}, {"term": "groq", "rel": "support", "lines": [86, 87, 88], "note": "STT/LLM/TTS 服务列表中均提供 Groq", "quotes": ["|Speech-to-Text|AssemblyAI, AWS, Azure, Cartesia, Deepgram, ElevenLabs, Fal Wizper, FunASR, Gladia, Google, Gradium, Gro", "|LLMs|Anthropic, AWS, Azure, Baseten, Cerebras, Crusoe, DeepSeek, Fireworks AI, Gemini, Grok, Groq, Inception, Mistral, ", "|Text-to-Speech|Async, AWS, Azure, Bland, Camb AI, Cartesia, Deepgram, ElevenLabs, Fish, Google, Gradium, Groq, Hume, In"]}, {"term": "deepseek", "rel": "support", "lines": [87], "note": "LLM 服务列表中提供 DeepSeek", "quotes": ["|LLMs|Anthropic, AWS, Azure, Baseten, Cerebras, Crusoe, DeepSeek, Fireworks AI, Gemini, Grok, Groq, Inception, Mistral, "]}, {"term": "xai", "rel": "support", "lines": [86, 88, 89], "note": "STT/TTS/Voice Agent 服务列表中提供 xAI", "quotes": ["|Speech-to-Text|AssemblyAI, AWS, Azure, Cartesia, Deepgram, ElevenLabs, Fal 