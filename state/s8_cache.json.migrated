 to Claude models. OpenSpec works with the too"]}], "install": [{"term": "npm", "rel": "support", "lines": [77, 149], "quotes": ["npm install -g @fission-ai/openspec@latest", "npm install -g @fission-ai/openspec@latest"]}, {"term": "brew", "rel": "support", "lines": [72, 80, 83, 152], "quotes": ["**Requires Node.js 20.19.0 or higher.** Homebrew installs it as a dependency.", "Or install the official Homebrew formula on macOS or Linux:", "brew install openspec", "If you installed OpenSpec with Homebrew:"]}], "hardware": [], "products": [{"term": "GitHub Copilot", "rel": "mention", "lines": [102], "note": "支持的工具之一，命令拼写差异说明", "quotes": ["`/opsx:propose` is the canonical name; your tool may spell it `/opsx-propose` (Cursor, GitHub Copilot), `@opsx-propose` "]}, {"term": "Cursor", "rel": "mention", "lines": [102], "note": "支持的工具之一", "quotes": ["`/opsx:propose` is the canonical name; your tool may spell it `/opsx-propose` (Cursor, GitHub Copilot), `@opsx-propose` "]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "435f07bd08ac": {"fn": "debpalash/VoiceStudio", "sha": "435f07bd08ac", "source": "readme", "identity": {"one_liner": "本地运行的开源语音工作台：克隆、配音、转写与有声书制作", "review": "基于 Electron 的桌面语音工作台，默认引擎为 k2-fsa/OmniVoice，支持语音克隆、语音设计、视频配音、听写、转写与有声书批量制作，覆盖 646 种语言。本地工作流在用户硬件上运行，按 GPU/CPU 提供不同加速方式（CUDA、Metal、CPU），并可安装管理本地语音模型；提供本地 API 与 MCP 接入供 agent 调用，支持配方与监视文件夹。Tauri 桌面壳已移除，Electron 为唯一桌面应用与 Web UI。", "highlights": ["语音克隆、语音设计、视频配音、听写、转写、有声书制作，支持 646 种语言", "CUDA / Metal (MPS) / CPU 三类硬件加速路径，无独显也可用（较慢）", "本地 API 与 MCP 接口，支持 agent 集成与监视文件夹等自动化", "一键安装脚本覆盖 macOS/Linux/Windows，也可从源码运行"], "use_cases": ["克隆自己的声音并生成语音或有声书", "给视频做带时间轴的本地配音", "在没有云端服务依赖的环境下做语音转写与听写", "让编码 agent 按文档在本机安装并验证语音工具链"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "dual", "deploy": "desktop", "model_dep": null, "hardware": "cpu-ok", "install_friction": "medium", "maturity": null}, "eval": {"target_user": "消费者", "paper_url": null, "demo_url":