sive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["编程Agent", "CLI工具", "代码助手"], "domain": "开发者工具/编程助手", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L1: Codex CLI is a coding agent from OpenAI that runs locally on your computer.", "L35: Codex CLI can also be installed via the following package managers:", "L75: This repository is licensed under the Apache-2.0 License."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "npm", "rel": "support", "lines": [38, 39], "quotes": ["# Install using npm", "npm install -g @openai/codex"]}, {"term": "brew", "rel": "support", "lines": [43, 44], "quotes": ["# Install using Homebrew", "brew install --cask codex"]}], "hardware": [], "products": [{"term": "Cursor", "rel": "mention", "lines": [5], "note": "IDE 扩展安装语境中提及的编辑器", "quotes": ["If you want Codex in your code editor (VS Code, Cursor, Windsurf), install in your IDE."]}, {"term": "Windsurf", "rel": "mention", "lines": [5], "note": "IDE 扩展安装语境中提及的编辑器", "quotes": ["If you want Codex in your code editor (VS Code, Cursor, Windsurf), install in your IDE."]}, {"term": "ChatGPT", "rel": "mention", "lines": [7, 64], "note": "登录与云端产品关联，非替代/竞品对象", "quotes": [" If you are looking for the cloud-based agent from OpenAI, Codex Web , go to chatgpt.com/codex.", "Run `codex` and select **Sign in with ChatGPT**. We recommend signing into your ChatGPT account to use Codex as part of "]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "5c6741a9d8d6": {"fn": "ggml-org/llama.cpp", "sha": "5c6741a9d8d6", "source": "readme", "identity": {"one_liner": "让开发者在本地和云端多种硬件上运行 LLM/VLM 推理", "review": "以 C/C++ 实现的 LLM（含 VLM）推理项目，目标是以最小配置在广泛硬件上运行推理。核心机制包括：无依赖的纯 C/C++ 实现、1.5-bit 到 8-bit 整数量化以降低内存占用、CPU+GPU 混合推理，以及 CUDA/HIP/MUSA/Metal/Vulkan/SYCL 等多后端。提供 cli 与 server 等工具，server 提供 OpenAI 兼容 API 与内置 Web UI。基于 ggml 库构建，MIT 许可，可经安装脚本、Docker、预编译二进制或源码构建获取。", "highlights": ["纯 C/C++ 实现且无依赖，支持从 1.5-bit 到 8-bit 的整数量化", "覆盖 CUDA、HIP、MUSA、Metal、Vulkan、SYCL 等多后端与多架构指令集", "CPU+GPU 混合推理，可运行超过总 VRAM 容量的模型", "llama serve 提供 OpenAI 兼容 API 与内置 Web UI"], "use_cases": ["在本地笔记本或台式机上运行 GGUF 格式的大语言模型", "通过 OpenAI 兼容 API server 为应用提供推理服务", "在 Apple Silicon、NVIDIA/AMD GPU、RISC-V 等多种硬件上部署推理", "用量化模型在显存受限设备上运行较大模型"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "desktop", "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["LLM推理", "本地部署", "推理引擎", "量化"], "domain": "LLM 基础设施/推理", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L5:  LLM inference in C/C++", "L51: The main goal of `llama.cpp` is to enable LLM (and VLM) inference with minimal setup and state-of-the-art performance on", "L54: - Plain C/C++ implementation without any dependencies"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "llama.cpp", "rel": "none", "lines": [], "note": "为本项目自身，非接入的模型提供方", "quotes": []}, {"term": "cpu-infer", "rel": "none", "lines": [], "note": "README 未出现该词", "quotes": []}], "install": [{"term": "binary", "rel": "support", "lines": [30], "quotes": ["- Download pre-built binaries from the releases page"]}, {"term": "source", "rel": "support", "lines": [31], "quotes": ["- Build from source by cloning this repository - check out our build guide"]}], "hardware": [], "products": [{"term": "通义千问", "rel": "mention", "lines": [46], "note": "示例中运行 Qwen 3.6 模型，仅提及非竞品", "quotes": [" Built-in web UI against `llama serve` running Qwen 3.6"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "8da378c28cb1": {"fn": "shadcn-ui/ui", "sha": "8da378c28cb1", "source": "readme", "identity": {"one_liner": "给开发者的可定制 React 组件集合，用于构建自己的组件库", "review": "shadcn/ui 提供一组可组合、注重可访问性的 React 组件，代码复制到用户项目中，可自行定制与扩展，用于构建自己的组件库。README 说明文档位于 ui.shadcn.com/docs，采用 MIT 许可证，接受社区贡献。README 本身仅作入口，安装方式与框架集成细节（如 Next.js、Radix UI 等主题标签所示）需查阅其文档站点。", "highlights": ["可组合、注重可访问性的组件集", "代码归用户所有，可定制、扩展并构建自有组件库", "MIT 许可证开源"], "use_cases": ["为 React 应用搭建一套可完全控制的组件库", "在定制 UI 组件时参考其组件实现"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["UI组件库", "React", "前端开发"], "domain": "前端开发/UI 组件", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L3: A set of beautifully designed components that you can customize, extend, and build on. Start here then make it your own.", "L14: Licensed under the MIT license."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "dd6bda435f4b": {"fn": "Graphify-Labs/graphify", "sha": "dd6bda435f4b", "source": "readme", "identity": {"one_liner": "给 AI 编码助手把代码库映射成可查询知识图谱的 CLI 工具", "review": "以 `/graphify` 技能形式注册到 Claude Code、Cursor、Codex、Gemini CLI 等 20+ 编码助手，用 tree-sitter AST 本地确定性解析代码，构建覆盖 ~40 语言的 calls/imports/inherits 跨文件知识图谱，输出 graph.html、GRAPH_REPORT.md 与 graph.json 三个文件；每条边带 EXTRACTED/INFERRED 标签，提供 query/path/explain 三类命令。文档、PDF、图像、音视频经语义 pass 也并入图。代码解析不调用 LLM、无向量索引；语义 pass 需配置模型或 API key。依赖 Python 3.10+ 与 uv/pipx。", "highlights": ["tree-sitter AST 本地解析 ~40 语言，代码解析零 LLM 调用、数据不出本机", "每条边带 EXTRACTED/INFERRED 置信标签", "无嵌入与向量库，图遍历支持 query/path/explain", "一条命令注册到 Claude Code、Cursor、Codex 等 20+ 平台"], "use_cases": ["代替 grep 在大型代码库中追问概念间关联与调用路径", "用图谱查看新项目的核心概念（god nodes/社区划分）", "把文档注释、ADR/RFC 与 PDF 等材料并入代码图谱统一检索"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["知识图谱", "代码分析", "AI编码助手", "GraphRAG", "开发者工具"], "domain": "开发者工具/代码知识图谱", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "mid", "evidence": ["L22: Type `/graphify` in your AI coding assistant and it maps your entire project (code, docs, PDFs, images, videos) into a *", "L24: - **Code maps for free, fully local.** Code is parsed with tree-sitter AST: deterministic, no LLM, nothing leaves your m", "L61: **One install, any assistant, any OS.** Claude Code, Cursor, Codex, Gemini CLI, GitHub Copilot, and 20+ more, on macOS, "], "xcheck": {"install_missing": ["npm"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [9, 147, 158], "quotes": [" PyPI", "> **Official package:** The PyPI package is `g