 上，可直接使用或在 TensorFlow.js 中做迁移学习。涵盖图像分类、手部/人体姿态检测、目标检测、语义分割、人脸关键点、语音命令分类、文本编码与毒性评分、人像深度估计，另附 KNN 分类器等通用工具。API 设计上隐藏张量细节，面向非机器学习专家，每个模型有独立目录与 README。", "highlights": ["提供 MobileNet 图像分类、Coco SSD 目标检测、DeepLab v3 语义分割等图像模型", "支持浏览器端实时手部/人体姿态检测与 3D 人脸关键点检测", "包含语音命令分类、文本编码/毒性评分、人像深度估计", "提供 KNN 分类器工具包，支持迁移学习场景"], "use_cases": ["在网页中做图像分类或目标检测", "浏览器端实时人体/手部姿态与面部关键点检测", "为文本任务生成句向量或给评论打毒性分", "基于预训练模型做迁移学习构建自定义应用"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["预训练模型", "浏览器端推理", "计算机视觉", "语音/文本"], "domain": "机器学习/浏览器端推理", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L3: This repository hosts a set of pre-trained models that have been ported to", "L6: The models are hosted on NPM and unpkg so they can be used in any project out of the box. They can be used directly or u", "L11: non-machine learning experts."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "npm", "rel": "support", "lines": [6, 29, 36, 43, 50], "quotes": ["The models are hosted on NPM and unpkg so they can be used in any project out of the box. They can be used directly or u", " <code>npm i @tensorflow-models/mobilenet</code>", " <code>npm i @tensorflow-models/hand-pose-detection</code>", " <code>npm i @tensorflow-models/pose-detection</code>", " <code>npm i @tensorflow-models/coco-ssd</code>"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "b97e1bd077f3": {"fn": "yetone/magpie", "sha": "b97e1bd077f3", "source": "readme", "identity": {"one_liner": "为多 agent 统一接入模型与账号的本地网关应用", "review": "在多个 AI coding agent 与多个模型提供方之间做统一接入的本地应用：一个位于 127.0.0.1:3425 的本地网关读写各 agent 自身的配置文件，把模型选择、订阅账号、路由规则集中到一处。网关以 OpenAI Chat、OpenAI Responses、Anthropic Messages、Gemini 四种协议互通，含流式、工具调用与 reasoning。核心机制包括：按 agent 粒度改写配置（保持注释与格式）、配额耗尽时的多账号故障转移路由组、五种调度策略（smart/order/rotate/usage/pace）、基于 npm/Bun 的插件与网关中间件、用量与成本统计、局域网/远程共享。限多 agent 多 provider 用户使用；单一 agent 单一订阅的用户 README 明确表示不适用。", "highlights": ["本地网关翻译 OpenAI/Anthropic/Gemini 协议，含流式、工具调用与 reasoning", "配额耗尽自动切换账号/模型，五种路由策略（smart/order/rotate/usage/pace）", "原子改写各 agent 自身配置，保留注释与格式；Profiles 一键切换全套配置", "npm/Bun 插件体系与网关中间件（param-override、model-map、word-guard 等）"], "use_cases": ["在多个 coding agent 间统一切换模型与提供方", "多个订阅账号之间做配额故障转移与轮换", "给不能联网搜索的模型统一挂上网络搜索能力", "在服务器/NAS 上以 Docker 部署共享网关给局域网设备"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["LLM网关", "coding agent", "模型路由", "代理工具", "桌面应用"], "domain": "LLM 基础设施/网关与路由", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic", "deepseek", "xai", "groq", "openrouter", "bedrock", "ollama"]}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["赞助商含中文名称（零词元）", "支持简体中文文档", "支持国内厂商预设（DeepSeek/Kimi/智谱/百度千帆/火山方舟等）"]}, "trust": {"confidence": "high", "evidence": ["L8: Switch any of them from the menu bar. One local gateway serves them all,", "L73: The gateway at `127.0.0.1:3425` speaks OpenAI Chat, OpenAI Responses, Anthropic Messages and Gemini, and translates betw", "L91: > **Presets include** Anthropic · OpenAI · Google Gemini · Google Vertex AI · Amazon Bedrock (runtime and Mantle) · Deep"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_