": "readme", "identity": {"one_liner": "给开发者微调与部署 600+ LLM/400+ MLLM 的训练框架", "review": "ModelScope 社区提供的大模型与多模态大模型微调及部署框架，覆盖预训练、微调、人类对齐训练、推理、评测、量化和部署全流程。集成 Megatron 并行（TP/PP/CP/EP）加速训练，内置 GRPO 系列强化学习算法（GRPO、DAPO、GSPO 等）与 DPO/KTO/SimPO 等偏好学习算法，支持 Embedding/Reranker 训练。通过 vLLM/SGLang/LMDeploy 加速推理，AWQ/GPTQ/BNB/FP8 量化。提供 Web-UI 界面，内置 150+ 数据集，支持自定义数据集一键训练。", "highlights": ["支持 600+ 纯文本与 400+ 多模态大模型的训练到部署全流程", "内置 GRPO/DAPO/GSPO 等强化学习算法与 DPO/KTO 等偏好学习算法", "支持 LoRA/QLoRA/DoRA 等轻量微调与 Megatron/DeepSpeed/FSDP 分布式训练", "支持量化模型训练，7B 模型仅需 9GB 训练资源"], "use_cases": ["用 LoRA 或全参数方式微调 Qwen、Llama 等开源模型", "对多模态模型做图文音视频混合数据训练", "用 GRPO 算法对模型做强化学习对齐", "训练后量化导出并用 vLLM 部署推理服务"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": "local-ok", "hardware": null, "install_friction": "medium", "maturity": "research"}, "eval": {"target_user": "开发者", "paper_url": "https://arxiv.org/", "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["LLM微调", "多模态训练", "强化学习GRPO", "模型量化部署"], "domain": "LLM 基础设施/训练框架", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["deepseek", "vllm"]}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["README 提供中英双语", "ModelScope 社区出品", "支持 Ascend NPU 等国产硬件"]}, "trust": {"confidence": "high", "evidence": ["L23: 🍲 **ms-swift** is a large model and multimodal large model fine-tuning and deployment framework provided by the ModelSco", "L31: - **Hardware Support**: Supports NVIDIA GPUs (A100/H100/RTX series, etc., via CUDA), AMD GPUs (MI300 series, etc., via R", "L90: To install using pip:"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "deepseek", "rel": "support", "lines": [23, 50], "note": "列出 DeepSeek 系列模型的训练/推理支持", "quotes": ["🍲 **ms-swift** is a large model and multimodal large model fine-tuning and deployment framework provided by the ModelSco", "- 🔥 2026.09.21: Support for DeepSeek-V4.1-Flash: Megatron-SWIFT full-parameter training (SFT and GRPO) plus vLLM inferen"]}, {"term": "vllm", "rel": "support", "lines": [25, 43, 45, 121], "note": "作为推理加速引擎支持并列入运行环境依赖", "quotes": ["🍔 In addition, ms-swift integrates the latest training technologies, including Megatron parallelism techniques such as T", "- **Inference Acceleration**: Supports Transformers, vLLM, SGLang, and LmDeploy inference acceleration engines, providin", "- **Model Quantization**: Supports quantization export for AWQ, GPTQ, FP8, and BNB. Exported models support inference ac", "|vllm|>=0.5.1|0.11.0/0.23.0|Inference/Deployment|"]}], "install": [{"term": "pypi", "rel": "support", "lines": [90, 92, 95, 96], "quotes": ["To install using pip:", "pip install ms-swift -U", "pip install uv", "uv pip install ms-swift -U --torch-backend=auto"]}, {"term": "source", "rel": "support", "lines": [99, 103], "quotes": ["To install from source:", "git clone https://github.com/modelscope/ms-swift.git"]}], "hardware": [], "products": [{"term": "Kimi", "rel": "mention", "lines": [23, 55], "note": "列为支持的模型，非替代/竞品对象", "quotes": ["🍲 **ms-swift** is a large model and multimodal large model fine-tuning and deployment framework provided by the ModelSco", "- 🎁 2026.07.22: Support inference for the moonshotai multimodal model Kimi-K3, including the XTML chat template, thinkin"]}, {"term": "Hugging Face", "rel": "mention", "lines": [146], "quotes": ["- By default, **ModelScope** is used for downloading models and datasets. If you want to use HuggingFace, simply specify"]}, {"term": "通义千问", "rel": "mention", "lines": [245], "quotes": ["    --model Qwen/Qwen3-4B-Instruct-2507 \\"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "669d4b42ed28": {"fn": "DataTalksClub/mlops-zoomcamp", "sha": "669d4b42ed28", "source": "readme", "identity": {"one_liner": "面向数据从业者的 9 周免费 MLOps 课程", "review": "DataTalks.Club 出品的免费 9 周 MLOps 课程，内容覆盖实验跟踪（MLflow）、工作流编排、模型部署（Flask、AWS Kinesis/Lambda）、监控（Evidently、Grafana、Prometheus）及 CI/CD、Terraform 等最佳实践，以模块化课程、作业与期末项目组成。提供直播批次与自学两种形式，2026 年暂无直播批次，材料全部开放自学。面向有 Python、Docker 与一年以上编程经验的数据科学家、ML 工程师和软件工程师。", "highlights": ["9 个模块覆盖从实验跟踪到监控的 MLOps 全流程", "完成期末项目与互评可获得结业证书", "课程视频、材料、作业全部免费开放", "Slack 社区支持提问与学习打卡"], "use_cases": ["系统学习将机器学习模型部署到生产环境的方法", "按模块自学 MLflow、编排、部署与监控工具链", "通过期末项目搭建可放入作品集的端到端 MLOps 流水线"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "none", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["MLOps", "在线课程", "模型部署", "模型监控"], "domain": "机器学习工程/教育", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "media", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L28: MLOps (machine learning operations) is a must-know skill for many data professionals. This free 9-week course teaches th", "L32: This course is for data scientists, ML engineers, and software engineers who want to learn how to put machine learning m"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": [60]}}}, "15076ab77d80": {"fn": "electerm/electerm", "sha": "15076ab77d80", "source": "readme", "identity": {"one_liner": "跨平台终端/SSH/SFTP/RDP/VNC 客户端，带 AI 助手", "review": "基于 Electron 的终端与远程连接客户端，支持 ssh/sftp/ftp/telnet/serialport/RDP/VNC/Spice 协议，覆盖 Linux/Mac/Windows/Android/HarmonyOS/iOS，兼容 UOS、Kylin、LoongArch、RISC-V 等系统。提供书签同步、隧道/跳板、Zmodem/Trzsz、代理、多语言等终端功能。AI 部分集成多 LLM API 格式（OpenAI Chat Completions/Responses、Anthropic Messages），提供命令建议、脚本编写、选中内容解释，以及 agent 模式直接执行终端操作，另有 MCP widget 供外部工具接入。", "highlights": ["AI 助手支持 OpenAI Chat Completions、OpenAI Responses、Anthropic Messages 三种 API 格式", "agent 模式可代为执行终端操作，支持创建书签/主题", "MCP widget 供 AI 助手与外部工具集成", "支持 ssh 隧道、跳板连接、Zmodem/Trzsz、全局/会话代理"], "use_cases": ["在多平台统一管理 SSH/SFTP 远程连接与文件传输", "让 AI 助手解释终端输出并生成命令/脚本", "在 UOS/Kylin/LoongArch 等国产化环境使用终端客户端", "通过 MCP 将终端能力接入外部 AI 工具"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "permissive", "deploy": "desktop", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://electerm.org/videos", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["终端", "SSH客户端", "远程桌面", "AI助手", "MCP"], "domain": "开发工具/远程连接", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["作者邮箱与微信捐赠渠道", "支持 UOS/Kylin/LoongArch 等国产系统", "README 提供中文版本"]}, "trust": {"confidence": "high", "evidence": ["L12: Open-sourced terminal/ssh/sftp/telnet/serialport/RDP/VNC/Spice/ftp client(Linux, Mac, Windows, Android, HarmonyOS, iOS).", "L50: - AI assistant integration (supporting multiple LLM API formats — OpenAI Chat Completions, OpenAI Responses, and Anthrop", "L51: - MCP (Model Context Protocol) widget for AI assistants and external tools integration - see MCP Widget Usage Guide"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "brew", "rel": "support", "lines": [57], "quotes": ["- For Mac user: `brew install --cask electerm`"]}, {"term": "npm", "rel": "support", "lines": [76, 79, 87], "quotes": ["- Install from npm", "npm i -g electerm", "- Npm: If you install from npm, just run `npm i -g electerm` again."]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "088e850bb9ed": {"fn": "yc-software/qm", "sha": "088e850bb9ed", "source": "readme", "identity": {"one_liner": "企业级多人共享 agent 运行框架，部署在自有云上，Slack 与网页使用", "review": "QM 是面向初创公司的多人 agent 运行框架：每位员工获得隔离工作区（独立记忆、文件、密钥视图、权限、定时任务、沙箱），同时可在 Slack 频道、群消息和项目中协作使用。核心以 TypeScript 运行在 Node 上，用 Postgres 持久化会话与状态，agent 通过固定工具面中的 execute 在持久沙箱执行命令。harness、模型、会话存储、沙箱、记忆均藏在接口之后可替换，部署配置集中在部署目录，由 qm CLI 校验并部署到运营者自己的云账户。提供 Strict/Auto/Dangerous 三档安全姿态与内容筛查、审计。", "highlights": ["个人与共享双作用域：每人和每个房间有独立的记忆、文件、权限与沙箱", "harness 与模型可插拔，Pi 和 Claude Code 驱动同一核心", "Strict/Auto/Dangerous 三档工具调用审批姿态与内容筛查、审计日志", "支持定时任务、监听与入站 webhook 等后台工作"], "use_cases": ["让全公司员工在 Slack 里共享使用一个可协作的 agent", "在自有云账户中用自选模型部署企业内部 agent", "让 agent 检索内部笔记、邮件、数据库并按计划处理收件箱", "让 agent 在已有仓库中跑测试、开 PR、监控 CI"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "企业", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["多用户agent平台", "Slack集成", "自托管部署", "企业内部工具"], "domain": "LLM 基础设施/企业 agent 平台", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L3: **A multiplayer agent harness for work. In Slack and on the web.**", "L74: Every turn runs through a central core, which can use a variety of models and harnesses", "L89: `qm` CLI validates and deploys. Every substrate (harness, session"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [23], "note": "提及 Pi 可运行多家提供商的模型，非专门适配", "quotes": ["them. Pi and Claude Code both drive the same core, and Pi runs models from many"]}], "install": [{"term": "npm", "rel": "support", "lines": [129, 131], "quotes": ["npm exec --yes --package=@yc-software/qm@latest -- \\", "npm install"]}, {"term": "source", "rel": "support", "lines": [160, 187], "quotes": ["git clone --single-branch --branch main --no-tags git@github.com:yc-software/qm qm-private", "From the source checkout, install dependencies with `npm ci` and use the in-tree CLI."]}], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [23, 95], "note": "作为可驱动核心的 harness 与安全姿态参照提及，非替代/竞品关系", "quotes": ["them. Pi and Claude Code both drive the same core, and Pi runs models from many", "QM's approach follows local coding agents like OpenCode, Codex, and Claude Code: the"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "1152e8dc8e4c": {"fn": "wdndev/llm_interview_note", "sha": "1152e8dc8e4c", "source": "readme", "identity": {"one_liner": "大模型算法工程师的知识整理与面试题笔记", "review": "以个人笔记形式整理大语言模型相关知识及面试题，内容参考网络资源汇编，答案为作者自行撰写并欢迎修正，提供在线阅读链接，另附微信公众号作为更新渠道。仓库同时推荐作者的其他动手实践项目（tiny-llm-zh、tiny-rag、tiny-mcp、llama3-from-scratch-zh）及 AI 工程师八股等学习资源。适合准备大模型方向岗位面试的读者阅读。", "highlights": ["覆盖 LLM 算法（应用）工程师相关知识及面试题", "提供在线阅读链接", "附带 tiny-llm-zh、tiny-rag、tiny-mcp 等配套实践项目", "llama3-from-scratch-zh 可在 16G 内存本地笔记本运行"], "use_cases": ["准备大模型算法/应用工程师岗位面试", "系统梳理 LLM 相关概念知识点", "通过配套小项目动手学习预训练、微调、RAG、MCP"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "none", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["面试题", "学习笔记", "大语言模型", "知识整理"], "domain": "AI 教育/知识整理", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["全中文 README", "微信公众号更新渠道"]}, "trust": {"confidence": "high", "evidence": ["L1: # LLMs 相关知识及面试题", "L5: 本仓库为大模型面试相关概念，由本人参考网络资源整理，欢迎阅读，如果对你有用，麻烦点一下 `🌟 star`，谢谢！", "L21: 在线阅读链接：LLMs Interview Note"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [{"term": "16G内存", "rel": "mention", "lines": [13], "note": "配套实践项目的本地运行环境描述，非本仓库自身硬件要求", "quotes": ["- llama3-from-scratch-zh : 从零实现 llama3, 可加载 meta 官方权重，可在本地笔记本（16G内存）调试运行"]}], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "baaab18e8ff7": {"fn": "theonedev/onedev", "sha": "baaab18e8ff7", "source": "readme", "identity": {"one_liner": "自托管 DevOps 平台：代码托管+CI/CD+_issue 管理+AI 助手", "review": "自托管的统一开发平台，覆盖代码搜索与导航、pull request 与代码保护规则、issue 工作流与看板、服务台邮件联动、CI/CD 编辑器与多种执行器（容器/Kubernetes/agent）、内置包仓库、版本化 Wiki、仪表盘与高可用集群。AI 部分：内置自然语言查询、代码解释、提交与 PR 审查、构建错误排查；AI 用户可在 issue/PR 流程中自主实现任务、修复失败；Workspaces 在浏览器中提供预配置 dev container 以运行终端编码 agent。README 注明服务器最低可在 1 核 2G 内存环境运行中型项目。", "highlights": ["内置 AI：自然语言查询、代码解释、PR 审查、CI/CD 规格辅助与构建错误调查", "AI 用户在 issue/PR 流程中自主实现 issue、修复 CI 失败与合并冲突", "Workspaces 提供服务端预配置 dev container，浏览器内使用终端编码 agent", "TOD CLI 与内置 skills 供编码 agent 查询/编辑 issue、PR、build 并触发 CI"], "use_cases": ["自托管一体化管理代码托管、CI/CD 与项目看板", "让 AI 以团队成员身份认领 issue、审查 PR 并修复构建失败", "在浏览器中用 Claude Code 等终端 agent 直接开发，免去本地环境配置"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["CI/CD", "代码托管", "DevOps", "AI编码助手", "自托管"], "domain": "开发工具/DevOps", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic"]}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L156: ## 🤖 Built-in AI for DevOps Intelligence", "L165: Work on any branch with preconfigured dev containers on server. Use OpenCode, Claude Code, Codex, or other terminal agen", "L179: AI users work autonomously in your issue and pull request flow: implement assigned issues, review and improve pull reque"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "compat", "lines": [165], "note": "Workspaces 中可使用 Claude Code，属配合可用而非专门适配", "quotes": ["Work on any branch with preconfigured dev containers on server. Use OpenCode, Claude Code, Codex, or other terminal agen"]}], "install": [], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [165], "note": "Workspaces 中可运行的终端 agent 之一，非替代/竞品关系", "quotes": ["Work on any branch with preconfigured dev containers on server. Use OpenCode, Claude Code, Codex, or other terminal agen"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "8edf2b605775": {"fn": "google-deepmind/deepmind-research", "sha": "8edf2b605775", "source": "readme", "identity": {"one_liner": "为科研人员提供 DeepMind 论文的配套开源代码与环境", "review": "DeepMind 官方研究仓库，收录其发表论文的实现与示例代码，并开放研究环境、数据集和代码，供更广泛的研究社区在其工作基础上开展研究。仓库以目录形式组织约 60 个论文项目，覆盖强化学习、图网络、生成模型、语言模型、因果推理、蛋白质结构预测（AlphaFold CASP13）等方向。README 未提供统一安装说明，各项目需进入对应目录查看；页面声明这不是 Google 官方产品。", "highlights": ["收录约 60 个 DeepMind 论文的实现与示例代码", "开放 DeepMind Lab、StarCraft II 等研究环境与数据集", "覆盖强化学习、图网络、生成模型、AlphaFold 等多方向"], "use_cases": ["复现或基于 DeepMind 论文实现开展研究", "使用与 DeepMind 相同的环境做强化学习实验", "查找图网络、无监督表示学习等方向的参考实现"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "research"}, "eval": {"target_user": "科研", "paper_url": "https://deepmind.com/research/publications/", "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["研究代码", "深度学习", "强化学习", "论文复现"],