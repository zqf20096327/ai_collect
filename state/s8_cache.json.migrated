 ["trl sft --model_name_or_path Qwen/Qwen2.5-0.5B \\", "trl dpo --model_name_or_path Qwen/Qwen2.5-0.5B-Instruct \\", "trl kto --model_name_or_path Qwen/Qwen2.5-0.5B-Instruct \\"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "3ee168580017": {"fn": "stas00/ml-engineering", "sha": "3ee168580017", "source": "readme", "identity": {"one_liner": "面向 LLM 训练工程师的训练/微调/推理方法论开源手册", "review": "作者基于参与 BLOOM-176B、IDEFICS-80B 训练及 Contextual.AI 工作的经验整理的开放技术手册，覆盖大语言模型与多模态模型的训练、微调和推理的方法论、工具与逐步操作说明。内容以脚本和可复制粘贴的命令为主，供 LLM/VLM 训练工程师和运维人员使用。提供 PDF/EPUB 电子书版本，附两个供 AI agent 使用的 SKILL.md 文件、网络吞吐与 TFLOPS 基准测试脚本、PyTorch 调试与 slurm 速查指南，以及加速器与网络的对比表格。以 CC BY-SA 4.0 分发。", "highlights": ["提供脚本与可直接复制的命令，覆盖 LLM/VLM 训练、微调与推理", "附 torch-dist-bench、mamf-finder 等网络与 TFLOPS 基准工具", "提供两个 SKILL.md 文件用于训练 AI agent", "提供 PDF/EPUB 电子书格式，托管于 Hugging Face Hub"], "use_cases": ["排查分布式 PyTorch 训练中的挂起或中断问题", "大规模训练前测试节点间网络连通性与吞吐", "测量加速器实际可达的 TFLOPS 水平", "快速查阅 slurm 用法与技巧"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "viral", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "科研", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["LLM训练", "工程手册/知识库", "GPU调试", "基准测试"], "domain": "机器学习工程/知识聚合", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L5: This is an open collection of methodologies, tools and step by step instructions to help with successful training and fi", "L7: This is a technical material suitable for LLM/VLM training engineers and operators. That is the content here contains lo", "L31: I maintain two SKILL.md files that you can use to teach your AI agent:"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [{"term": "Hugging Face", "rel": "mention", "lines": [27, 81], "note": "电子书托管许可与 BLOOM 训练经历致谢，非替代/竞品对象", "quotes": ["Thanks to HuggingFace for giving me permission to host my book's ebook formats at the HF hub.", "Special thanks go to Thom Wolf who proposed that I lead the BLOOM-176B training back when I didn't know anything about l"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "109f8329a518": {"fn": "danielmiessler/LifeOS", "sha": "109f8329a518", "source": "readme", "identity": {"one_liner": "个人 AI 操作系统：让 AI 基于你的上下文推动你达成目标", "review": "LifeOS 是一个通用 AI Harness，以单个自包含 skill 形式分发，安装即向 Claude Code、Cursor、Codex 等 AI 编码代理粘贴一段 prompt 完成配置。系统围绕「从当前状态到理想状态」概念组织，包含持久记忆（Cortex）、49 个技能、hooks、意图路由、七阶段 Algorithm 循环与 TELOS 身份层等组件。代码为 TypeScript 与 Bash，运行依赖 AI coding harness 和 bun，主要在 Claude Code 上测试。", "highlights": ["通过粘贴 prompt 或 curl 一行命令由 AI 完成安装", "持久记忆、技能库、智能路由与自我改进机制", "七阶段 Algorithm 循环并按复杂度分级验证", "设计为 harness 无关，基于通用原语（hooks、skills、context files）"], "use_cases": ["为个人 AI 助手添加长期记忆与上下文管理", "在 AI 编码工具上构建个人目标与任务管理系统", "整合研究、写作、安全等自定义技能到日常工作流"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": null, "model_dep": "locked-api", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["个人AI基础设施", "AI harness", "技能系统", "记忆系统", "效率工具"], "domain": "个人 AI 基础设施/效率工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic"]}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L25: **LifeOS** is a General Purpose AI Harness for doing anything you want to do in life and work with AI. It captures who y", "L84: Any high-end one. LifeOS is harness-agnostic by design — it's built on universal primitives (hooks, skills, context file", "L198: - **Skill-based distribution** — the whole system now ships as a single self-contained skill (`LifeOS/`): the orchestrat"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [14, 54, 86, 143], "quotes": ["Built with Claude", "Either path needs a capable AI coding harness — we build and run on Claude Code — and bun.", "Daniel builds and runs it on Claude Code, so that's the most-tested path today. But LifeOS isn't locked to it, and it's ", "**Anthropic and the Claude Code team** — First and foremost. You are moving AI further and faster than anyone right now."]}, {"term": "ollama", "rel": "mention", "lines": [110], "quotes": ["|**Local Model Support**|Run LifeOS with local models (Ollama, llama.cpp) for privacy and cost control|"]}], "install": [], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [40, 48, 54, 86, 143], "quotes": ["**Give it to your AI.** LifeOS is installed *by* an AI, so the install is just a prompt. Paste this into your AI coding ", "**Prefer the terminal?** There's a one-line shortcut for Claude Code on macOS/Linux:", "Either path needs a capable AI coding harness — we build and run on Claude Code — and bun.", "Daniel builds and runs it on Claude Code, so that's the most-tested path today. But LifeOS isn't locked to it, and it's ", "**Anthropic and the Claude Code team** — First and foremost. You are moving AI further and faster than anyone right now."]}, {"term": "Cursor", "rel": "mention", "lines": [40], "quotes": ["**Give it to your AI.** LifeOS is installed *by* an AI, so the install is just a prompt. Paste this into your AI coding "]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "59630c61c8f7": {"fn": "agent0ai/agent-zero", "sha": "59630c61c8f7", "source": "readme", "identity": {"one_liner": "给 agent 一个完整 Dockerized Linux 环境的开源框架", "review": "开源 agent 框架，核心是在 Docker 容器内提供完整 Linux 桌面（XFCE），agent 可操作真实 GUI 软件、终端与文件。功能包括内置浏览器（DOM 标注/改写元素）、与 agent 实时协作编辑 Markdown 与 LibreOffice 文档、100+ 社区插件的 Plugin Hub、项目级记忆与配置隔离、子 agent 分工协作，以及通过 A0 CLI 连接宿主机文件。依赖 Docker 运行，提供 Launcher 安装器、脚本安装器与直接 docker run 三条路径。", "highlights": ["容器内真实 XFCE Linux 桌面，agent 可驱动 GUI 软件如 Blender", "浏览器 Annotate 模式：点击页面元素生成检查/修改/复刻指令", "Plugin Hub 提供 100+ 社区插件，支持 MCP 服务器与 A2A 连接", "子 agent 分工协作与项目级记忆/密钥隔离"], "use_cases": ["让 agent 操作真实桌面软件完成建模、编辑等任务", "在浏览器上标注 UI 并让 agent 实现修改", "与 agent 实时协作编辑文档和表格", "通过 A0 CLI 让容器内 agent 操作本地代码仓库"]}, "filters": {"ai_role": "ai-native", "license_risk": "none", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["agent框架", "Linux桌面", "浏览器自动化", "文档协作", "多agent"], "domain": "AI Agent 框架/开发工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L6: Agent Zero is an open agent framework for work that needs more than chat: a Dockerized Linux desktop, a browser with DOM", "L26: |**Full Linux desktop**|The agent can use real GUI software, terminals, files, and desktop apps inside the Canvas.|", "L110: Agent Zero opens its own Linux desktop inside the right-side Canvas. Not a remote VM, not a shared clipboard, but a real"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "docker", "rel": "support", "lines": [41, 85], "note": "官方运行方式为 Docker，含直接 docker run 命令", "quotes": ["Agent Zero runs wherever Docker runs, from a $6 VPS or Raspberry Pi to a local workstation or GPU server.", "docker run -p 80:80 -v a0_usr:/a0/usr agent0ai/agent-zero"]}], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [177], "note": "提及未来可能支持的集成，非替代/竞品关系", "quotes": ["This is the first step toward account-backed LLM plans in Agent Zero. More integrations are coming, including Gemini CLI"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "747786e000f0": {"fn": "NVIDIA/SkillSpector", "sha": "747786e000f0", "source": "readme", "identity": {"one_liner": "给安装 AI agent 技能前的用户做安全扫描的命令行工具", "review": "SkillSpector 是面向 AI agent 技能（SKILL.md、MCP 等）的安全扫描器，在安装前检测漏洞模式、恶意行为、提示注入、数据外泄与供应链风险。提供 71 种检测模式、两阶段分析（静态分析 + 可选 LLM 语义评估）、0-100 风险评分、基线误报抑制、多格式输入与输出报告，支持 Docker 运行与批量扫描，并可作为 Pi/OpenCode 扩展嵌入 agent 会话。它是 NVIDIA Verified Skills 流水线的组成部分。LLM 语义分析需配置 OpenAI 兼容端点；对超大输入设有 fail-closed 上限。", "highlights": ["71 种漏洞模式，覆盖提示注入、数据外泄、供应链、MCP 工具投毒等 17 类", "静态分析 + 可选 LLM 语义评估的两阶段扫描", "支持 openai/anthropic/bedrock/gemini/ollama/vllm 等多种 SKILLSPECTOR_PROVIDER", "基线机制抑制已知误报，重复扫描只暴露新问题"], "use_cases": ["安装 Claude Code / Codex / MCP 技能前检测恶意模式与提示注入", "CI 中批量扫描技能目录并按 JSON/SARIF 报告做门禁", "对比 MCP Registry 快照，发现服务器身份与字段变化"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "self-host", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["agent安全", "供应链安全", "技能扫描", "MCP", "安全工具"], "domain": "AI 安全 / agent 生态工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic", "ollama", "vllm", "bedrock"]}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "mid", "evidence": ["L3: **Security scanner for AI agent skills.** Detect vulnerabilities, malicious patterns, and security risks before installi", "L14: SkillSpector is part of the NVIDIA Verified Skills pipeline, which scans, evaluates, and signs agent skills before publi", "L26: - **Multi-format input**: Scan Git repos, URLs, zip files, directories, or single files", "L260: |Provider (`SKILLSPECTOR_PROVIDER`)|Credential env var|Endpoint|Default model|"], "xcheck": {"install_missing": ["pypi"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [263, 264], "note": "SKILLSPECTOR_PROVIDER 明确支持的提供商，含默认模型", "quotes": ["|`anthropic`|`ANTHROPIC_API_KEY`|api.anthropic.com|`claude-opus-4-6` (`meta_analyzer`: `claude-sonnet-4-6`)|", "|`anthropic_proxy`|`ANTHROPIC_PROXY_API_KEY` + `ANTHROPIC_PROXY_ENDPOINT_URL`|Any Vertex-style raw-predict proxy|`claude"]}, {"term": "deepseek", "rel": "mention", "lines": [167, 168, 171], "note": "默认配置目标，但注明将 sunset 且需手动补丁", "quotes": ["> **Note on LLM support:** The default configuration targets DeepSeek as the", "> cheapest public option. DeepSeek-Chat is", "> originally tested with OpenAI-compatible endpoints — DeepSeek's lack of"]}, {"term": "ollama", "rel": "support", "lines": [268, 257], "note": "provider 表中明确支持本地 OpenAI 兼容服务器", "quotes": ["|`ollama`|_(none)_|`OLLAMA_BASE_URL` (default `http://localhost:11434/v1`)|`llama3.1:8b`|", "local OpenAI-compatible servers (Ollama, vLLM, llama.cpp) and managed"]}, {"term": "vllm", "rel": "support", "lines": [257, 173], "note": "明确列出可对接的本地 OpenAI 兼容服务器", "quotes": ["local OpenAI-compatible servers (Ollama, vLLM, llama.cpp) and managed", "> contribute a more universal backend (Ollama, vLLM, or a different provider),"]}, {"term": "bedrock", "rel": "support", "lines": [265], "note": "SKILLSPECTOR_PROVIDER=bedrock，AWS Bedrock Runtime 接入", "quotes": ["|`bedrock`|`AWS_PROFILE` (optional) + `AWS_REGION` — SigV4 via boto3|AWS Bedrock Runtime|`us.anthropic.claude-sonnet-4-6"]}, {"term": "azure", "rel": "mention", "lines": [269], "note": "窗外行提及，可见范围未确认细节", "quotes": ["|`azure_openai`|`AZURE_OPENAI_API_KEY` + `AZURE_OPENAI_ENDPOINT`|Azure OpenAI Service|`gpt-4o` (deployment defaults to t"]}], "install": [{"term": "source", "rel": "support", "lines": [55, 59], "quotes": ["**From source:**", "git clone https://github.com/NVIDIA/skillspector.git"]}, {"term": "docker", "rel": "support", "lines": [66, 72, 78], "quotes": ["Run SkillSpector without installing Python by building it locally from the included Dockerfile. The image is based on th", "# or: docker build -t skillspector .", "docker run --rm -v \"$PWD:/scan\" skillspector scan ./my-skill/ --no-llm"]}, {"term": "pypi", "rel": "mention", "lines": [757], "note": "窗外行，仅以依赖安装方式提及", "quotes": ["SC4 uses the OSV.dev API to check dependencies against the full Open Source Vulnerabilities database — covering tens of "]}], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [10], "note": "作为技能使用方被提及，非替代/竞品", "quotes": ["AI agent skills (used by Claude Code, Codex CLI, Gemini CLI, etc.) execute with implicit trust and minimal vetting. In t"]}, {"term": "LangChain", "rel": "mention", "lines": [288], "note": "窗外行提及", "quotes": ["Structured output is requested through LangChain's `with_structured_output`."]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "70b9e04008c4": {"fn": "elizaOS/eliza", "sha": "70b9e04008c4", "source": "readme", "identity": {"one_liner": "面向开发者的自主 AI agent 开源 TypeScript 框架与产品栈", "review": "以 monorepo 形式提供：核心运行时、Eliza 应用（web/桌面/移动）、CLI、云服务、原生桥接与第一方插件。运行时模型无关，通过插件注册 actions、providers、evaluators、services、model handlers 等组件；应用能力覆盖聊天、语音、记忆、知识、消息连接器、浏览器与桌面自动化、EVM/Solana 钱包操作等，实际可用性取决于操作系统、已装插件与配置的模型/服务商。另含可引导的 Linux 与 AOSP 发行版工具链及本地推理路径（Eliza-1，基于 Gemma 4 的 2B–27B 档位）。", "highlights": ["模型无关运行时 @elizaos/core，插件可注册 actions/providers/evaluators/services/model handlers 等", "本地推理路径含 2B/4B/9B/27B 模型档位及本地嵌入、语音、视觉、图像生成资产", "按能力将模型请求路由到本地、直连服务商或 Eliza Cloud 三类后端", "提供可引导的 Linux 与 AOSP 发行版（packages/os）"], "use_cases": ["从源码运行并开发自有 agent 或插件", "构建覆盖聊天、语音、知识与设备桥接的个人助理应用", "把整台设备作为 elizaOS 运行（Linux/AOSP 发行版）"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["agent框架", "本地推理", "桌面/移动应用", "钱包操作", "OS发行版"], "domain": "AI agent 框架/运行时", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L10: elizaOS is an open-source TypeScript framework and product stack for autonomous", "L90: The framework is model-agnostic and extended through plugins:", "L108: `@elizaos/plugin-local-inference` provides the"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "llama.cpp", "rel": "mention", "lines": [39], "note": "嵌入 GGUF 由运行时管理下载，未明确点名 llama.cpp，仅 GGUF 语境命中", "quotes": ["`libelizainference`. The embedding GGUF remains runtime-managed and downloads"]}], "install": [{"term": "source", "rel": "support", "lines": [25, 31, 33, 34], "quotes": ["## Run Eliza from source", "git clone --filter=blob:none https://github.com/elizaos/eliza.git", "bun install", "bun run dev"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "211949a9eaa0": {"fn": "openai/tiktoken", "sha": "211949a9eaa0", "source": "readme", "identity": {"one_liner": "面向 OpenAI 模型的快速 BPE 分词器库", "review": "tiktoken 是一个 BPE 分词 Python 库，提供编码/解码文本、按 OpenAI 模型名获取对应 tokeniser（如 gpt-4o）等 API，API 文档位于 tiktoken/core.py。文本可逆无损转换、支持任意文本、token 序列可压缩原文。附带 educational 子模块用于可视化 BPE 过程，并通过 tiktoken_ext 插件机制支持注册自定义 