支持在 x86 与 ARM CPU 及 GPU 上运行，并附 CPU/GPU 推理基准脚本与 .safetensors 转 gguf 的转换脚本。官方在 Hugging Face 发布 BitNet-b1.58-2B-4T 与两个 embedding 模型，社区模型列表含 Llama3-8B-1.58、Falcon3/Falcon-E 家族。构建需 python>=3.10、cmake>=3.22、clang>=18，Windows 需 Visual Studio 2022，从源码克隆编译后经 setup_env.py 下载/量化模型运行。", "highlights": ["提供 I2_S、TL1、TL2 三种内核，按模型与 CPU 架构列出支持矩阵", "支持对话模式（-cnv）与线程数、上下文、温度等推理参数", "提供端到端基准脚本与 dummy 模型生成脚本用于本机测试", "支持从 .safetensors 检查点转换为 gguf 模型"], "use_cases": ["在本地 CPU 上运行 1-bit/ternary 模型做文本生成", "对 BitNet 类模型做推理性能基准测试", "将 safetensors 检查点转换为 gguf 并量化推理", "在资源受限设备上部署小型 embedding 模型"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": "research"}, "eval": {"target_user": "开发者", "paper_url": "README L6/L28 链接 Technical Report", "demo_url": "README L7/L46 在线 demo 链接", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["模型推理", "1-bit LLM", "CPU推理", "量化", "边缘部署"], "domain": "AI 基础设施/模型推理", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L44: bitnet.cpp is the official inference framework for 1-bit LLMs (e.g., BitNet b1.58). It offers a suite of optimized kerne", "L204: ## Installation", "L221: ### Build from source"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "llama.cpp", "rel": "none", "lines": [], "note": "候选行号为代码示例，README 未提及 llama.cpp", "quotes": []}], "install": [{"term": "source", "rel": "support", "lines": [221, 228], "quotes": ["### Build from source", "git clone --recursive https://github.com/microsoft/BitNet.git"]}, {"term": "pypi", "rel": "support", "lines": [237], "note": "pip 安装依赖 requirements.txt，非包本身发布", "quotes": ["pip install -r requirements.txt"]}], "hardware": [], "products": [{"term": "Hugging Face", "rel": "mention", "lines": [242, 340], "note": "模型下载来源，非替代/竞品", "quotes": ["huggingface-cli download microsoft/BitNet-b1.58-2B-4T-gguf --local-dir models/BitNet-b1.58-2B-4T", "huggingface-cli download microsoft/bitnet-b1.58-2B-4T-bf16 --local-dir ./models/bitnet-b1.58-2B-4T-bf16"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "4c52ca068af4": {"fn": "photoprism/photoprism", "sha": "4c52ca068af4", "source": "readme", "identity": {"one_liner": "面向个人的自托管 AI 照片管理应用：整理、检索与分享", "review": "PhotoPrism 是一个以隐私为先的 Web 相册应用，运行于自托管服务器或云端，提供照片与视频的浏览、组织和分享功能。基于内容与位置自动打标签，并识别人脸；搜索过滤器支持标签、位置、分辨率、色彩等属性组合。元数据可从 Exif、XMP 及 Google Photos 等来源提取合并；支持 WebDAV 客户端直接连接。以 Go 语言编写（主题标签含 golang/tensorflow），采用 AGPL 许可，社区版通过 Docker 安装，另提供付费会员与商业许可。", "highlights": ["基于内容与位置自动打标签，支持人脸识别", "组合式搜索过滤器（标签、位置、分辨率、色彩、质量等）", "从 Exif/XMP/Google Photos 提取合并元数据", "WebDAV 直接挂载，PWA 跨设备使用"], "use_cases": ["在家里服务器上自托管个人照片库", "从 Google Photos 迁移并合并照片元数据", "在 iOS/Android 手机上备份和浏览家庭照片"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "dual", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "消费者", "paper_url": null, "demo_url": "https://demo.photoprism.app（README L12 提及公共 demo，具体 URL 未见）", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["照片管理", "自托管", "人脸识别", "Google Photos 迁移"], "domain": "个人媒体管理/自托管应用", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L10: PhotoPrism® is an AI-powered, privacy-first app for browsing, organizing, and sharing photos and videos. It helps tag, s", "L21: * Automatically labels your pictures based on content and location, and recognizes the faces of your family and friends", "L32: Step-by-step installation instructions for our 