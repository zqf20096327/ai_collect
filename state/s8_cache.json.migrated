ilters": {"ai_role": "ai-knowledge", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["教程课程", "AI Agent", "agentic-ai", "学习路线"], "domain": "教育/AI 教程", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L5: ## A course teaching everything you need to know to start building AI Agents", "L69: This course uses the following AI Agent frameworks and services from Microsoft:", "L71: - Microsoft Agent Framework (MAF)"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "source", "rel": "support", "lines": [25, 32], "quotes": ["> git clone --filter=blob:none --sparse https://github.com/microsoft/ai-agents-for-beginners.git", "> git clone --filter=blob:none --sparse https://github.com/microsoft/ai-agents-for-beginners.git"]}], "hardware": [], "products": [{"term": "LangChain", "rel": "mention", "lines": [115, 117, 118], "note": "同一团队的其他课程系列名称，非替代/竞品声明", "quotes": ["### LangChain", "LangChain.js for Beginners", "LangChain for Beginners"]}, {"term": "GitHub Copilot", "rel": "mention", "lines": [142, 143, 144], "note": "Copilot 系列课程条目，仅列出", "quotes": ["Copilot for AI Paired Programming", "Copilot for C#/.NET", "Copilot Adventure"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "2af580546cbe": {"fn": "tesseract-ocr/tesseract", "sha": "2af580546cbe", "source": "readme", "identity": {"one_liner": "OCR 引擎：为开发者提供图片文字识别库与命令行工具", "review": "包含 OCR 引擎 libtesseract 与命令行程序 tesseract 两个部分。第 4 版引入基于 LSTM 神经网络的行识别引擎，同时通过 --oem 0 兼容第 3 版的字符模式识别引擎。支持 Unicode/UTF-8，开箱可识别 100 多种语言，支持 PNG、JPEG、TIFF 等图像输入，输出纯文本、hOCR、PDF、TSV、ALTO、PAGE 等格式。不含 GUI，可通过 tessdata 训练数据支持更多语言，开发者可经 C/C++ API 或多语言 wrapper 集成。依赖 Leptonica 库读取图像。", "highlights": ["提供 libtesseract 库与 tesseract 命令行程序两种使用方式", "支持 LSTM 引擎与 Legacy 引擎两种 OCR 模式（--oem 切换）", "开箱支持 100 多种语言，输出文本/hOCR/PDF/TSV/ALTO/PAGE 等格式", "提供 C/C++ API 与其他语言的 wrapper 绑定"], "use_cases": ["从 PNG/JPEG/TIFF 图片中批量提取文字", "生成带文本层的可搜索 PDF 或 hOCR 结构化输出", "通过 C/C++ API 在自有应用中嵌入 OCR 能力", "训练引擎识别新的语言或字符集"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["OCR", "文字识别", "命令行工具", "图像处理"], "domain": "图像处理/OCR", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L14: This package contains an **OCR engine** - `libtesseract` and a **command line program** - `tesseract`.", "L16: Tesseract 4 adds a new neural net (LSTM) based OCR engine which is focused on line recognition, but also still supports ", "L22: Tesseract has **unicode (UTF-8) support**, and can **recognize more than 100 languages** \"out of the box\"."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "4c3cce1762c9": {"fn": "shareAI-lab/learn-claude-code", "sha": "4c3cce1762c9", "source": "readme", "identity": {"one_liner": "教学仓库：从 0 到 1 构建类 Claude Code 的 agent harness", "review": "一个 harness 工程教学课程，用 Python 从零实现类 Claude Code 的 agent 运行时，分 17 个递进章节，每章只讲一个机制：agent loop、工具注册、权限、hooks、TodoWrite、subagent、技能按需加载、上下文压缩、记忆、文件任务系统、后台任务、定时任务、MCP、多 agent 团队等。核心论点是「智能来自模型，工程者的工作是构建 harness」。每章含英/中/日三语 README 与可运行 code.py。属教学材料，非生产框架。", "highlights": ["17 个递进章节，每章实现一个 harness 机制并提供可运行 code.py", "以单一 agent loop 为核心，工具经 dispatch map 注册", "README 提供英文、中文、日文三语版本", "保留 legacy 12 课版本并提供新旧章节映射表"], "use_cases": ["想理解 Claude Code 类工具内部机制的开发者逐课跟学", "按章节动手实现自己的 agent loop 与工具系统", "用 s01-s17 章节作为 agent 工程教学材料"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["教学/课程", "agent harness", "Claude Code", "Python"], "domain": "AI 教育/agent 开发教学", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": true, "zh_origin_signals": ["提供中文翻译版本", "含日本語多语言页"]}, "trust": {"confidence": "low", "evidence": ["L5: # Learn Claude Code -- Harness Engineering for Real Agents", "L124:  The root-level `s01_*` ... `s17_*` folders are the canonical version. Each chapter contains an English default README, ", "L156: > **s01** &nbsp; *\"One loop & Bash is all you need\"* &mdash; one tool + one loop = one agent"], "xcheck": {"install_missing": ["npm", "pypi"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [5, 82, 84], "note": "围绕 Claude Code 的机制讲解与 API 调用示例，非专门适配声明", "quotes": ["# Learn Claude Code -- Harness Engineering for Real Agents", "### Why Claude Code", "Because Claude Code is the most elegant, most complete agent harness implementation we have seen. Not because of any cle"]}], "install": [{"term": "source", "rel": "support", "lines": [124], "note": "各章节提供可运行 code.py，从仓库获取运行", "quotes": [" The root-level `s01_*` ... `s17_*` folders are the canonical version. Each chapter contains an English default README, "]}], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [5, 84, 86], "note": "教学参照对象，非竞品/替代关系声明", "quotes": ["# Learn Claude Code -- Harness Engineering for Real Agents", "Because Claude Code is the most elegant, most complete agent harness implementation we have seen. Not because of any cle", "Strip Claude Code down to its essence:"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "46ba09efcc5a": {"fn": "openai/openai-cookbook", "sha": "46ba09efcc5a", "source": "readme", "identity": {"one_liner": "为 OpenAI API 使用者提供示例代码与任务指南", "review": "OpenAI 官方维护的示例代码与指南合集，覆盖使用 OpenAI API 完成常见任务的方法。示例以 Python 为主，概念可迁移到其他语言。运行示例需要 OpenAI 账号与 API key，通过 OPENAI_API_KEY 环境变量或 .env 文件配置。内容在 cookbook.openai.com 提供导航，项目采用 MIT 许可证。", "highlights": ["常见任务的示例代码与指南合集", "示例以 Python 为主，概念可应用于其他语言", "通过 OPENAI_API_KEY 环境变量或 .env 文件配置密钥", "MIT 许可证开源"], "use_cases": ["查阅 OpenAI API 完成常见任务的示例代码", "为其他编程语言移植 API 使用概念提供参考", "搭建本地环境运行官方示例 notebook"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://cookbook.openai.com", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["示例代码", "API指南", "教程"], "domain": "AI 应用开发/教程资源", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L9: Example code and guides for accomplishing common tasks with the OpenAI API. To run these examples, you'll need an OpenAI", "L11: Most code examples are written in Python, though the concepts can be applied in any language."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "70e901421465": {"fn": "D4Vinci/Scrapling", "sha": "70e901421465", "source": "readme", "identity": {"one_liner": "自适应网页抓取框架：从单次请求到全站爬取", "review": "Python 网页抓取框架，提供三类能力：Spider 爬虫框架（并发爬取、多会话、断点续爬、AutoThrottle 自适应限速、robots.txt 遵循、内置 JSON/JSONL/CSV/XML 导出）；抓取器体系（Fetcher 支持 TLS 指纹伪装，DynamicFetcher 基于 Playwright，StealthyFetcher 处理 Cloudflare Turnstile 等反爬）；自适应解析（页面结构变更后通过相似度算法重新定位元素）。提供 CLI、MCP 接口、Docker 镜像与 AI Agent Skill。面向爬虫开发者与常规数据采集用户。", "highlights": ["解析器学习页面变更，自动重新定位元素（adaptive=True）", "StealthyFetcher 开箱处理 Cloudflare Turnstile，DynamicFetcher 基于 Playwright", "Spider 框架支持并发、断点续爬、AutoThrottle 与流式输出", "提供 MCP 服务、CLI 与 AI Agent Skill 入口"], "use_cases": ["采集结构会频繁改版网站的数据且选择器不失效", "绕过 Cloudflare 等反爬机制抓取动态页面", "大规模并发爬取并支持中断后恢复", "通过 MCP 让 AI agent 调用抓取能力"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["网页抓取", "爬虫框架", "反反爬", "MCP", "数据采集"], "domain": "数据采集/爬虫", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["简体中文版自述文件"]}, "trust": {"confidence": "high", "evidence": ["L55: Scrapling is an adaptive Web Scraping framework that handles everything from a single request to a full-scale crawl.", "L57: Its parser learns from website changes and automatically relocates your elements when pages update. Its fetchers bypass ", "L183: ### AI Features"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [109], "quotes": [" TikHub.io provides 900+ stable APIs across 16+ platforms including TikTok, X, YouTube & Instagram, with 40M+ datasets. "]}], "install": [{"term": "pypi", "rel": "support", "lines": [23, 27, 40], "quotes": [" <a href=\"https://badge.fury.io/py/Scrapling\" alt=\"PyPI version\">", " PyPI package downloads", " <a href=\"https://pypi.org/project/scrapling/\" alt=\"Supported Python versions\">"]}, {"term": "docker", "rel": "support", "lines": [26], "quotes": [" Docker Pulls</a>"]}], "hardware": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}, "products": [{"term": "Cursor", "rel": "mention", "lines": [184], "quotes": ["- 🤖 **MCP Server**: Let AI chatbots and agents (Claude/Cursor/etc) scrape through Scrapling with one-shot or session-bas"]}]}}, "70ed6d23b8ef": {"fn": "headroomlabs-ai/headroom", "sha": "70ed6d23b8ef", "source": "readme", "identity": {"one_liner": "为 AI agent 压缩上下文输入输出的本地压缩层", "review": "在工具输出、日志、RAG 片段、文件与对话历史进入 LLM 前进行压缩，以 Python/TypeScript 库、本地代理、agent 包装命令和 MCP server 四种形式提供。内部按内容类型路由到不同压缩器（JSON/代码/文本），原文本地缓存并可通过 headroom_retrieve 按需取回。还提供输出 token 削减（verbosity steering、effort routing）与跨 agent 共享记忆。压缩在本地运行，不外发内容。", "highlights": ["库、代理、wrap 命令、MCP server 四种接入方式", "CCR 机制本地缓存原文，可按需取回", "支持 20 余种 agent CLI 的一键包装与还原", "输出 token 削减开关与 savings/评估命令"], "use_cases": ["给 coding agent 降低工具输出与日志的 token 消耗", "为 RAG 管道压缩检索片段", "团队统一管理多个 agent CLI 的上下文成本"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "self-host", "model_dep": "locked-api", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["上下文压缩", "agent 基础设施", "token 优化", "代理/中间件"], "domain": "LLM 基础设施/上下文工程", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic", "xai"]}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "mid", "evidence": ["L26: Headroom compresses everything your AI agent reads — tool outputs, logs, RAG", "L38: - **Library** — `compress(messages)` in Python or TypeScript, inline in any app.", "L41: - **MCP server** — `headroom_compress`, `headroom_retrieve`, `headroom_stats` for any MCP client."], "xcheck": {"install_missing": ["docker"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [145, 147, 223], "note": "对 Anthropic /v1/messages 与 thinking 预算有专门适配", "quotes": ["Both apply to Anthropic `/v1/messages` and to OpenAI-compatible", "`reasoning_effort` on OpenAI and `thinking.budget_tokens` / `output_config.effort`", "For Anthropic `/v1/messages`, `--mode cache` skips automatic `--memory` context injection so the provider prefix remains"]}, {"term": "xai", "rel": "compat", "lines": [40, 200], "note": "Grok CLI 可 wrap，经 GROK_MODELS_BASE_URL 路由", "quotes": ["- **Agent wrap** — `headroom wrap claude|codex|grok|copilot|cursor|aider|opencode|cline|continue|goose|openhands|opencla", "|Grok CLI|✅|routes via `GROK_MODELS_BASE_URL`|"]}, {"term": "bedrock", "rel": "none", "lines": [], "quotes": []}], "install": [{"term": "pypi", "rel": "support", "lines": [69, 70, 286], "quotes": ["uv tool install --python 3.13 \"headroom-ai[all]\"  # CLI in a self-contained env", "pip install \"headroom-ai[all]\"                    # Python — ships the `headroom` CLI", "pip install \"headroom-ai[proxy]\""]}, {"term": "npm", "rel": "support", "lines": [8, 91, 92], "note": "npm 包提供 TypeScript SDK", "quotes": [" npm", "The `headroom` CLI ships only in the PyPI package. The npm `headroom-ai` package", "is the TypeScript SDK — a library you import"]}, {"term": "docker", "rel": "mention", "lines": [259], "note": "Docker/CI 中凭据传递语境，非本产品安装途径", "quotes": ["Docker and CI, pass an explicit `GITHUB_CO