ble"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [182], "quotes": ["|**24. Autonomous Agents**|ReAct, Tree of Thoughts, and Reflexion architectures, memory systems, tool contracts, the eng"]}], "install": [{"term": "source", "rel": "support", "lines": [217], "quotes": ["git clone https://github.com/stefan-jansen/machine-learning-for-trading.git"]}, {"term": "docker", "rel": "support", "lines": [51, 225], "quotes": ["The data layer moves to **Polars** for fast, expression-based manipulation, and every chapter ships in **reproducible", "docker compose pull ml4t"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": [12]}}}, "ed03567071f5": {"fn": "RasaHQ/rasa", "sha": "ed03567071f5", "source": "readme", "identity": {"one_liner": "构建文本/语音对话助手的开源机器学习框架", "review": "Rasa Open Source 是用于自动化文本与语音对话的开源机器学习框架，支持 NLU 与对话管理，可接入 Facebook Messenger、Slack、Telegram、Twilio 等多种对话渠道构建上下文助手。README 声明该项目当前处于维护模式，开发重心转向基于 CALM 引擎的 Hello Rasa（LLM 处理对话理解、业务流以 Flows 描述、带 Inspector 实时决策查看）。开发者安装走 PyPI，源码开发使用 Poetry 管理依赖，项目采用 Apache 2.0 许可证。", "highlights": ["支持 NLU 与对话管理，可连接 Slack、Facebook、Telegram、Twilio 等渠道", "新方向 CALM/Hello Rasa：LLM 理解对话、代码强制业务规则", "Flows 以逻辑步骤而非对话树描述业务流程", "源码开发使用 Poetry 与 make 构建"], "use_cases": ["构建接入多渠道的文本/语音客服或对话助手", "在浏览器 playground 中用模板原型化 AI agent", "维护基于经典 Rasa 框架的存量对话系统"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://hello-rasa（Hello Rasa playground，L4/L37）", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["对话式AI", "chatbot框架", "NLU", "LLM agent"], "domain": "对话式 AI / 聊天机器人框架", "alternative_to": [], "competitors_mention