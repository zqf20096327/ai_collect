_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": "gpu-8g", "install_friction": "high", "maturity": "research"}, "eval": {"target_user": "科研", "paper_url": "https://arxiv.org/abs/2404.05892", "demo_url": "https://huggingface.co/spaces/BlinkDL/RWKV-Gradio-1", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["语言模型", "模型架构", "训练框架", "深度学习"], "domain": "AI 模型架构/深度学习", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L1: # RWKV: Parallelizable RNN with Transformer-level LLM Performance (pronounced as \"RwaKuv\" (rʌkuv in IPA), from 4 major p", "L11: RWKV-7 \"Goose\" is a strong **linear-time** & **constant-space** (no kv-cache) & **attention-free** & 100% RNN architectu", "L45: **Please use https://github.com/BlinkDL/RWKV-LM/tree/main/RWKV-v7/train_temp as RWKV-7 reference implementation**. The d"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "google", "rel": "none", "lines": [], "quotes": []}, {"term": "llama.cpp", "rel": "none", "lines": [], "quotes": []}], "install": [{"term": "pypi", "rel": "support", "lines": [100, 191], "quotes": ["RWKV pip pkg: https://pypi.org/project/rwkv/", "You can run your model using https://pypi.org/project/rwkv/ (use \"rwkv_vocab_v20230424\" instead of \"20B_tokenizer.json\")"]}], "hardware": [{"term": "7G VRAM", "rel": "support", "lines": [45], "note": "参考训练实现的默认 GPU 显存要求", "quotes": ["**Please use https://github.com/BlinkDL/RWKV-LM/tree/main/RWKV-v7/train_temp as RWKV-7 reference implementation**. The d"]}], "products": [{"term": "Hugging Face", "rel": "mention", "lines": [29, 31, 88, 90, 92], "note": "权重与 Gradio demo 托管平台，非替代/竞品", "quotes": ["Latest RWKV weights: https://huggingface.co/BlinkDL", "GGUF: 