ag": false, "lines": []}}, "links": {"scenario_tags": ["Agent Skills", "提示词/指令集", "开发者工具", "AI写作"], "domain": "AI Agent 工具/技能集合", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["全中文 README", "公众号（数字生命卡兹克）分发讲解", "面向中文用户场景（公众号写作、aihot.news）"]}, "trust": {"confidence": "high", "evidence": ["L17: 这里的每个 Skill 都是 Agent 能直接加载的结构化指令集，遵循 Agent Skills 开放标准。Claude Code、Codex、Qoder、Kimi Code、iFlow、CodeBuddy、Cursor 等 40+ 支持", "L5: #### 我自己每天在用的一些 AI Skill，都开源在这里"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "none", "lines": [], "note": "候选行均指 Claude Code 工具，未提及 Anthropic 服务接入", "quotes": []}], "install": [], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [11, 17, 50], "note": "支持的宿主 Agent 工具，非替代/竞品", "quotes": ["Claude Code", "这里的每个 Skill 都是 Agent 能直接加载的结构化指令集，遵循 Agent Skills 开放标准。Claude Code、Codex、Qoder、Kimi Code、iFlow、CodeBuddy、Cursor 等 40+ 支持", "把你脑子里那句模模糊糊、自己都还没想清楚的需求，变成一份目标任务书——粘进目标模式（Claude Code 的 `/goal`、Codex 的目标模式）就能让 AI 独立跑几个小时到完成。你全程只做一次复制粘贴。"]}, {"term": "Cursor", "rel": "mention", "lines": [17, 225], "note": "支持的宿主 Agent；L225 为研究示例对象", "quotes": ["这里的每个 Skill 都是 Agent 能直接加载的结构化指令集，遵循 Agent Skills 开放标准。Claude Code、Codex、Qoder、Kimi Code、iFlow、CodeBuddy、Cursor 等 40+ 支持", "研究一下 Cursor 这家公司"]}, {"term": "Kimi", "rel": "mention", "lines": [17, 91], "note": "Kimi Code 为支持的工具；L91 为模型搭配建议", "quotes": ["这里的每个 Skill 都是 Agent 能直接加载的结构化指令集，遵循 Agent Skills 开放标准。Claude Code、Codex、Qoder、Kimi Code、iFlow、CodeBuddy、Cursor 等 40+ 支持", "产出是纯 Markdown，没有目标模式的 Agent 直接粘贴发送也一样用。拿到任务书后推荐用规划强的模型出目标、执行强的模型跑长程——我自己是 Claude Fable 5 规划 + GPT-5.6 Sol 执行，国产的 Kimi K3"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "b4580fdd6842": {"fn": "google/skills", "sha": "b4580fdd6842", "source": "readme", "identity": {"one_liner": "为 AI agent 提供谷歌产品与技术的技能集合", "review": "谷歌官方维护的 Agent Skills 仓库，收录面向 Google 产品与技术（含 Google Cloud）的技能，按 Google Cloud 入门、AI/ML、基础设施、数据库与分析、开发者工具、安全与身份、广告等类别组织，覆盖 GKE、BigQuery、Agent Platform、Cloud Run、SecOps 等产品。通过 skills.sh 的 npx 命令安装，可选择具体技能与作用范围；另为 Claude Code、Codex、Antigravity CLI 等 agent harness 提供包含 MCP server 的插件包。", "highlights": ["按 12+ 类别组织的 Agent Skills 清单（AI/ML、基础设施、数据库、安全等）", "通过 npx skills add 安装，支持选择性安装与项目/全局作用域", "提供 skills update 命令更新并移除过时技能", "为 Claude Code、Codex、Antigravity CLI 打包产品插件（Skills + MCP servers）"], "use_cases": ["让 AI agent 获取操作 Google Cloud 资源的领域技能", "为 Claude Code 等工具安装谷歌产品插件", "按类别查找 GKE、BigQuery、SecOps 等产品的使用指南技能"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["Agent Skills", "Google Cloud", "MCP", "插件市场"], "domain": "云服务/开发工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L5: This repository contains Agent Skills for Google", "L11: npx skills add google/skills", "L223: This repo also bundles Google product plugins (Skills + MCP servers) for agent harnesses."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [227], "note": "Claude Code 插件安装渠道中提及，非模型接入", "quotes": ["|**Claude Code**|`claude plugin marketplace add google/skills`, then `claude plugin install <plugin>@google-plugins`|"]}], "install": [{"term": "npm", "rel": "support", "lines": [11, 17, 26], "quotes": ["npx skills add google/skills", "If `npx` is not available in your environ