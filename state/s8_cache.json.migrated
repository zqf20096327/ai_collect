ary", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["模型格式标准", "深度学习", "互操作性", "推理"], "domain": "机器学习基础设施/模型互操作标准", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "media", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L10: Open Neural Network Exchange (ONNX) is an open ecosystem that empowers AI developers", "L11: to choose the right tools as their project evolves. ONNX provides an open source format for AI models, both deep learnin", "L74: pip install onnx # or pip install onnx[reference] for optional reference implementation dependencies"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [71, 74], "quotes": ["ONNX released packages are published in PyPi.", "pip install onnx # or pip install onnx[reference] for optional reference implementation dependencies"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "20fa8c375ca0": {"fn": "Zeyi-Lin/HivisionIDPhotos", "sha": "20fa8c375ca0", "source": "readme", "identity": {"one_liner": "AI 证件照制作工具：抠图、换底、排版一站式生成", "review": "基于 AI 模型工作流的证件照制作工具：对人像照片进行离线抠图（仅需 CPU 推理），按尺寸规格生成标准证件照与六寸排版照，支持自定义底色、美颜与裁剪。提供 Gradio Demo、Python 推理脚本与 FastAPI 服务三种使用形态，支持纯离线或端云推理（Face++ 在线人脸检测为可选项）。Apache-2.0 许可，支持 Docker 部署，社区有 ComfyUI、微信小程序、Windows GUI 等扩展。", "highlights": ["轻量级人像抠图，纯离线且仅需 CPU 即可推理", "多种抠图模型可选（MODNet、hivision_modnet、rmbg-1.4、birefnet-v1-lite）", "生成标准证件照、六寸排版照，支持五种排版尺寸与 HEX 自定义底色", "提供 Gradio Demo、Python CLI 与 API 服务，支持 Docker 部署"], "use_cases": ["离线批量制作标准证件照并排版打印", "为应用集成证件照生成 API 服务", "对人像照片做抠图与背景替换"]}, "filters": {"ai_r