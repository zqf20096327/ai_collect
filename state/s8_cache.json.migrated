aywright 流水线）", "人工在环设计：脚本不 POST、不发邮件，用户亲自点击 Submit", "批量并行评估、重发检测、拒绝模式分析与终端 TUI 看板"], "use_cases": ["投递前判断某岗位与我的 CV 匹配度是否值得花时间", "针对具体 JD 定制 ATS 友好的简历和求职信", "追踪所有申请状态并分析被拒模式与漏斗数据", "准备行为面试问题并整理可复用的 STAR 故事库"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "消费者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["求职", "AI Agent", "简历生成", "CLI工具", "本地优先"], "domain": "求职/职业工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic"]}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L76:  Open source. Local. In the AI CLI you already use. Free and local models included.", "L110: - **Where does it all go?** Every application stays on your machine. Nothing is uploaded to us.", "L171: claude   # or codex / qwen / opencode / agy / grok — open your AI CLI here"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "compat", "lines": [171], "note": "通过 claude CLI 作为运行时配合使用；L145 的 Anthropic 为职位门户扫描对象，非模型接入", "quotes": ["claude   # or codex / qwen / opencode / agy / grok — open your AI CLI here"]}, {"term": "xai", "rel": "mention", "lines": [171], "note": "grok 作为可用 AI CLI 被提及", "quotes": ["claude   # or codex / qwen / opencode / agy / grok — open your AI CLI here"]}, {"term": "cohere", "rel": "none", "lines": [], "quotes": []}, {"term": "openrouter", "rel": "mention", "lines": [449], "note": "窗外行，README 后文提及", "quotes": ["Yes. career-ops is CLI-agnostic and runs on free and local models (OpenRouter free models, Ollama or any OpenAI-compatib"]}, {"term": "ollama", "rel": "mention", "lines": [449], "note": "窗外行，提及本地模型；L76 亦称 Free and local models i