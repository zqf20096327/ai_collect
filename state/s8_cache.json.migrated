ines": [79, 99], "note": "作为模型类型类比（类ChatGPT对话交互），非对比声明", "quotes": ["|模型类型|基座模型|指令理解模型（类ChatGPT）|", "以下为本项目推荐使用的模型列表，通常使用了更多的训练数据和优化的模型训练方法和参数，请优先使用这些模型（其余模型请查看其他模型）。**如希望体验类ChatGPT对话交互，请使用Alpaca模型，而不是LLaMA模型。** 对于Alpaca模"]}, {"term": "Hugging Face", "rel": "mention", "lines": [103, 104, 105, 106, 107], "note": "模型发布平台渠道", "quotes": ["|Chinese-LLaMA-Plus-7B|基座模型|通用120G|原版LLaMA-7B|790M|[[🤗HF]](https://huggingface.co/hfl/chinese-llama-plus-lora-7b) [[🤖Mod", "|Chinese-LLaMA-Plus-13B|基座模型|通用120G|原版LLaMA-13B|1.0G|[[🤗HF]](https://huggingface.co/hfl/chinese-llama-plus-lora-13b) [[🤖", "|Chinese-LLaMA-Plus-33B 🆕|基座模型|通用120G|原版LLaMA-33B|1.3G [6]|[[🤗HF]](https://huggingface.co/hfl/chinese-llama-plus-lora-33", "|Chinese-Alpaca-Pro-7B 🆕|指令模型|指令4.3M|*原版LLaMA-7B & LLaMA-Plus-7B* [4]|1.1G|[[🤗HF]](https://huggingface.co/hfl/chinese-al", "|Chinese-Alpaca-Pro-13B 🆕|指令模型|指令4.3M|*原版LLaMA-13B & LLaMA-Plus-13B [4] *|1.3G|[[🤗HF]](https://huggingface.co/hfl/chines"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "16b9e3aa1f36": {"fn": "lightgbm-org/LightGBM", "sha": "16b9e3aa1f36", "source": "readme", "identity": {"one_liner": "机器学习用户：基于决策树的分布式梯度提升框架", "review": "LightGBM 是基于决策树算法的梯度提升框架（GBT/GBDT/GBRT/GBM/MART），用于排序、分类等机器学习任务。支持并行、分布式与 GPU 训练，可处理大规模数据。官方提供 Python、R 包，以及 CUDA 版本和 SWIG 封装，并通过 PyPI、conda、CRAN、NuGet、Winget 等渠道分发。文档托管于 readthedocs，另收录数十个非官方生态项目（PMML 转换、Spark/Kubernetes 集成、各语言绑定、可解释性与可视化工具等）。", "highlights": ["基于决策树的梯度提升框架，用于排序、分类等任务", "支持并行、分布式与 GPU 学习，可处理大规模数据", "官方提供 Python/R 包及 CUDA、SWIG 构建，多渠道分发", "收录大量第三方生态：Spark/K8s 集成、多语言绑定、模型转换与可解释工具"], "use_cases": ["大规模数据的分类、排序等表格机器学习任务", "多机分布式训练加速模型迭代", "参加 Kaggle 等机器学习竞赛", "在 Spark/Ray/Kubernetes 等平台上运行梯度提升训练"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "desktop", "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["机器学习", "梯度提升", "表格数据", "分布式训练"], "domain": "机器学习框架", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L27: LightGBM is a gradient boosting framework that uses tree based learning algorithms. It is designed to be distributed and", "L32: - Support of parallel, distributed, and GPU learning."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [21], "quotes": ["PyPI Version"]}, {"term": "binary", "rel": "mention", "lines": [61], "note": "changelog 相关行，非明确安装途径", "quotes": ["Please refer to changelogs at GitHub releases page."]}], "hardware": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}, "products": []}}, "ae1874da883d": {"fn": "jlcodes99/cockpit-tools", "sha": "ae1874da883d", "source": "readme", "identity": {"one_liner": "管理多款 AI IDE/Cli 账号的桌面工具：切号、配额、多开", "review": "本地桌面工具，统一管理 Antigravity、Codex、GitHub Copilot、Windsurf、Kiro、Cursor、Grok CLI、CodeBuddy、Qoder、Trae、Zed、ZCode 等平台的账号：一键切换、OAuth/Token 导入、配额监控、定时唤醒任务，以及各平台应用的多账号多实例并行运行。数据保存在本机目录，提供 WebSocket 本机 API 供插件联动。支持 macOS/Windows/Linux 与 18 种界面语言。Grok CLI 凭据以明文保存在本机，README 提示依赖系统文件权限保护。", "highlights": ["覆盖 16 个 AI IDE/CLI 平台的账号切换与配额监控", "各平台多账号多实例并行运行与参数隔离", "内置 Rust/Go 双引擎本地网关，提供 OpenAI 兼容等接口", "WebSocket 仅监听 127.0.0.1，提供本机切号 API"], "use_cases": ["同时持有多个 AI IDE 账号，需要在工作与个人项目间快速切换", "监控各平台订阅配额的剩余量与重置时间", "为不同账号启动相互隔离的多个 IDE 实例"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "none", "deploy": "desktop", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "