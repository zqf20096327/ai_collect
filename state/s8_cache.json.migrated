ers": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "desktop", "model_dep": "locked-api", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["AI编码", "工作流引擎", "开发者工具", "CLI"], "domain": "开发者工具/AI 编码基础设施", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic"]}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "mid", "evidence": ["L13: Archon is a workflow engine for AI coding agents. Define your development processes as YAML workflows - planning, implem", "L26: - **Composable** - Mix deterministic nodes (bash scripts, tests, git ops) with AI nodes (planning, code generation, revi", "L129: Release binaries ship without AI providers. The quick installers ask which of"], "xcheck": {"install_missing": ["docker"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [129, 130, 132, 135], "note": "Release binaries 提供安装 Claude 等 provider 的专门支持", "quotes": ["Release binaries ship without AI providers. The quick installers ask which of", "Claude, Codex and Pi to install; pass `--providers codex` (shell) or", "or to add one later, run `archon setup` or `archon provider add <claude|codex|pi>`.", "> **The Claude provider needs Claude Code.** Compiled binaries don't bundle it."]}], "install": [{"term": "docker", "rel": "mention", "lines": [149, 245], "note": "提及 Docker 镜像与部署文档，非 README 中给出的安装途径", "quotes": ["> The Docker image ships Claude Code pre-installed. See AI Assistants → Binary path configuration for details.", "|Deployment|Docker, VPS, production setup|"]}, {"term": "brew", "rel": "support", "lines": [124, 126], "quotes": ["**Homebrew**", "brew install coleam00/archon/archon"]}, {"term": "so