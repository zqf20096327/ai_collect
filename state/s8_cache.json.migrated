.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "cpu-infer", "rel": "none", "lines": [], "quotes": []}, {"term": "llama.cpp", "rel": "none", "lines": [], "quotes": []}], "install": [{"term": "brew", "rel": "support", "lines": [11], "quotes": ["**macOS**: **Download** the `.dmg` file or run `brew install --cask netron`."]}, {"term": "binary", "rel": "support", "lines": [11, 13, 15], "quotes": ["**macOS**: **Download** the `.dmg` file or run `brew install --cask netron`.", "**Linux**: **Download** the `.deb` or `.rpm` file.", "**Windows**: **Download** the `.exe` installer or run `winget install -s winget netron`."]}, {"term": "pypi", "rel": "support", "lines": [17], "quotes": ["**Python**: `pip install netron`, then run `netron [FILE]` or `netron.start('[FILE]')`."]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "159a070752ea": {"fn": "agentscope-ai/agentscope", "sha": "159a070752ea", "source": "readme", "identity": {"one_liner": "给开发者的 agent 构建框架与服务运行时", "review": "AgentScope 2.0 是一个 agent 框架，提供 SDK 层与服务层两部分：SDK 层以 ReAct 循环、工具集、模型接入、上下文压缩、记忆、权限/人工确认、沙箱执行等构件组合出 agent；服务层为 FastAPI 后端加预置 Web UI，提供多租户多会话、leader-worker 团队编排、IM 渠道接入（飞书/Discord）、RAG 服务、MCP 与技能中心、持久化与定时调度。需 Python 3.11+，从 PyPI 或源码安装，Web UI 依赖 pnpm。", "highlights": ["ReAct 循环 agent 构建块：结构化输出、实时中断恢复、批量工具执行", "模型层接入 OpenAI、Anthropic、Gemini、DashScope、DeepSeek、Moonshot、Volcengine、xAI、Ollama 等", "内置 agent 服务：多租户多会话、团队编排、飞书/Discord 渠道、RAG、持久化", "支持 A2A 协议与 MCP 服务器、实时语音 agent（WebRTC）"], "use_cases": ["构建带工具调用与沙箱执行的开发 agent", "用 FastAPI 服务层把 agent 发布为多会话 Web 应用", "把 agent 接入飞书或 Discord 作为消息渠道", "搭建 leader-worker 多 agent 协作与任务规划流程"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": "research"}, "eval": {"target_user": "开发者", "paper_url": "https://arxiv.org/abs