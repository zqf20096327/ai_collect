缩）、订阅→低价→免费的三级自动回退、多账号轮询、配额实时追踪与 OAuth 令牌自动刷新。通过 npm 全局安装或源码/Docker 运行，提供 Web Dashboard 管理。", "highlights": ["RTK 工具输出压缩，声明节省 20-40% 输入令牌", "订阅→低价→免费的三级自动回退路由", "OpenAI/Claude/Gemini/Cursor/Kiro/Vertex 间格式转换", "自托管 STT/TTS/Embedding 提供商接入与 baseUrl 配置"], "use_cases": ["让 Claude Code/Cursor 等 CLI 工具使用免费或低价模型端点", "订阅配额用尽时自动切换到备用模型不停工", "多个提供商账号间做轮询负载分摊", "本地 whisper.cpp/vLLM 等自托管语音与嵌入服务统一接入"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "self-host", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["AI网关", "编码工具", "模型路由", "令牌优化"], "domain": "LLM 基础设施/网关路由", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic", "xai", "deepseek", "openrouter", "groq", "together", "cohere", "vllm"]}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "mid", "evidence": ["L7:  **Connect All AI Code Tools (Claude Code, Cursor, Antigravity, Copilot, Codex, Gemini, OpenCode, Cline, OpenClaw...) to", "L53: npm install -g 9router", "L387: |🎯 **Smart 3-Tier Fallback**|Auto-route: Subscription → Cheap → Free|Never stop coding, zero downtime|"], "xcheck": {"install_missing": ["pypi"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [298], "quotes": [" Anthropic"]}, {"term": "xai", "rel": "support", "lines": [310], "quotes": [" xAI"]}, {"term": "deepseek", "rel": "support", "lines": [304], "quotes": [" DeepSeek"]}, {"term": "openrouter", "rel": "support", "lines": [283], "quotes": [" OpenRouter"]}, {"term": "groq", "rel": "support", "lines": [307], "quotes": [" Groq"]}, {"term": "together", "rel": "support", "lines": [320], "quotes": [" Together AI"]}, {"term": "cohere", "re