n、Seaborn），给出初学者五步路线图，并包含 Agents 框架/工具、科研知识检索等分类的资源条目。提供 brew 安装的 academic CLI，欢迎社区贡献。面向数据科学学习者与从业者。", "highlights": ["数据科学入门路线图（Python→核心库→项目→数学→ML）", "收录专家视角的数据科学定义与职业发展链接", "Agents 分类列出可用于数据科学工作流的框架与工具", "Research & Knowledge Retrieval 分类收录 arXiv/PubMed 检索等工具条目"], "use_cases": ["寻找数据科学的学习路径与入门资料", "查找可用于数据分析工作流的 agent 工具与框架", "查找科研文献检索与 RAG 相关工具条目"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "科研", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["awesome-list", "数据科学", "学习资源", "机器学习", "导航清单"], "domain": "数据科学/知识聚合", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "mid", "evidence": ["L7: **An open-source Data Science repository to learn and apply concepts toward solving real- world problems.**", "L60: ## Agents"], "xcheck": {"install_missing": ["pypi"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "ollama", "rel": "mention", "lines": [73], "note": "收录的 CAJAL 条目中提及，非本仓库接入", "quotes": ["- CAJAL - Local AI agent for generating publication-ready scientific papers with real arXiv citations, IMRaD structure, "]}, {"term": "anthropic", "rel": "mention", "lines": [626], "note": "窗外：收录条目中提及", "quotes": ["|dna-claude-analysis|Personal genome analysis toolkit with Python scripts analyzing raw DNA data across 17 categories (h"]}], "install": [{"term": "brew", "rel": "support", "lines": [14, 15], "note": "academic CLI 的安装方式", "quotes": ["$ brew tap academic/tap", "$ brew install academic"]}, {"term": "pypi", "rel": "mention", "lines": [72], "note": "DeepAlpha 条目提及 PyPI，非本产品安装途径", "quotes": ["- DeepAlpha - AI crypto trading framework using LightGBM + XGBoost ensemble with 72 ML features. 70.9% walk-forward vali"]}], "hardware": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}, "products": [{"term": "Hugging Face", "rel": "mention", "lines": [73], "note": "CAJAL 条目提及", "quotes": ["- CAJAL - Local AI agent for generating publication-ready scientific papers with real arXiv citations, IMRaD structure, "]}]}}, "c31ac8559e4e": {"fn": "assafelovic/gpt-researcher", "sha": "c31ac8559e4e", "source": "readme", "identity": {"one_liner": "为研究任务生成带引文报告的自主深度研究 Agent", "review": "面向个人与组织的自动化研究 Agent：将任务拆解为研究问题，由 planner 与 execution 多智能体分工检索、汇总并生成超过 2,000 词、引用 20+ 来源的报告。支持网页与本地文档（PDF、CSV、Excel、Markdown、Word 等）两类数据源，提供 pip 包、Docker 部署、HTML/NextJS 前端、MCP 客户端与服务端、LangGraph 多智能体助手及 LangSmith 追踪。默认依赖 OpenAI 与 Tavily API key，也可通过 OPENAI_BASE_URL 接入自定义模型。", "highlights": ["planner/execution/publisher 多智能体架构，递归式广度+深度研究", "支持网页搜索与本地文档研究，报告可导出 PDF/Word/Markdown", "Jev 上下文过滤，无 key 时回退 BM25 关键词过滤", "提供 MCP Server（独立仓库 gptr-mcp）与 Claude Desktop 集成"], "use_cases": ["为调研课题自动生成带引用来源的研究报告", "基于本地文档库开展检索与汇总研究", "通过 MCP 把深度研究能力接入 Claude 等 AI 应用", "用 LangGraph 多智能体演示从规划到发布的协作流程"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://www.youtube.com/watch?v=f60rlc_QCxE", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["深度研究", "多智能体", "报告生成", "MCP", "网络爬取"], "domain": "AI Agent/研究自动化", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L20: **GPT Researcher the first open deep research agent designed for both web and local research on any given task.**", "L22: The agent produces detailed, factual, and unbiased research reports with citations. GPT Researcher provides a full suite", "L51: The core idea is to utilize 'planner' and 'execution' agents. The planner generates research questions, while the execut"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [41, 47, 257, 263], "note": "Claude 作为可安装 Skill 与 MCP 集成的客户端，非模型接入对象", "quotes": ["Extend Claude's deep research capabilities by installing GPT Researcher as a Claude Skill:", "Once installed, Claude can leverage GPT Researcher's deep research capabilities directly within your conversations.", "The GPT Researcher MCP Server enables AI applications like Claude to conduct deep research. While LLM apps can access we", "- Claude Desktop integration"]}], "install": [{"term": "pypi", "rel": "support", "lines": [131], "quotes": ["pip install gpt-researcher"]}, {"term": "colab", "rel": "mention", "lines": [11], "quotes": ["Open In Colab"]}, {"term": "npm", "rel": "support", "lines": [44], "note": "作为 Claude Skill 的安装途径", "quotes": ["npx skills add assafelovic/gpt-researcher"]}, {"term": "source", "rel": "support", "lines": [94], "quotes": ["    git clone https://github.com/assafelovic/gpt-researcher.git"]}, {"term": "docker", "rel": "support", "lines": [225, 230], "quotes": ["docker-compose up --build", "docker compose up --build"]}], "hardware": [], "products": [{"term": "LangChain", "rel": "mention", "lines": [108, 109, 283, 284, 285], "note": "可观测性集成与多智能体框架依赖，非替代/竞品对象", "quotes": ["    # export LANGCHAIN_TRACING_V2=true", "    # export LANGCHAIN_API_KEY={Your LangChain API Key here}", "   export LANGCHAIN_TRACING_V2=true", "   export LANGCHAIN_API_KEY=your_api_key", "   export LANGCHAIN_PROJECT=\"gpt-researcher\""]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "0af742ba4dce": {"fn": "nautechsystems/nautilus_trader", "sha": "0af742ba4dce", "source": "readme", "identity": {"one_liner": "给量化交易者的多资产多市场 Rust 原生交易引擎", "review": "以 Rust 为核心、Python 作为策略控制面的开源交易引擎，覆盖研究、确定性回测模拟与实盘执行，采用事件驱动架构并通过 PyO3 提供 Python 绑定。通过模块化适配器接入带 REST API 或 WebSocket 的任意交易场所，当前集成覆盖 CEX/DEX 加密货币交易所、外汇/股票/期货/期权等传统市场及博彩交易所。预编译 wheel 安装无需 Rust 工具链；v2 迁移期 v1 仅接收关键安全回补，当前仍处活跃开发、版本间可能出现破坏性变更。", "highlights": ["同一策略代码可在回测与实盘系统间复用", "Rust 核心（mimalloc/tokio）+ Python 控制面的双层架构", "20+ 交易所与数据商的模块化适配器集成表", "支持 128 位高精度与 64 位标准精度两种数值模式"], "use_cases": ["加密货币与传统市场的多场所量化策略回测与实盘执行", "训练强化学习交易 agent（RL/ES）", "通过适配器接入自有 REST/WebSocket 数据源构建交易系统"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "viral", "deploy": "desktop", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": true, "lines": [198]}}, "links": {"scenario_tags": ["量化交易", "回测框架", "交易引擎", "加密货币", "Rust"], "domain": "金融科技/算法交易", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L30: NautilusTrader is an open-source, production-grade, Rust-native engine for multi-asset,", "L63: - **AI Training**: Engine fast enough to train AI trading agents (RL/ES).", "L85: Python bindings are provided via PyO3 for the Rust-native v2 runtime."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [7, 172, 249, 258, 261], "quotes": ["pypi-version", "- PyPI and crates.io use OIDC Trusted Publishing through a protected `release` environment.", "1. Pre-built binary wheel from PyPI *or* the Nautech Systems package index.", "### From PyPI", "the v2 release-candidate wheels from PyPI using Python's pip package manager:"]}, {"term": "cargo", "rel": "support", "lines": [4, 155, 172, 609], "quotes": ["crates.io", "- Rust dependencies come only from crates.io; lock files pin dependencies with cryptographic checksums.", "- PyPI and crates.io use OIDC Trusted Publishing through a protected `release` environment.", "cargo install cargo-nextest"]}, {"term": "source", "rel": "support", "lines": [250, 454], "quotes": ["2. Build from source.", "    git clone --branch develop --depth 1 https://github.com/nautechsystems/nautilus_trader"]}, {"term": "binary", "rel": "support", "lines": [397], "quotes": [" - Download and install `rustup-init.exe`"]}, {"term": "docker", "rel": "support", "lines": [56, 554, 560, 561], "quotes": ["- **Portable**: Runs on Linux, macOS, and Windows. Deploy using Docker.", "docker pull ghcr.io/nautechsystems/<image_variant_tag> --platform linux/amd64", "docker pull ghcr.io/nautechsystems/jupyterlab:nightly --platform linux/amd64", "docker run -p 8888:8888 ghcr.io/nautechsystems/jupyterlab:nightly"]}, {"term": "go", "rel": "none", "lines": [], "quotes": []}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "ce34fe593ba4": {"fn": "openai/openai-agents-python", "sha": "ce34fe593ba4", "source": "readme", "identity": {"one_liner": "给开发者的多 Agent 工作流 Python 框架", "review": "OpenAI 官方发布的 Python SDK，用于构建多 Agent 工作流。核心概念包括 Agent（配置指令/工具/护栏/交接）、沙箱 Agent（容器内长时任务）、实时 Agent（WebSocket 语音）、语音管线、Agent 即工具与交接、MCP 等工具接入、输入输出护栏、人工介入机制、会话历史管理与内置 tracing。Provider 无关：支持 OpenAI Responses 与 Chat Completions API 及 100+ 其他 LLM。需 Python 3.10+，通过 pip/uv 安装，运行示例需设置 OPENAI_API_KEY。", "highlights": ["多 Agent 工作流核心原语：handoffs、guardrails、sessions、tracing", "支持文本、沙箱、实时语音、语音管线四种 Agent 运行方式", "provider-agnostic：支持 OpenAI API 及 100+ 其他 LLM", "沙箱客户端：macOS/Linux 用本地沙箱，Windows 支持 Docker 沙箱"], "use_cases": ["用 Python 编排多 Agent 协作与任务交接的工作流", "构建带语音输入输出的实时对话 Agent", "在容器沙箱中运行需要操作文件与命令的长时任务"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["多Agent框架", "Agent编排", "语音Agent", "Python SDK"], "domain": "LLM 基础设施/Agent 框架", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L3: The OpenAI Agents SDK is a lightweight yet powerful framework for building multi-agent workflows. It is provider-agnosti", "L27: To get started, set up your Python environment (Python 3.10 or newer required), and then install OpenAI Agents SDK packa"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [34, 37, 45, 48], "quotes": ["pip install openai-agents", "For voice support, install with the optional `voice` group: `pip install 'openai-agents[voice]'`. For Redis session supp", "uv add openai-agents", "For voice support, install with the optional `voice` group: `uv add 'openai-agents[voice]'`. For Redis session support, "]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "39ff5f35cf49": {"fn": "JaidedAI/EasyOCR", "sha": "39ff5f35cf49", "source": "readme", "identity": {"one_liner": "支持80+语言的即用型 OCR 图文识别库", "review": "基于 PyTorch 的开源 OCR 库：检测端使用 CRAFT 算法，识别端使用 CRNN（Resnet/VGG 特征提取 + LSTM 序列标注 + CTC 解码），支持拉丁、中文、阿拉伯、天城文、西里尔等 80+ 种语言的文字检测与识别，输出边界框、文本与置信度。以 Python 包与命令行两种方式使用，模型权重自动下载或从模型库手动放置；无 GPU 或显存不足时可切换 CPU-only 模式。手写体识别尚在开发计划中，新语言需按流程提交字符表与词典 PR。", "highlights": ["支持 80+ 语言与主流书写系统，多语言可同时传入识别", "检测用 CRAFT、识别用 CRNN（Resnet/VGG + LSTM + CTC）", "提供 Python API 与命令行两种使用方式，模型权重自动下载", "GPU 不可用或显存低时可用 gpu=False 以 CPU 模式运行"], "use_cases": ["从图片中提取多语言文字及其位置和置信度", "接入 Python 项目或脚本做批量图片 OCR", "训练或替换自己的检测/识别模型"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": "cpu-ok", "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["OCR", "计算机视觉", "多语言文字识别", "深度学习"], "domain": "计算机视觉/OCR", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L8: Ready-to-use OCR with 80+ supported languages and all popular writing scripts including: Latin, Chinese, Arabic, Devanag", "L84: In case you do not have a GPU, or your GPU has low memory, you can run the model in CPU-only mode by adding `gpu=False`.", "L120: All deep learning execution is based on Pytorch. :heart:"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [29, 34, 40], "quotes": ["Install using `pip`", "pip install easyocr", "pip install git+https://github.com/JaidedAI/EasyOCR.git"]}, {"term": "docker", "rel": "support", "lines": [45], "quotes": ["Note 2: We also provide a Dockerfile here."]}], "hardware": [{"term": "CPU-only", "rel": "support", "lines": [84, 87], "note": "无 GPU 或低显存时 gpu=False 运行，同时要求安装与 CUDA 版本匹配的 torch（L43）", "quotes": ["In case you do not have a GPU, or your GPU has low memory, you can run the model in CPU-only mode by adding `gpu=False`.", "reader = easyocr.Reader(['ch_sim','en'], gpu=False)"]}], "products": [{"term": "Hugging Face", "rel": "mention", "lines": [12], "note": "Web Demo 托管于 Hugging Face Spaces，非替代/竞品关系", "quotes": ["Integrated into Huggingface Spaces 🤗 using Gradio. Try out the Web Demo: Hugging Face Spaces"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "2417b306be18": {"fn": "gitleaks/gitleaks", "sha": "2417b306be18", "source": "readme", "identity": {"one_liner": "扫描 git 仓库、目录与 stdin 中的密码/API 密钥等秘密的工具", "review": "Go 编写的命令行工具，通过正则规则检测 git 仓库、目录文件和 stdin 输入中的硬编码秘密。提供 git/dir/stdin 三种扫描模式，支持自定义 TOML 检测规则、基线忽略旧发现、gitleaks:allow 与 .gitleaksignore 忽略机制，支持编码文本解码（percent/hex/base64）与递归归档扫描，输出 json/csv/junit/sarif 及模板自定义报告。可安装为 pre-commit 钩子或 GitHub Action。v8.19.0 起废弃 detect/protect 命令；维护者声明不再合并新功能，后续仅发布安全补丁。", "highlights": ["git/dir/stdin 三种扫描模式，基于正则规则引擎检测秘密", "TOML 自定义规则，v8.28.0 引入带邻近约束的复合规则", "基线报告忽略旧发现，支持 gitleaks:allow 与 .gitleaksignore", "内置 json/csv/junit/sarif 报告格式及 Go 模板自定义"], "use_cases": ["在 CI 中扫描仓库历史与目录里的泄漏密钥", "配置 pre-commit 钩子在提交前拦截秘密", "对 zip/tar 归档与编码文本做递归解码检测"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "permissive", "deploy": "desktop", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": true, "lines": [12]}}, "links": {"scenario_tags": ["安全扫描", "秘密检测", "CI/CD", "CLI工具", "devsecops"], "domain": "安全/DevSecOps", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L21: Gitleaks is a tool for **detecting** secrets like passwords, API keys, and tokens in git repos, files, and whatever else", "L32: Gitleaks can be installed using Homebrew, Docker, or Go. Gitleaks is also available in binary form for many popular plat", "L90: There are three scanning modes: `git`, `dir`, and `stdin`."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "brew", "rel": "support", "lines": [38], "quotes": ["brew install gitleaks"]}, {"term": "binary",