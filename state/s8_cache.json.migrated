": []}}}, "3d072264ac81": {"fn": "bmad-code-org/BMAD-METHOD", "sha": "3d072264ac81", "source": "readme", "identity": {"one_liner": "面向开发者的敏捷 AI 驱动开发工作流方法与技能集", "review": "一套以敏捷方式组织 AI 驱动开发（AiDD）的方法论，以 agent 技能与工作流形式安装到 AI 编码工具中：从澄清、规划到构建验证的交付闭环，把产品/架构决策显式化并作为上下文延续，按变更规模选择规划深度，覆盖新项目与既有代码库。稳定版 v6.12 经 npm 安装；V7 为预览 alpha，通过 skills CLI 安装，并提供 Claude Code 与 Codex 插件市场通道，运行需 uv 与 Python 脚本支持。", "highlights": ["澄清→规划→构建验证的交付闭环，按变更规模调整规划深度", "以 skills/工作流形式接入 AI 编码工具，提供 bmad-build/bmad-help 等技能入口", "官方模块生态：Test Architect、Game Dev Studio、Loop 等 6 个模块", "v6.12 稳定版与 V7 预览双通道，支持 npx skills 安装与更新"], "use_cases": ["在 AI 编码工具中为功能变更建立显式规划与上下文延续流程", "接手既有代码库时先建立经核验的项目上下文再开发", "为团队提供产品、架构、UX、测试等多视角 agent 协作工作流"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": true, "lines": [17, 29]}}, "links": {"scenario_tags": ["AI驱动开发", "敏捷方法论", "agent技能", "开发工作流"], "domain": "软件工程/AI 开发工作流", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L7: **Agile Ai Driven Development — turn an idea or change request into working software without giving up the thinking.**", "L31: Expect breaking changes between updates. You need an AI coding tool that supports skills."], "xcheck": {"license_from_readme": "MIT"}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [41], "note": "Claude Code 插件市场安装途径的语境中出现，未明确提及 Anthropic 模型接入", "quotes": ["**Claude Code plugin** — add the marketplace inside Claude Code:"]}], "install": [{"term": "npm", "rel": "support", "lines": [17, 24, 36, 39, 60], "quotes": ["BMad ships on two lines. The sta