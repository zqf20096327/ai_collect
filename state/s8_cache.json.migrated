ystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L17: Julia is a high-level, high-performance dynamic language for technical", "L52: The recommended way of installing Julia is to use `juliaup` which will install", "L88: To build the `julia` executable, run `make` from within the julia directory."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "source", "rel": "support", "lines": [74, 80, 88], "quotes": ["## Building Julia", " git clone https://github.com/JuliaLang/julia.git", "To build the `julia` executable, run `make` from within the julia directory."]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "c95912f4fb26": {"fn": "HKUDS/nanobot", "sha": "c95912f4fb26", "source": "readme", "identity": {"one_liner": "给个人用户的自托管轻量 AI agent 框架", "review": "以 Python 编写的自托管个人 AI agent 框架：提供浏览器 WebUI、终端 TUI 及 Telegram/Discord/Slack/微信/邮件等聊天渠道接入，内置文件读写、shell、网页搜索/抓取、MCP、定时任务、图像生成与多 agent 委派，通过 Dream 保存会话历史与长期记忆，并暴露 Python SDK 与 OpenAI 兼容 API。需自备模型供应商账号或本地模型服务，框架本身不提供模型。通过安装脚本、uv/pip 安装 PyPI 包或源码检出运行。", "highlights": ["WebUI、终端 TUI 与多聊天渠道接入", "内置文件工具支持读取 PDF/Word/Excel/PowerPoint", "通过 Dream 保存长期记忆，支持长时目标与定时自动化", "暴露 Python SDK 与 OpenAI 兼容 API"], "use_cases": ["自托管一个能操作文件、执行定时任务的私人 AI 助手", "通过 Telegram/Discord/微信等聊天软件与个人 agent 交互", "在服务器上部署长期运行的 agent 网关并通过 SSH 访问 WebUI"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["agent框架", "自托管", "MCP", "聊天机器人", "多agent"], "domain": "AI agent 基础设施", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "university", "zh_origin": true, "zh_origin_signals": ["HKUDS（香港大学数据科学实验室）", "提供简体/繁体中文文档", "WeChat/Feishu 社区渠道"]}, "trust": {"confidence": "mid", "evidence": ["L28: 🐈 **nanobot** is an ultra-lightweight, open-source, self-hosted personal AI agent framework written in Python. Use it in", "L49: - connect to Telegram, Discord, Slack, WeChat, Email, Mattermost, Linear, and other channels", "L61: - **Model freedom**: OpenAI-compatible APIs, local LLMs, image generation, search, and fallbacks."], "xcheck": {"install_missing": ["docker"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "ollama", "rel": "mention", "lines": [294], "quotes": ["- Local models: Ollama, vLLM or another OpenAI-compatible server."]}, {"term": "vllm", "rel": "mention", "lines": [294], "quotes": ["- Local models: Ollama, vLLM or another OpenAI-compatible server."]}, {"term": "anthropic", "rel": "mention", "lines": [500], "quotes": ["claude"]}], "install": [{"term": "pypi", "rel": "support", "lines": [15, 16, 118, 123], "quotes": [" PyPI version", " PyPI downloads", "python -m pip install nanobot-ai", "If pip reports `externally-managed-environment`, use the recommended installer, `uv tool install nanobot-ai`, `pipx inst"]}, {"term": "source", "rel": "support", "lines": [132, 140], "quotes": ["git clone https://github.com/HKUDS/nanobot.git", "python -m pip install -e ."]}, {"term": "docker", "rel": "mention", "lines": [314], "quotes": ["Prefer your own infrastructure? Follow the deployment guide for Docker, Docker Compose, Linux services, and macOS Launch"]}], "hardware": [], "products": [{"term": "Kimi", "rel": "mention", "lines": [420], "quotes": [" Kimi Open Source Friends"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "4b144274dab8": {"fn": "jeecgboot/JeecgBoot", "sha": "4b144274dab8", "source": "readme", "identity": {"one_liner": "企业级 AI 低代码平台：一句话生成前后端系统", "review": "基于 Spring Boot 与 Vue3 前后端分离架构的 AI 低代码开发平台，核心能力为低代码开发、AI 应用平台与 AI 知识库。AI Skills 结合 Claude Code 支持自然语言生成代码、表单、流程、报表与大屏；内置 AI 聊天、知识库（RAG）、流程编排、MCP 插件等模块。代码生成器支持单表、树表、一对一/一对多模型，兼容 MySQL、Oracle、PostgreSQL、达梦、人大金仓等多种数据库，支持单体与微服务部署。默认账号 admin/123456，提供 IDEA 与 Docker 启动方式。", "highlights": ["一句话生成完整系统：AI 自动建表、生成前后端 CRUD 代码与菜单权限", "AI 应用平台：聊天助手、知识库（RAG）、流程编排、MCP 与插件管理", "兼容多种主流大模型（ChatGPT、DeepSeek、Ollama、千问、智普、minimax 等）", "支持单体/微服务切换，兼容 MySQL、Oracle、达梦、人大金仓等多种数据库"], "use_cases": ["快速搭建 MIS、OA、ERP、CRM 等企业信息管理系统", "构建企业内部 AI 知识库问答系统", "低代码生成前后端代码并保留源码级扩展", "搭建 SaaS 多租户业务平台"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": null, "model_dep": "local-ok", "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "企业", "paper_url": null, "demo_url": "https://help.jeecg.com 或 L81 平台演示链接（README 未给出直接 URL）", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["低代码", "代码生成", "AI应用平台", "知识库/RAG", "微服务"], "domain": "企业应用开发/低代码平台", "alternative_to": [], "competitors_mentioned": ["Dify"], "ecosystem_compat": ["deepseek", "ollama", "anthropic"]}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["全中文 README", "信创国产化支持（达梦、人大金仓、东方通）", "QQ 交流群", "国内官网 jeecg.com"]}, "trust": {"confidence": "high", "evidence": ["L17: JeecgBoot 是一款 AI 低代码开发平台，以 **低代码开发、AI 应用平台和 AI 知识库** 为核心能力。随着 AI Skills 自然语言编程的发布，平台迈入低代码 v2.0：开发者可用一句话生成完整系统或业务模块，由 AI ", "L167: - AI框架：langchain4j 1.17.2，AI模型支持 `ChatGPT` `DeepSeek` `千问` `智普` `minimax`、`本地模型`等"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "deepseek", "rel": "support", "lines": [19, 116, 167], "quotes": ["平台内置完整的 AI 应用开发能力，包括 AI 聊天助手、知识库、流程编排、MCP 和插件，并兼容 ChatGPT、DeepSeek、Ollama 等主流大模型。", "- 15.AI能力：目前JeecgBoot支持AI大模型chatgpt和deepseek，现在最新版默认使用deepseek，速度更快质量更高。目前提供了A