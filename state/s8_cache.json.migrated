eadme", "identity": {"one_liner": "收录各家聊天产品系统提示词原文的资料集", "review": "以 Markdown 目录形式聚合多家 AI 产品的系统提示词全文，按厂商分节（Anthropic、OpenAI、Google、xAI、Meta、Perplexity、Cursor、Moonshot、DeepSeek、Qwen、Microsoft 等），每个条目附链接指向仓库内文件；维护“最近新增”变更表，标注旧模型与弃用功能的提示词归档分区；欢迎通过 PR 提交新抓取结果，README 声明定期更新。仓库为纯资料集合，无安装或运行说明。", "highlights": ["收录 20 余家厂商产品的系统提示词原文链接", "Claude 按模型版本、Claude Code 形态（桌面/云/headless/子代理）分目录", "OpenAI 区分 ChatGPT、Codex、API 注入提示词与弃用功能分区", "维护带日期的最近新增/变更表"], "use_cases": ["查阅特定版本聊天产品的系统提示词内容", "研究不同厂商提示词的组织方式与差异", "跟踪各家产品提示词的更新记录"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "viral", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "科研", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["提示词资料集", "系统提示词", "AI产品研究", "知识聚合"], "domain": "AI 知识/资料聚合", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L10: # System Prompts Leaks", "L12: The full verbatim system prompts behind the most popular chatbots in the world. Carefully curated and complete. Feel fre"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [43, 49, 52], "quotes": ["## Anthropic — Claude", "|**Claude Haiku 5.5**|**Claude Haiku 5.5 system prompt**|", "|**Claude Fable 5.1**|**Claude Fable 5.1 system prompt**|"]}, {"term": "xai", "rel": "mention", "lines": [186, 190, 197], "quotes": ["## SpaceXAI — Grok", "|**Grok 4.7**|**Grok 4.7 system prompt** (grok.com) · Grok CLI|", "|Grok Bot|Grok Bot system prompt|"]}, {"term": "deepseek", "rel": "mention", "lines": [248, 252], "quotes": ["## DeepSeek", "|DeepSeek|DeepSeek system prompt (chat.deepseek.com)|"]}], "install": [], "hardware": [], "pr