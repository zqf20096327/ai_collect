iew/Full Access 三种审批姿态、/undo 与 /restore 工作区恢复、/receipts 会话操作清单，以及 OS 沙箱（macOS Seatbelt、Linux bubblewrap）。安装覆盖 curl 脚本、winget、npm、cargo、Docker、Nix 等多条路线。", "highlights": ["40+ 内置 provider 路由，支持 OpenAI 兼容端点与 Ollama/vLLM/SGLang 本地模型", "Plan/Work/Operate 模式与审批姿态、/receipts 全量操作回执", "子 agent 委派与受监督 agent 团队（含 pre-spend check）", "MCP 服务器、skills、plugins、hooks 扩展，并加载 Claude Code 插件"], "use_cases": ["在终端里用自选模型执行修测试、改代码等编码任务", "脚本或 CI 中以 headless 方式运行编码 agent", "本地模型场景下做审批可控的代码修改与 PR 评审"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["编码agent", "终端工具", "多模型", "MCP", "本地优先"], "domain": "开发者工具/编码 agent", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["ollama", "deepseek", "openrouter", "vllm", "anthropic"]}, "intel": {"maintainer_type": "team", "zh_origin": true, "zh_origin_signals": ["README 提供简体中文/繁体中文翻译版本 (L16)"]}, "trust": {"confidence": "high", "evidence": ["L3: **The open-source coding agent that works with any model.**", "L95: - **Any model, no lock-in.** Over 40 built-in provider routes — Anthropic,", "L77: Every client drives the same local Codewhale Engine, so"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "ollama", "rel": "support", "lines": [59, 97], "quotes": [" pick a local runtime. If Ollama is already running with a chat model,", " any OpenAI-compatible endpoint and local models through Ollama, vLLM, or"]}, {"term": "deepseek", "rel": "support", "lines": [96], "quotes": [" DeepSeek, Google, Mistral, Moonshot, OpenAI, OpenRouter, xAI and more — plus"]}, {"term": "openrouter", "rel": "support", "lines": [96], "quotes": [" DeepSeek, Google, Mistral, Moonshot, OpenAI, OpenRou