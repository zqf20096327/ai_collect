s": []}}}, "1d55b057e8fa": {"fn": "mlc-ai/mlc-llm", "sha": "1d55b057e8fa", "source": "readme", "identity": {"one_liner": "面向多平台本地部署 LLM 的编译与推理引擎", "review": "MLC LLM 是面向大语言模型的机器学习编译器与部署引擎，通过 ML Compilation 将模型编译后在统一推理引擎 MLCEngine 上运行，覆盖 Linux/Windows（Vulkan、ROCm、CUDA）、macOS（Metal）、Web 浏览器（WebGPU/WASM）、iOS/iPadOS 与 Android（OpenCL on Adreno/Mali）等平台。MLCEngine 提供 OpenAI 兼容 API，可通过 REST server、Python、JavaScript、iOS、Android 调用。安装与上手方式指向官方文档，项目以软件引用（bibtex）形式给出引文信息，并列出其底层技术（如 TensorIR）的学术论文。", "highlights": ["统一推理引擎 MLCEngine 跨桌面、移动与浏览器平台运行", "提供 OpenAI 兼容 API，支持 REST server、Python、JavaScript、iOS、Android 接入", "支持 NVIDIA/AMD/Apple/Intel GPU 与 Metal、Vulkan、CUDA、ROCm、WebGPU、OpenCL 等后端", "以机器学习编译（ML Compilation）为核心技术路线"], "use_cases": ["在本地 GPU 或移动设备上部署大语言模型", "在浏览器中通过 WebGPU/WASM 运行 LLM", "为 iOS/Android 应用集成本地 LLM 推理能力", "通过 REST server 提供 OpenAI 兼容接口"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["LLM推理", "模型编译", "本地部署", "跨平台"], "domain": "LLM 基础设施/推理部署", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L14: MLC LLM is a machine learning compiler and high-performance deployment engine for large language models. The mission of ", "L43: MLC LLM compiles and runs code on MLCEngine -- a unified high-performance LLM inference engine across the above platform"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "093ab134d230": {"fn": "marimo-team/marimo", "sha": "093ab134d230", "source": "readme", "identity": {"one_liner": "反应式 Python 笔记本：可复现实验、SQL 查询、可部署为应用", "review": "一个反应式 Python 笔记本环境：运行或交互某个单元格时自动执行依赖单元格或标记为过期，消除隐藏状态，按变量引用确定性执行。笔记本以纯 Python 文件存储，可用 git 版本管理，可作为脚本执行或部署为 Web 应用。内置 SQL 引擎可查询 dataframe、数据库等，支持包管理序列化到文件并在隔离 venv 中自动安装。提供 VS Code 扩展、PyCharm 插件，支持 Jupyter 笔记本一键转换，可配合 Claude Code 等 agent 或使用编辑器内置 AI 补全（可自带 API key 或本地模型）。", "highlights": ["反应式执行：自动运行依赖单元格，无隐藏状态，确定性执行顺序", "笔记本存储为纯 .py 文件，可作为脚本执行或部署为 Web 应用/幻灯片", "内置 SQL 引擎，查询 dataframe、数据库、lakehouse、CSV、Google Sheets", "支持 molab 云端笔记本服务与 WASM 浏览器运行"], "use_cases": ["替代 Jupyter 做可复现的数据科学实验", "把分析笔记本一键变成可分享的交互式 Web 应用", "在笔记本中混合 Python 与 SQL 查询数据仓库", "让 Claude Code 等 agent 与笔记本协作生成代码"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://molab.marimo.io/notebooks", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["笔记本", "数据科学", "SQL", "反应式编程", "开发者工具"], "domain": "开发者工具/数据科学", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": true, "zh_origin_signals": ["README 提供简体中文翻译版本"]}, "trust": {"confidence": "high", "evidence": ["L23: **marimo** is a reactive Python notebook: run a cell or interact with a UI", "L35: - 🤖 **AI-native**: pair with AI agents like Claude Code, or use our editor's built-in AI features", "L91: CSVs, Google Sheets, or anything else using our built-in SQL engine, which"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [81], "note": "Claude Code 作为可搭配的 agent 被提及，非专属接入", "quotes": ["your favorite agent, such as Claude Code, Codex, or OpenCode, using [marimo"]}], "install": [{"term": "pypi", "r