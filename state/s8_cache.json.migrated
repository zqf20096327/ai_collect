oducts": [], "dual_license": {"flag": false, "lines": [76], "quotes": ["This program is under the terms of the BSD 3-Clause License. See https://opensource.org/licenses/BSD-3-Clause."]}, "deprecation": {"flag": false, "lines": []}}}, "5c98b35252ee": {"fn": "jnMetaCode/agency-agents-zh", "sha": "5c98b35252ee", "source": "readme", "identity": {"one_liner": "面向 AI 编程工具用户的即插即用专家角色库（含中国市场化原创智能体）", "review": "agency-agents 的中文社区版，收录 301 个 AI 专家角色定义，覆盖经营、工程、设计、营销、金融等 20 个部门，每个智能体含身份定义、工作流程与交付物。在英文上游翻译（235 个）之外新增 66 个中国市场原创智能体（小红书/抖音/微信/飞书/钉钉运营、Qt 上位机、机械设计等）。支持 20 种 AI 编程工具，通过脚本一键安装或手动复制到对应目录；配套 agency-orchestrator 编排器支持多智能体按 DAG 协作，另有桌面客户端与在线浏览页。MIT 协议。", "highlights": ["301 个智能体角色，含 66 个中国市场原创（⭐ 标记）", "支持 20 种 AI 编程工具，install.sh 一键安装，其他工具经 convert.sh 转换格式", "OpenClaw 集成：拆分为 SOUL.md/AGENTS.md/IDENTITY.md 三文件", "配套 agency-orchestrator 编排器：DAG 并行、断点续跑、npm 全局安装"], "use_cases": ["把小红书/抖音等运营专家角色装进 Claude Code 或 Cursor 做内容策划", "用编排器让 CEO/CTO/CMO 等多个角色从不同视角过同一议题", "复制工程部角色提示词作为安全审查、RAG 管线等任务的参考模板", "在 OpenClaw 网关中挂载角色实现多智能体协作"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": "locked-api", "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://ao.aiolaola.com/experts", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["AI角色库", "agent-definitions", "提示词模板", "AI编程工具", "中国市场运营"], "domain": "AI 编程工具生态/提示词资产", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic"]}, "intel": {"maintainer_type": "team", "zh_origin": true, "zh_origin_signals": ["全中文 README", "66 个中国市场原创智能体（小红书/抖音/微信/飞书/钉钉等）", "赞助商为国内模型聚合平台"]}, "trust": {"confidence": "high", "evidence": ["L5: > **301 个即插即用的 AI 专家角色** — 覆盖公司经营（CEO/CTO/CMO/COO/CPO/CFO）、工程、设计、营销、产品、游戏、安全、GIS、金融等 20 个部门。不是通用提示词模板，每个智能体都有独立的人设、专业流程和", "L7: agency-agents 的中文社区版。在已有上游翻译的基础上，新增了 66 个中国市场原创智能体（小红书、抖音、微信、B站、飞书、钉钉等平台运营，以及跨境电商、政务ToG、医疗合规、Qt 工业上位机、机械设计、畜禽养殖档案核对等垂直领域", "L91: npm install -g agency-orchestrator"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [5, 18, 127], "note": "Claude Code 为直接支持的首选安装目标之一", "quotes": ["> **301 个即插即用的 AI 专家角色** — 覆盖公司经营（CEO/CTO/CMO/COO/CPO/CFO）、工程、设计、营销、产品、游戏、安全、GIS、金融等 20 个部门。不是通用提示词模板，每个智能体都有独立的人设、专业流程和", "> 🧠 **新：让 Claude Code / Codex / Cursor / Gemini CLI 不再失忆** → engram：一条 `npx @jnmetacode/engram install`，自动记住每次会话问过什么、改了哪", "> Claude Code 和 GitHub Copilot 可直接安装；其他工具需先运行 `./scripts/convert.sh` 转换格式。"]}, {"term": "deepseek", "rel": "mention", "lines": [26, 84], "note": "课程主题与赞助商文案中提及，非接入关系", "quotes": ["> 📖 **官方配套课程** → AI 专家团队实战（35 节，免费）：手把手把这仓 301 位专家用成一支团队——单兵点名、自动组队、一人公司全流程，桌面端零代码教学。另有 从零学会 AI 编程（182 节）＋ 从零构建 AI 智能体（4", "感谢 星图 AstraFlow 赞助本项目！星图 AstraFlow 由 UCloud 上市公司出品，聚合 MiniMax-H3、Seedance-2.5 等主流视频生成模型，文案生成与视频生成一个平台全搞定，无需多端注册、多处对接。支持 "]}, {"term": "xai", "rel": "mention", "lines": [49, 52], "note": "赞助商文案中提及 Grok，非接入关系", "quotes": [" LanoX AI — 全球模型接入服务，聚合 GPT / Claude / Gemini / Qwen / Grok 及多模态模型，顶级模型低至官方价 1 折起", "感谢 LanoX AI 赞助了本项目！LanoX AI 为开发者、团队与企业提供稳定、高性价比的全球模型接入服务，覆盖 GPT、Claude、Gemini、Qwen、Grok 等主流模型，以及 Seedance 2.0、GPT Image、"]}], "install": [{"term": "npm", "rel": "support", "lines": [91], "note": "配套编排器 agency-orchestrator 的 npm 全局安装途径", "quotes": ["npm install -g agency-orchestrator"]}], "hardware": [], "products": [{"term": "GitHub Copilot", "rel": "mention", "lines": [5, 127, 143], "note": "被支持的工具，非替代/竞品对象", "quotes": ["> **301 个即插即用的 AI 专家角色** — 覆盖公司经营（CEO/CTO/CMO/COO/CPO/CFO）、工程、设计、营销、产品、游戏、安全、GIS、金融等 20 个部门。不是通用提示词模板，每个智能体都有独立的人设、专业流程和", "> Claude Code 和 GitHub Copilot 可直接安装；其他工具需先运行 `./scripts/convert.sh` 转换格式。", "# Claude Code / GitHub Copilot（直接复制即可）"]}, {"term": "Claude Code", "rel": "mention", "lines": [5, 18, 127], "note": "被支持的工具", "quotes": ["> **301 个即插即用的 AI 专家角色** — 覆盖公司经营（CEO/CTO/CMO/COO/CPO/CFO）、工程、设计、营销、产品、游戏、安