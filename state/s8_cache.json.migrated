": ["为量化研究在 Python 中获取历史行情数据", "为 AI copilot/agent 通过 MCP 提供金融数据层", "将自有数据源接入研究看板与 Excel"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "none", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "企业", "paper_url": null, "demo_url": "https://colab.research.google.com/github/OpenBB-finance/OpenBB/blob/develop/examples/googleColab.ipynb", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["金融数据", "量化金融", "数据集成", "MCP"], "domain": "金融科技/数据平台", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L15: Open Data Platform by OpenBB (ODP) is the open-source toolset that helps data engineers integrate proprietary, licensed,", "L17: ODP operates as the \"connect once, consume everywhere\" infrastructure layer that consolidates and exposes data to multip", "L72: This will launch a FastAPI server, via Uvicorn, at `127.0.0.1:6900`."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [25, 63, 104, 114], "quotes": ["Get started with: `pip install openbb`", "pip install openbb", "The ODP Python Package can be installed from PyPI package by running `pip install openbb`", "It can be installed by running `pip install openbb-cli`"]}, {"term": "source", "rel": "support", "lines": [106, 116], "quotes": ["or by cloning the repository directly with `git clone https://github.com/OpenBB-finance/OpenBB.git`.", "or by cloning the repository directly with `git clone https://github.com/OpenBB-finance/OpenBB.git`."]}, {"term": "colab", "rel": "mention", "lines": [10, 11], "quotes": ["<a target=\"_blank\" href=\"https://colab.research.google.com/github/OpenBB-finance/OpenBB/blob/develop/exampl