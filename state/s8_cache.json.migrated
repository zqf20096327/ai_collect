e, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L27: Docling simplifies document processing by parsing diverse formats — including advanced PDF understanding — and providing", "L37: - 🤖 Plug-and-play [integrations][integrations] incl. LangChain, LlamaIndex, Crew AI & Haystack for agentic AI"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [11, 12, 57], "quotes": ["PyPI version", "PyPI - Python Version", "pip install docling"]}], "hardware": [], "products": [{"term": "LangChain", "rel": "mention", "lines": [37], "note": "被集成的框架，非替代/竞品对象", "quotes": ["- 🤖 Plug-and-play [integrations][integrations] incl. LangChain, LlamaIndex, Crew AI & Haystack for agentic AI"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "9727b6758338": {"fn": "calesthio/OpenMontage", "sha": "9727b6758338", "source": "readme", "identity": {"one_liner": "把 AI 编码助手变成完整视频制作工作室的 agentic 系统", "review": "OpenMontage 是一套以 agent 驱动的视频生产系统：12 条制作流水线、100+ 工具、700+ agent 技能与制作知识文件，用户用自然语言描述需求，由 AI 编码助手（Claude Code/Cursor/Copilot/Windsurf/Codex）完成调研、脚本、素材生成、剪辑与合成。支持图片式视频与真实素材路径（从 Archive.org、NASA 等开放档案检索动态片段后剪辑渲染）。依赖 Python 3.10+、FFmpeg、Node.js 18+，通过 make setup 或手动 venv/npm 安装；所有 API key 可选，零 key 时用 Piper TTS 等免费工具。含 Backlot 本地看板用于实时展示制作进度与人工审批门。", "highlights": ["12 条制作流水线、100+ 工具、700+ agent 技能与制作知识文件", "从 YouTube/Shorts/TikTok/本地片段出发生成有依据的制作方案与成本预估", "Backlot 本地看板：分阶段展示进度、分镜审批门与可审计的 provider 决策日志", "零 API key 路径：Piper TTS 旁白、开放档案素材、Remotion/HyperFrames 合成、FFmpeg 后期"], "use_cases": ["用自然语言让编码助手生成动画短片、纪录片或产品宣传视频", "从参考视频出发生成风格相近的新主题视频方案", "GPU 本地离线生成视频片段，避免按次付费 API"]}, "filters": {"ai_role": "ai-native", "license_risk": "viral", "deploy": "library", "model_dep": "local-ok", "hardware": null, "install_friction": "high", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": nul