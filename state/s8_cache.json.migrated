: null, "demo_url": "https://tesseract.projectnaptha.com/", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["OCR", "JavaScript库", "WebAssembly", "图像识别"], "domain": "OCR/前端工具库", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L17: Tesseract.js is a javascript library that gets words in almost any language out of images. (Demo)", "L27: Tesseract.js works in the browser using webpack, esm, or plain script tags with a CDN and on the server with Node.js.", "L62: Tesseract.js aims to bring the Tesseract OCR engine (a separate project) to the browser and Node.js, and works by wrappi"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "npm", "rel": "support", "lines": [39, 56], "quotes": ["Tesseract.js works with a `<script>` tag via local copy or CDN, with webpack via `npm` and on Node.js with `npm/yarn`.", "npm install tesseract.js"]}, {"term": "source", "rel": "support", "lines": [131], "quotes": ["git clone https://github.com/naptha/tesseract.js.git"]}], "hardware": [], "products": [{"term": "ChatGPT", "rel": "mention", "lines": [81], "note": "社区示例中的扩展项目涉及 ChatGPT，非竞品关系", "quotes": [" - Chrome Extension (with Manifest V3): https://github.com/Tshetrim/Image-To-Text-OCR-extension-for-ChatGPT"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "35838a96a565": {"fn": "lyogavin/airllm", "sha": "35838a96a565", "source": "readme", "identity": {"one_liner": "让单张 4GB 显卡运行超大 LLM 的推理库", "review": "Python 推理库，通过每次仅在 GPU 上保留一层解码层、逐层从磁盘流式加载的方式降低显存占用，README 称可在 4GB 显存上运行 70B 模型，无需量化、蒸馏或剪枝；v3.0 起支持 FP8，并提供 block-wise 量化压缩（宣称最高 3x 推理加速）。经 pip 安装，通过 AutoModel 传入 Hugging Face 模型 ID 或本地路径使用；推理前会将原模型分层切分保存，需要充足磁盘空间。支持 Apple Silicon 上的 MacOS，并提供小显存 LoRA 微调脚本。", "highlights": ["逐层流式加载，使显存需求取决于单层大小而非模型总大小", "支持 4bit/8bit block-wise 量化压缩（模型加载体积减小）", "通过 AutoModel 一行代码加载多种开源 LLM", "提供小显存 LoRA 训练（冻结权重逐层流式、仅适配器驻留 GPU）"], "use_cases": ["在消费级显卡上运行 70B 及以上参数的开源模型推理", "MacOS Apple Silicon 上运行大语言模型", "小显存环境下对大模型进行 LoRA 微调"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://colab.research.google.com/github/lyogavin/airllm/blob/main/air_llm/examples/run_all_types_of_models.ipynb", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["LLM推理", "显存优化", "LoRA微调", "模型压缩"], "domain": "LLM 基础设施/推理优化", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["deepseek", "mistral"]}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L9: **AirLLM** dramatically reduces inference memory usage, letting 70B large language models run on a single 4GB GPU card —", "L77: pip install airllm", "L187: The trick: AirLLM only ever keeps **one layer on the GPU at a time**, so the VRAM you need depends on the model's layer "], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "deepseek", "rel": "compat", "lines": [40, 183, 198], "note": "作为可加载的模型家族，经 AutoModel 配合使用", "quotes": ["[2026/06] **v3.0**: FP8 model support + the latest models. Run **DeepSeek-V3 (671B) on ~12GB** and **Qwen3-235B on ~3GB*", "**Llama** (2 / 3 / 3.1 / 3.3 / 4) · **Qwen** (1 / 2 / 2.5 / 3 / 3.5 / 3.8, including MoE, Flash-Next, FP8, and native VL", "|DeepSeek-V3|**671B**|**~12 GB**|"]}, {"term": "mistral", "rel": "compat", "lines": [148, 168, 183], "note": "示例与支持模型列表中的模型家族", "quotes": ["#### example of other models (ChatGLM, QWen, Baichuan, Mistral, etc):", "* Baichuan, InternLM, Mistral, etc:", "**Llama** (2 / 3 / 3.1 / 3.3 / 4) · **Qwen** (1 / 2 / 2.5 / 3 / 3.5 / 3.8, including MoE, Flash-Next, FP8, and native VL"]}], "install": [{"term": "pypi", "rel": "support", "lines": [74, 77], "quotes": ["First, install the airllm pip package.", "pip install airllm"]}, {"term": "colab", "rel": "mention", "lines": [142, 144], "note": "示例 notebook 托管于 Colab，非本产品安装途径", "quotes": ["Example colabs here:", "<a target=\"_blank\" href=\"https://colab.research.google.com/github/lyogavin/airllm/blob/main/air_llm/examples/run_all_typ"]}], "hardware": [], "products": [{"term": "Kimi", "rel": "mention", "lines": [9, 38, 183], "note": "被支持运行的开源模型，非替代/竞品对象", "quotes": ["**AirLLM** dramatically reduces inference memory usage, letting 70B large language models run on a single 4GB GPU card —", "[2026/07] **Kimi K3 (2.8T)** support: the largest open-source model runs on a single card in **3.72GB** of VRAM, measure", "**Llama** (2 / 3 / 3.1 / 3.3 / 4) · **Qwen** (1 / 2 / 2.5 / 3 / 3.5 / 3.8, including MoE, Flash-Next, FP8, and native VL"]}, {"term": "Hugging Face", "rel": "mention", "lines": [82, 93, 126], "note": "模型下载来源与 token 配置项，非竞品", "quotes": ["Then, initialize AirLLMLlama2, pass in the huggingface repo ID of the model being used, or the local path, and inference", "Note: During inference, the original model will first be decomposed and saved layer-wise. Please ensure there is suffici", "* **hf_token**: huggingface token can be provided here if downloading gated models like: *meta-llama/Llama-2-7b-hf*"]}, {"term": "通义千问", "rel": "mention", "lines": [34, 58, 159], "note": "被支持的模型家族（Qwen），非竞品对象", "quotes": ["[2026/08] **Qwen3.8-Flash-Next** support: Qwen's 125B MoE flagship (`Qwen4ExpForConditionalGeneration`) with a ~51B n-gr", "[2023/12/03] added support of **ChatGLM**, **QWen**, **Baichuan**, **Mistral**, **InternLM**!", "* QWen:"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "9fb028bf0092": {"fn": "anthropics/prompt-eng-interactive-tutorial", "sha": "9fb028bf0092", "source": "readme", "identity": {"one_liner": "面向开发者的 Claude 提示词工程交互式教程", "review": "Anthropic 官方的提示词工程交互式课程，共 9 章（初级到高级）加附录，每章配练习与答案，按章节顺序学习。每节课末尾提供 Example Playground，可修改提示词并观察 Claude 响应变化；示例使用 Claude 3 Haiku 模型，另提供基于 Claude for Sheets 扩展的 Google Sheets 版本。内容覆盖提示词结构、消除幻觉、思维链、示例使用及法律/金融/编码等行业用例。", "highlights": ["9 章分级课程，每章配练习与答案", "每课附带 Example Playground 供实验", "行业用例章节含法律、金融、编码复杂提示练习", "附录覆盖提示链、工具使用、检索"], "use_cases": ["从头学习 Claude 提示词的编写与调试", "为客服机器人、法律、金融等场景构建复杂提示", "了解常见提示失效模式及应对方法"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "none", "deploy": null, "model_dep": "locked-api", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["提示词工程", "教程", "学习资料", "LLM"], "domain": "LLM 教育与知识", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic"]}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L1: # Welcome to Anthropic's Prompt Engineering Interactive Tutorial", "L19: Note: This tutorial uses our smallest, fastest, and cheapest model, Claude 3 Haiku. Anthropic has two other models, Clau"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [1, 19, 21], "quotes": ["# Welcome to Anthropic's Prompt Engineering Interactive Tutorial", "Note: This tutorial uses our smallest, fastest, and cheapest model, Claude 3 Haiku. Anthropic has two other models, Clau", "*This tutorial also exists on Google Sheets using Anthropic's Claude for Sheets extension. We recommend using that versi"]}], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "1d82166df7d4": {"fn": "chatchat-space/Langchain-Chatchat", "sha": "1d82166df7d4", "source": "readme", "identity": {"one_liner": "给开发者的可离线部署本地知识库 RAG 与 Agent 应用", "review": "基于 Langchain 框架构建的本地知识库问答与 Agent 应用项目，原名为 Langchain-ChatGLM。支持接入 ChatGLM、Qwen、Llama 等语言模型，通过 Xinference、Ollama、LocalAI、FastChat 等模型部署框架加载本地模型，也可接入 OpenAI、Azure、Anthropic 等在线 API。提供知识库对话、文件对话、数据库对话、搜索引擎对话、文生图、多模态图片对话等功能，底层支持 BM25+KNN 等多种检索方式。以 Python 库（pip）形式安装，或通过 Docker 部署；不涉及模型微调与训练。", "highlights": ["支持 Xinference、Ollama、LocalAI、FastChat 等本地模型部署框架接入", "支持 BM25+KNN 等多种检索方式与本地知识库管理", "以 Python 库形式安装（pip install langchain-chatchat），提供 Docker 镜像", "Agent 与工具调用，支持多模态图片对话与文生图"], "use_cases": ["在企业内网离线部署本地知识库问答系统", "基于自有文档构建 RAG 问答与检索服务", "通过 WebUI 或 API 进行知识库对话与文件对话"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "self-host", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["RAG", "知识库问答", "本地部署", "Agent", "LLM应用"], "domain": "LLM 应用/RAG", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["ollama"]}, "intel": {"maintainer_type": "team", "zh_origin": true, "zh_origin_signals": ["中文 README", "清华源建议", "腾讯云国内镜像", "微信公众号/微信群交流"]}, "trust": {"confidence": "high", "evidence": ["L11: 基于 ChatGLM 等大语言模型与 Langchain 等应用框架实现，开源、可离线部署的 RAG 与 Agent 应用项目。", "L29: ✅ 本项目支持市面上主流的开源 LLM、 Embedding 模型与向量数据库，可实现全部使用**开源**模型**离线私有部署**。与此同时，本项目也支持", "L122: 从 0.3.0 版本起，Langchain-Chatchat 提供以 Python 库形式的安装方式，具体安装请执行："], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "ollama", "rel": "support", "lines": [23, 89, 142], "quotes": ["启发，建立了全流程可使用开源模型实现的本地知识库问答应用。本项目的最新版本中可使用 Xinference、Ollama", "|模型部署框架|Xinference|LocalAI|Ollama|FastChat|", "及后续会提供支持的多模态模型等，均改为支持市面常见的各大模型推理框架接入，如 Xinference、Ollama、LocalAI、FastChat、One API"]}, {"term": "llama.cpp", "rel": "none", "lines": [], "quotes": []}, {"term": "vllm", "rel": "mention", "lines": [92], "note": "作为部署框架的加速推理引擎列出", "quotes": ["|加速推理引擎|GPTQ, GGML, vLLM, TensorRT, mlx|GPTQ, GGML, vLLM, TensorRT|GGUF, GGML|vLLM|"]}, {"term": "anthropic", "rel": "mention", "lines": [102], "quotes": ["框架接入提供了支持，支持包括 OpenAI ChatGPT、Azure OpenAI API、Anthropic Claude、智谱清言、百川"]}, {"term": "azure", "rel": "mention", "lines": [102], "quotes": ["框架接入提供了支持，支持包括 OpenAI ChatGPT、Azure OpenAI API、Anthropic Claude、智谱清言、百川"]}], "install": [{"term": "pypi", "rel": "support", "lines": [125, 129, 135], "quotes": ["pip install langchain-chatchat -U", "> 为确保所使用的 Python 库为最新版，建议使用官方 Pypi 源或清华源。", "> pip install \"langchain-chatchat[xinference]\" -U"]}, {"term": "docker", "rel": "support", "lines": [272, 274], "quotes": ["docker pull chatimage/chatchat:0.3.1.3-93e2c87-20240829", "docker pull ccr.ccs.tencentyun.com/langchain-chatchat/chatchat:0.3.1.3-93e2c87-20240829 # 国内镜像"]}], "hardware": [], "products": [{"term": "LangChain", "rel": "mention", "lines": [11, 17, 25], "note": "项目所基于的框架", "quotes": ["基于 ChatGLM 等大语言模型与 Langchain 等应用框架实现，开源、可离线部署的 RAG 与 Agent 应用项目。", "🤖️ 一种利用 langchain", "等模型，依托于 langchain"]}, {"term": "通义千问", "rel": "mention", "lines": [59, 65, 76, 79], "note": "作为可接入/推荐模型提及", "quotes": ["|Agent|❌不稳定|✅针对ChatGLM3和Qwen进行优化,Agent能力显著提升||", "|多模态图片对话|❌|✅ 推荐使用 qwen-vl-chat||", "|选中\"启用Agent\",选择多个工具|由LLM自动进行工具调用|使用ChatGLM3/Qwen或在线API等具备Agent能力的模型|", "|不选中任何工具，上传一个图片|图片对话|使用 qwen-vl-chat 等多模态模型|"]}, {"term": "ChatGPT", "rel": "mention", "lines": [102], "note": "作为可接入的在线 API 提及", "quotes": ["框架接入提供了支持，支持包括 OpenAI ChatGPT、Azure OpenAI API、Anthropic Claude、智谱清言、百川"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "7e36c689b1ac": {"fn": "linshenkx/prompt-optimizer", "sha": "7e36c689b1ac", "source": "readme", "identity": {"one_liner": "提示词优化工具：编写、测试与评估更好的 AI 提示词", "review": "面向使用 AI 模型的用户，提供提示词的优化、测试、评估与收藏管理。支持系统提示词与用户提示词双模式优化、多轮迭代改进、单结果与对比评估、上下文变量与多轮对话测试，并提供文本生成图像提示词的优化。提供网页版、桌面应用、Chrome 扩展与 Docker 四种使用方式，纯客户端处理，数据直接与模型服务商交互；通过 MCP 协议可接入 Claude Desktop 等 AI 应用。使用前需自行配置模型 API key。", "highlights": ["一键优化与多轮迭代改进，支持系统/用户提示词双模式", "多模型接入：OpenAI、Gemini、DeepSeek、Grok、智谱、SiliconFlow、MiniMax 等", "文本生成图像（T2I/I2I/多图）提示词优化与模型参数配置", "MCP 协议支持，可集成 Claude Desktop 等 MCP 兼容应用"], "use_cases": ["为不同模型编写并迭代优化提示词", "通过对比评估判断提示词是否真正改进", "优化文生图提示词以获得更可控的画面描述", "通过 MCP 将提示词优化能力接入桌面 AI 应用"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "none", "deploy": "desktop", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://prompt.always200.com", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["提示词工程", "Prompt优化", "文生图", "MCP", "多模型接入"], "domain": "AI 工具/Prompt 工程", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["deepseek", "xai", "anthropic", "ollama", "openrouter"]}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["作者 linshenkx", "README 提供中文版本", "智谱/SiliconFlow/MiniMax 等国内模型接入"]}, "trust": {"confidence": "high", "evidence": ["L21: Prompt Optimizer is a powerful AI prompt optimization tool that helps you write better AI prompts and improve the qualit", "L44: - 🤖 **Multi-model Integration**: Support for mainstream AI models including OpenAI, Gemini, DeepSeek, Grok, Zhipu AI, Si", "L52: - 🧩 **MCP Protocol Support**: Supports Model Context Protocol (MCP), enabling integration with MCP-compatible AI applica"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "deepseek", "rel": "support", "lines": [44, 174, 228], "quotes": ["- 🤖 **Multi-model Integration**: Support for mainstream AI models including OpenAI, Gemini, DeepSeek, Grok, Zhipu AI, Si", "MCP_DEFAULT_MODEL_PROVIDER=openai  # Options: openai, gemini, anthropic, deepseek, grok, siliconflow, zhipu, dashscope, ", "3. Click on the model you need to configure (such as OpenAI, Gemini, DeepSeek, Grok, etc.)"]}, {"term": "xai", "rel": "support", "lines": [44, 45, 60, 174, 228], "quotes": ["- 🤖 **Multi-model Integration**: Support for mainstream AI models including OpenAI, Gemini, DeepSeek, Grok, Zhipu AI, Si", "- 🖼️ **Image Generation**: Support for Text-to-Image (T2I), Image-to-Image (I2I), and Multi-Image generation with models", "- 🔌 **Multi-model Support**: Integrated with mainstream image generation models like Gemini, Seedream, Grok", "MCP_DEFAULT_MODEL_PROVIDER=openai  # Options: openai, gemini, anthropic, deepseek, grok, siliconflow, zhipu, dashscope, ", "3. Click on the model you need to configure (such as OpenAI, Gemini, DeepSeek, Grok, etc.)"]}, {"term": "anthropic", "rel": "support", "lines": [174], "quotes": ["MCP_DEFAULT_MODEL_PROVIDER=openai  # Options: openai, gemini, anthropic, deepseek, grok, siliconflow, zhipu, dashscope, "]}, {"term": "ollama", "rel": "compat", "lines": [121], "quotes": ["- ✅ **No CORS Limitations**: As a native desktop application, it completely eliminates browser Cross-Origin Resource Sha"]}, {"term": "openrouter", "rel": "support", "lines": [174], "quotes": ["MCP_DEFAULT_MODEL_PROVIDER=openai  # Options: openai, gemini, anthropic, deepseek, grok, siliconflow, zhipu, dashscope, "]}], "install": [{"term": "docker", "rel": "support", "lines": [129, 134, 141], "quotes": ["### 5. Docker Deployment", "docker run -d -p 8081:80 --restart unless-stopped --name prompt-optimizer linshen/prompt-optimizer", " Click to view Docker Compose deployment steps"]}, {"term": "source", "rel": "mention", "lines": [144], "quotes": ["git clone https://github.com/linshenkx/prompt-optimizer.git"]}], "hardware": [], "products": [{"term": "Cursor", "rel": "none", "lines": [], "quotes": []}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "586c12c792d4": {"fn": "CopilotKit/CopilotKit", "sha": "586c12c792d4", "source": "readme", "identity": {"one_liner": "给开发者提供 agent 前端接入栈与 Generative UI", "review": "面向构建 agent 应用的前端 SDK：将聊天 UI、Generative UI、共享状态与 human-in-the-loop 工作流接入 React、Angular、Vue、React Native 等框架，并通过 Channels SDK 将同一 agent 发布到 Slack、Microsoft Teams、Discord、WhatsApp、Telegram 等渠道。底层的 agent 前端通信由其维护的 AG-UI Protocol 承担，提供 useAgent hook 编程式控制 agent 连接。安装走 npm/npx 脚手架命令，另有可选的 CopilotKit Intelligence 托管或自托管平台（持久会话、用户记忆、分析）。MIT 许可。", "highlights": ["支持 React/Angular/Vue/React Native 前端框架接入", "提供 Generative UI、共享状态与 human-in-the-loop 机制", "Channels SDK 支持发布到 Slack/Teams/Discord/WhatsApp/Telegram", "维护 AG-UI Protocol 并提供 useAgent hook"], "use_cases": ["为现有 agent 搭建 Web 或移动端聊天与生成式界面", "把同一个 agent 同时发布到 Slack、Teams 等聊天渠道", "构建需要用户确认或编辑输入的 agent 工作流"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://github.com/user-attachments/assets/7372b27b-8def-40fb-a11d-1f6585f556ad", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["Agent前端", "Generative UI", "聊天UI", "AG-UI协议"], "domain": "AI 应用开发框架/Agent 前端", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L10: Build **agent-native applications** — on any framework, on any surface.", "L38: CopilotKit is a best-in-class SDK for building full-stack agentic applications, Generative UI, and chat applications.", "L132: Your agent logic stays the same — AG-UI handles the wire protocol, CopilotKit handles the UI layer for each framework an"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "npm", "rel": "support", "lines": [18, 19, 56, 64, 72, 187], "quotes": [" <a href=\"https://www.npmjs.com/package/@copilotkit/react-core\" target=\"_blank\">", " NPM", "npx --yes copilotkit@latest onboard start", "npx copilotkit@latest skills install", "npx copilotkit@latest create", "npx create-ag-ui-app my-agent-app"]}], "hardware": [], "products": [{"term": "LangChain", "rel": "mention", "lines": [42, 180], "note": "作为集成方/采纳方提及，非替代或竞品", "quotes": ["We are the company behind the **AG-UI Protocol** — adopted by Google, LangChain, AWS, Microsoft, Mastra, PydanticAI, and", "Connect agent workflows to user-facing apps, with deep partnerships and 1st-party integrations across the agentic stack—"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "34ec08ab1c98": {"fn": "microsoft/playwright-mcp", "sha": "34ec08ab1c98", "source": "readme", "identity": {"one_liner": "给 LLM 提供浏览器自动化能力的 MCP 服务器", "review": "基于 Playwright 的 Model Context Protocol 服务器，使 LLM 通过结构化无障碍快照与网页交互，无需截图或视觉模型。README 逐项给出 Amp、Claude Code、Codex、Cursor、Gemini CLI、Goose、VS Code、Windsurf 等约 20 种 MCP 客户端的接入配置。要求 Node.js 18 及以上，通过 npx 运行 @playwright/mcp。提供约 30 个配置参数，涵盖浏览器选择、CDP 连接、代码生成、移动设备模拟、无头模式、文件访问限制等。另提及面向编码代理的 CLI+SKILLS 替代路径。", "highlights": ["基于无障碍树的结构化交互，不依赖视觉模型", "提供 20 余种 MCP 客户端的逐步接入配置", "约 30 个配置参数：CDP 端点、设备模拟、headless、文件访问控制等", "支持 vision/pdf/devtools 附加能力（--caps）"], "use_cases": ["让 Claude Code、Cursor 等客户端通过 MCP 操控浏览器", "搭建长期自主工作流中保持浏览器上下文的自动化", "为自愈测试或探索性自动化提供页面结构推理能力"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["MCP", "浏览器自动化", "LLM工具接入", "测试"], "domain": "LLM 基础设施/浏览器自动化", "alternative_to": [], "com