ines": [39], "note": "archive 分支标注 V1 API 服务器已退役"}, "note": ""}}, "0ef3064a1bcf": {"fn": "liguodongiot/llm-action", "sha": "0ef3064a1bcf", "source": "readme", "identity": {"one_liner": "大模型工程化与实践教程合集：覆盖训练、推理、压缩、评测", "review": "以文章目录形式组织的大模型工程化知识库，内容按 LLM 训练、推理、压缩、测评、数据工程、提示工程、算法架构、应用开发等章节编排。训练部分汇总从 6B 到 65B、覆盖全量微调与 LoRA/QLoRA/P-Tuning v2 等高效微调及 RLHF 的实战教程；推理部分列出 vLLM、SGLang、TensorRT-LLM 等引擎与优化技术文章；另含分布式训练并行技术系列与量化/剪枝/蒸馏原理讲解。各条目多为外链教程，部分附带配套代码。", "highlights": ["覆盖 6B–65B 模型的全量微调、LoRA/QLoRA/P-Tuning v2 与 RLHF 实战教程", "九篇分布式训练并行技术系列（数据/流水线/张量/序列/自动并行等）", "推理引擎汇总：vLLM、SGLang、TensorRT-LLM、LMDeploy 及轻量实现", "量化（GPTQ/AWQ/SmoothQuant 等）、剪枝、知识蒸馏原理系列文章"], "use_cases": ["查找 LoRA/QLoRA 等高效微调方法的实战教程和配套代码", "学习分布式训练并行技术的原理讲解", "对比选择大模型推理引擎和推理性能压测工具", "了解模型量化与压缩技术的原理系列文章"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["LLM训练", "LLM推理", "模型压缩/量化", "技术教程合集", "LLMOps"], "domain": "大模型工程化/知识聚合", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["全中文 README", "百川智能、ChatGLM 等中文模型技术剖析条目"]}, "trust": {"confidence": "mid", "evidence": ["L6: ## LLM训练", "L120: ## LLM推理", "L182: ## LLM压缩"], "xcheck": {"install_missing": ["docker"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "vllm", "rel": "mention", "lines": [135, 140, 320], "quotes": ["- Nano-vLLM源码注释：从头开始构建的轻量级 vLLM 实现。", "- vLLM", "- GuideLLM：vLLM开源的性能测试工具"]}, {"term": "deepseek", "rel": "mention", "lines": [380, 385, 399, 400], "quotes": ["- 大模型算法架构：DeepSeek技术演进及剖析", "- DeepSeek 视觉语言大模型技术演进（从DeepSeek VL/VL2到DeepSeek OCR）", "|DeepSeek-V4-Pro|1.6T|49B|~3.1%|384 选 6 + 1 共享|CSA + HCA|", "|DeepSeek-V4-Flash|284B|13B|-|-|-|"]}, {"term": "llama.cpp", "rel": "mention", "lines": [510], "quotes": ["- 一文搞懂大模型文件存储格式新宠GGUF"]}], "install": [{"term": "docker", "rel": "mention", "lines": [549], "quotes": ["- Docker Dockerfile 指令大全"]}], "hardware": [{"term": "48G显存", "rel": "mention", "lines": [23], "note": "教程中 LLaMA-65B QLoRA 微调所需显存描述，非本仓库自身要求", "quotes": ["|LLaMA|QLoRA|7B/65B|高效微调技术QLoRA实战，基于LLaMA-65B微调仅需48G显存，真香|配套代码|"]}], "products": [{"term": "Hugging Face", "rel": "mention", "lines": [46, 50, 51, 52, 53], "quotes": ["下面给大家分享**大模型参数高效微调技术实战**，该系列主要针对 HuggingFace PEFT 框架支持的一些高效微调技术进行讲解。", "|大模型参数高效微调技术实战（一）-PEFT概述及环境搭建|N/A|HuggingFace PEFT|", "|大模型参数高效微调技术实战（二）-Prompt Tuning|配套代码|HuggingFace PEFT|", "|大模型参数高效微调技术实战（三）-P-Tuning|配套代码|HuggingFace PEFT|", "|大模型参数高效微调技术实战（四）-Prefix Tuning / P-Tuning v2|配套代码|HuggingFace PEFT|"]}, {"term": "通义千问", "rel": "mention", "lines": [381, 441, 442], "quotes": ["- 大模型算法架构：QWen技术演进及剖析", "- 大模型国产化适配8-基于昇腾MindIE推理工具部署Qwen-72B实战（推理引擎、推理服务化）", " - Qwen-72B、Baichuan2-7B、ChatGLM3-6B"]}, {"term": "Kimi", "rel": "mention", "lines": [401, 402], "quotes": ["|Kimi K2.6|1T|32B|-|-|-|", "|Kimi K3|2.8T|104B|~3.7%|896 选 16 + 2 共享|69 KDA + 24 Gated MLA，3:1|"]}, {"term": "LangChain", "rel": "mention", "lines": [408], "quotes": ["大模型是基座，要想让其变成一款产品，我们还需要一些其他相关的技术，比如：向量数据库（Pinecone、Milvus、Vespa、Weaviate），LangChain等。"]}, {"term": "ChatGPT", "rel": "mention", "lines": [430, 505, 569], "quotes": ["随着 ChatGPT 的现象级走红，引领了AI大模型时代的变革，从而导致 AI 算力日益紧缺。与此同时，中美贸易战以及美国对华进行AI芯片相关的制裁导致 AI 算力的国产化适配势在必行。本系列将对一些国产化 AI 加速卡进行讲解。", "- ChatGLM 和 ChatGPT 的技术区别在哪里？", "如今人工智能的发展可谓是如火如荼，ChatGPT、Sora、文心一言等AI大模型如雨后春笋般纷纷涌现。AI大模型优势在于它能处理复杂性问题；因此，越来越多的企业需要具备**AI算法设计、AI应用开发、模型推理加速及模型压缩**等AI工程化落"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "dd569bae4a08": {"fn": "activepieces/activepieces", "sha": "dd569bae4a08", "source": "readme", "identity": {"one_liner": "开源 AI 工作流自动化平台：为 AI 代理提供 MCP 工具集", "review": "Activepieces 是用 TypeScript 编写的可扩展自动化平台，通过类型安全的 pieces 框架提供 200+ 集成（如 Google Sheets、Discord、RSS），覆盖循环、分支、重试、HTTP、代码块等构建器功能，并提供无代码构建器供非技术用户使用。所有 pieces 自动可作为 MCP server 供 LLM 客户端调用；内置原生 AI pieces 与 AI SDK 用于创建 agent 和构建流程，支持人工审批、延迟执行、聊天/表单人工输入触发。社区版 MIT 许可，企业功能采用商业许可。", "highlights": ["280+ pieces 自动作为 MCP servers，供 Claude Desktop、Cursor、Windsurf 等 LLM 客户端使用", "原生 AI pieces 与 AI SDK，可在构建器内创建 agent", "TypeScript pieces 框架，npm 包形式发布，支持本地开发热重载", "支持人工审批、延迟执行与聊天/表单人工输入触发"], "use_cases": ["用无代码构建器搭建跨 200+ 服务的自动化工作流", "为 AI 代理（如 Claude Desktop、Cursor）提供 280+ MCP 工具", "构建需要人工审批环节的企业自动化流程", "自托管、断网环境下的内部自动化平台"]}, "filters": {"ai_role": "ai-native", "license_risk": "dual", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "企业", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["工作流自动化", "MCP", "AI Agent", "无代码/低代码", "集成平台"], "domain": "自动化/集成平台", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L39: All-in-one AI automation designed to be **extensible** through a **type-safe** pieces framework written in **TypeScript*", "L48: - **🛠️ Largest open source MCP toolkit**: All our pieces (280+) are available as MCP that you can use with LLMs on Claud", "L52: - **🤖 AI-First**: Native AI pieces let you experiment with various providers, or create your own agents using our AI SDK"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [40, 48], "note": "作为可使用 MCP 的 LLM 客户端（Claude Desktop）被提及，非模型接入适配", "quotes": ["When you contribute pieces to Activepieces they become automatically available as MCP servers that you can use with LLMs", "- **🛠️ Largest open source MCP toolki