el": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L7:  Low-level orchestration framework for building stateful agents.", "L14: Trusted by companies shaping the future of agents – including Klarna, Replit, Elastic, and more – LangGraph is a low-lev", "L68: LangGraph is inspired by Pregel and Apache Beam. The public interface draws inspiration from NetworkX. LangGraph is buil"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [9, 10, 17], "quotes": [" PyPI - License", " PyPI - Downloads", "pip install -U langgraph"]}], "hardware": [], "products": [{"term": "LangChain", "rel": "mention", "lines": [40, 45, 68], "note": "同一公司生态内配合使用的库，README 未表述为替代或竞品关系", "quotes": ["While LangGraph can be used standalone, it also integrates seamlessly with any LangChain product, giving developers a fu", "- LangChain – Provides integrations and composable components to streamline LLM application development.", "LangGraph is inspired by Pregel and Apache Beam. The public interface draws inspiration from NetworkX. LangGraph is buil"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "0b10b97597a6": {"fn": "deepspeedai/DeepSpeed", "sha": "0b10b97597a6", "source": "readme", "identity": {"one_liner": "面向大模型训练与推理的分布式优化库", "review": "DeepSpeed 是一个深度学习优化库，提供分布式训练与推理能力，核心机制包括 ZeRO、ZeRO-Infinity、3D 并行、Ulysses 序列并行、DeepSpeed-MoE 等。支持 NVIDIA（Pascal 至 Hopper）、AMD MI100/MI200，并有华为昇腾 NPU、Intel Gaudi 2/Xeon/XPU、Tecorigin SDAA 等社区贡献的硬件适配。通过 pip 安装，C++/CUDA 扩展默认以 JIT 方式在运行时构建；Windows 支持部分训练与推理功能。曾用于训练 MT-530B、BLOOM 等大模型。", "highlights": ["ZeRO/ZeRO-Infinity、3D 并行、Ulysses 序列并行、DeepSpeed-MoE 等系统机制", "多硬件后端：NVIDIA/AMD/CPU/Gaudi2/XPU/昇腾 NPU/SDAA", "与 Transformers、Accelerate、Lightning、MosaicML、Determined、MMEngine 等框架集成", "pip 安装 + torch JIT 编译扩展，ds_report 校验环境"], "use_cases": ["训练数百亿到万亿参数规模的大模型", "分布式训练/推理的显存与通信优化", "在 AMD、昇腾、Gaudi 等多类加速器上运行训练任务"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "high", "maturity": "research"}, "eval": {"target_user": "开发者", "paper_url": "https://arxiv.org/abs/1910.02054", "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["深度学习训练", "分布式训练", "模型推理优化", "大模型"], "domain": "机器学习基础设施", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["README 提供简体中文版本(L11)", "中文知乎频道(L8)"]}, "trust": {"confidence": "high", "evidence": ["L52: # Extreme Speed and Scale for DL Training", "L54: ***DeepSpeed enabled the world's most powerful language models (at the time of this writing) such as MT-530B and BLOOM**", "L100: # Installation", "L110: ## Requirements"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [102, 129, 130, 133, 144], "quotes": ["The quickest way to get started with DeepSpeed is via pip, this will install", "## PyPI", "We regularly push releases to PyPI and encourage users to install from there in most cases.", "pip install deepspeed", "of JIT compiling) or install pre-compiled ops via PyPI please see our [advanced"]}], "hardware": [], "products": [{"term": "ChatGPT", "rel": "none", "lines": [], "quotes": []}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "d784a97ad617": {"fn": "agno-agi/agno", "sha": "d784a97ad617", "source": "readme", "identity": {"one_liner": "供开发者构建、运行并管理 agent 平台的框架与运行时", "review": "Agno 提供 SDK 与 AgentOS 运行时：用 SDK 构建 agent，作为服务运行（REST API、SSE、websockets），并通过 Web UI 管理平台。数据与链路存于自有 Postgres 数据库，内置 JWT RBAC、多租户隔离、人工审批、OpenTelemetry 可观测性与定时任务。上手路径是把提示词交给编码 agent（Claude Code、Cursor 等）从模板仓库部署，也支持手写代码；模板覆盖 Railway、Docker、AWS、GCP、Azure 等部署目标。每轮 agent 运行发送遥测事件，可用 AGNO_TELEMETRY=false 关闭。", "highlights": ["SDK 构建 + AgentOS 运行时 + Web UI 管理的组合", "50+ 端点的生产 API，支持 SSE 与 websockets", "JWT RBAC 与多用户多租户隔离", "100+ 预置工具集成（GitHub、Slack、Postgres 等）"], "use_cases": ["为自家产品搭建自托管的 agent 服务平台", "用自有数据库存储会话、记忆与 traces", "通过 Slack、Telegram、WhatsApp、Discord 等接口暴露 agent", "在任意支持容器的云平台部署 agent 平台"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["agent框架", "agent平台", "开发者工具", "部署/运行时"], "domain": "LLM 基础设施/agent 开发框架", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L11: Agno is a framework and runtime for agent platforms. Build agents, run them as a service, manage your platform using a w", "L13: - Build your agent platform using the Agno SDK.", "L14: - Run your agent platform using the AgentOS runtime."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [23], "note": "Claude Code 作为可用的编码 agent 被提及，非模型接入适配", "quotes": ["Hand this prompt to your coding agent (Claude Code, Cursor, Codex):"]}], "install": [], "hardware": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}, "products": [{"term": "Claude Code", "rel": "mention", "lines": [23], "quotes": ["Hand this prompt to your coding agent (Claude Code, Cursor, Codex):"]}, {"term": "Cursor", "rel": "mention", "lines": [23, 60], "quotes": ["Hand this prompt to your coding agent (Claude Code, Cursor, Codex):", "2. Add Agno docs as an indexed source. In Cursor: Settings → Indexing & Docs → Add `https://docs.agno.com/llms-full.txt`"]}, {"term": "Windsurf", "rel": "mention", "lines": [60], "quotes": ["2. Add Agno docs as an indexed source. In Cursor: Settings → Indexing & Docs → Add `https://docs.agno.com/llms-full.txt`"]}]}}, "8e8cee749f13": {"fn": "tinyhumansai/openhuman", "sha": "8e8cee749f13", "source": "readme", "identity": {"one_liner": "Rust 编写的 agent 运行时：单机运行数百个 agent 的桌面应用与库", "review": "以 GPL-3.0 发布的 agent harness，编译为单进程 Rust 核心，同时提供桌面应用（macOS/Windows/Linux 安装包）与 Rust 库两种形态。内置记忆（每轮按 token 预算召回并附引用）、Jev 工具搜索模型（在 1,215 个工具中选取）、浏览器与桌面控制、MCP 与技能、14 个消息渠道及 Composio 的 119 个 OAuth 集成。模型经 BYOK 接入 26 个 provider，本地模型支持 Ollama、LM Studio、MLX，含自动模型路由。当前为 early beta。README 中列出与六个其他 harness 的公开基准数据，复现材料在 openhuman-benchmarks 仓库。", "highlights": ["桌面应用与 Rust 库双形态，单进程可并行运行数百个 agent（README 称 500 个可放于 $10 VPS）", "RLM token 压缩：大型工具结果压缩为可检索句柄后再交给模型", "Jev 小模型做工具搜索，无截图地从屏幕按钮选取点击", "14 个消息渠道（Telegram/Discord/iMessage/邮件等）作为 agent 前端"], "use_cases": ["在单个低成本服务器上为每个客户运行一个 agent 的产品化部署", "通过桌面/终端与 agent 交互，让其操作浏览器和本地应用", "在 Rust 项目中以函数调用方式嵌入 agent 能力"]}, "filters": {"ai_role": "ai-native", "license_risk": "viral", "deploy": "desktop", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": true, "lines": [6, 38]}}, "links": {"scenario_tags": ["agent框架", "多agent编排", "桌面应用", "MCP", "本地优先"], "domain": "LLM 基础设施/Agent 运行时", "alternative_to": [], "competitors_mentioned": ["Claude Code"], "ecosystem_compat": ["ollama"]}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["README 含简体中文等多语言版本（L33），主体为英文"]}, "trust": {"confidence": "high", "evidence": ["L4:  A desktop app for people. A Rust library for developers.", "L84:  Use it as a Rust library: call an agent like any