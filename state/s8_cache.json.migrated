ch", "`pip install speech-to-speech` (see the Quickstart) includes everything the default pipeline needs:"]}, {"term": "source", "rel": "support", "lines": [143, 145], "quotes": ["git clone https://github.com/huggingface/speech-to-speech.git", "uv sync --python 3.11"]}, {"term": "docker", "rel": "support", "lines": [248], "quotes": ["docker compose up"]}, {"term": "brew", "rel": "none", "lines": [], "quotes": []}], "hardware": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": true, "lines": [134, 226]}, "products": [{"term": "Hugging Face", "rel": "mention", "lines": [76, 112, 117], "quotes": ["Every stage has multiple interchangeable backends, selected via CLI flags. The code is designed for easy modification, w", "On Linux, the Qwen3-TTS GGML backend comes from `faster-qwen3-tts[ggml]`. Its default `qwentts-cpp-python` wheel on PyPI", "  -f https://huggingface.co/datasets/andito/qwentts-cpp-python-wheels/tree/main/whl/cu130"]}, {"term": "通义千问", "rel": "none", "lines": [], "quotes": []}]}}, "e483e2f8599e": {"fn": "doocs/md", "sha": "e483e2f8599e", "source": "readme", "identity": {"one_liner": "给公众号创作者的微信 Markdown 排版编辑器", "review": "将 Markdown 即时渲染为微信图文的编辑器，减少公众号排版调整工作。功能覆盖标准 Markdown、KaTeX 数学公式、Mermaid/PlantUML 图表、代码高亮主题、本地草稿管理与内容导出导入；支持 13 类图床上传（GitHub、阿里云、腾讯云、S3 协议等）；集成 DeepSeek、OpenAI、通义千问等模型辅助内容创作。在线版可直接使用，另提供 npm CLI 与 Docker 私有化部署方式。", "highlights": ["Markdown 即时渲染为微信图文，支持 KaTeX、Mermaid、PlantUML、Ruby 注音", "13 种图床上传选项（GitHub、阿里云、腾讯云、MinIO、S3、Cloudflare R2 等）", "集成 DeepSeek、OpenAI、通义千问、腾讯混元、火山方舟等模型辅助创作", "提供在线版、npm CLI、Docker 三种使用与部署方式"], "use_cases": ["为微信公众号文章做 Markdown 排版与样式转换", "写公众号时把图片上传到多种图床并生成外链", "私有化部署一套自己的 Markdown 图文编辑器", "借助 AI 模型辅助内容创作"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "viral", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "消费者", "paper_url": null, "demo_url": "https://md.doocs.org", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["Markdown编辑器", "微信公众号", "图床上传", "内容创作", "AI辅助写作"], "domain": "内容创作/编辑器工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": true, "zh_origin_signals": ["全中文 README", "支持阿里云/腾讯云/七牛云/又拍云等国内云图床", "集成通义千问、腾讯混元、火山方舟等国内模型"]}, "trust": {"confidence": "high", "evidence": ["L11: **Markdown 文档自动即时渲染为微信图文**，让你不再为公众号排版发愁。只需掌握基本的 Markdown 语法，即可生成样式简洁、美观大方的微信图文。", "L37: - 集成主流 AI 模型（DeepSeek、OpenAI、通义千问、腾讯混元、火山方舟、302.AI 等），辅助内容创作", "L96: docker run -d -p 8080:80 doocs/md:latest"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "deepseek", "rel": "mention", "lines": [37], "note": "README 提及集成该模型辅助内容创作，未见专门适配细节", "quotes": ["- 集成主流 AI 模型（DeepSeek、OpenAI、通义千问、腾讯混元、火山方舟、302.AI 等），辅助内容创作"]}], "install": [{"term": "npm", "rel": "support", "lines": [82], "quotes": ["npm i -g @doocs/md-cli"]}, {"term": "docker", "rel": "support", "lines": [96], "quotes": ["docker run -d -p 8080:80 doocs/md:latest"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "6cdcccb90bac": {"fn": "EverMind-AI/EverOS", "sha": "6cdcccb90bac", "source": "readme", "identity": {"one_liner": "给 AI agent 的本地优先可携带记忆层", "review": "Python 库与本地优先的 agent 记忆运行时：将对话、文件与 agent 轨迹存为可读 Markdown，配合本地 SQLite 与 LanceDB 索引实现检索与离线反思（合并片段、精炼画像与技能）。支持按 user_id/agent_id/app_id/project_id/session_id 正交检索，提供本地服务器与 /api/v2 端点；一个 OpenRouter key 即可运行核心流程，embedding/rerank 为可选配置；Office 文档解析需系统安装 LibreOffice。", "highlights": ["Markdown 为事实源，可用 Git 版本化并直接编辑，级联 watcher 同步索引", "本地三件套 Markdown+SQLite+LanceDB，无需 MongoDB/Elasticsearch/Redis", "分层配置：[llm] 基础流程，[embedding]/[rerank]/[multimodal] 逐步解锁混合检索、反思与多模态摄取", "提供 MCP Server（uvx everos-mcp）接入 Claude Code、Codex、Cursor 等编码助手"], "use_cases": ["为跨应用/跨会话的 AI agent 添加持久长期记忆", "给 Claude Code/Cursor 等编码助手接入自动保存与召回上下文", "本地自托管记忆服务，用 Markdown 文件管理与审计 agent 记忆", "构建需要跨会话自我演进的助手（学习、创意、个人助理等）"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": "locked-api", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["agent记忆", "长期记忆", "本地优先", "MCP", "agent基础设施"], "domain": "AI 基础设施/Agent 记忆", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["openrouter"]}, "intel": {"maintainer_type": "team", "zh_origin": true, "zh_origin_signals": ["README 提供中文版本链接（L8）", "微信社群（L6）"]}, "trust": {"confidence": "high", "evidence": ["L16: EverOS is a Python library and local-first memory runtime for agents and", "L19: trajectories as readable Markdown, then syncs local SQLite and LanceDB indexes", "L67: > One OpenRouter API key is enough to start EverOS, write durable memories,"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "deepseek", "rel": "mention", "lines": [59], "note": "DeepSeek Harness 为集成平台之一，非模型通道适配", "quotes": [" DeepSeek Harness DeepSeek Harness"]}, {"term": "openrouter", "rel": "support", "lines": [67, 73, 113, 114], "note": "默认 LLM 通道，官方配置即为 OpenRouter", "quotes": ["> One OpenRouter API key is enough to start EverOS, write durable memories,", "- One OpenRouter API key", "api_key = \"<OPENROUTER_API_KEY>\"", "base_url = \"https://openrouter.ai/api/v1\""]}, {"term": "anthropic", "rel": "mention", "lines": [274, 282, 446], "note": "提及 Claude Code/Claude Desktop 作为可接入对象，非 Anthropic 模型适配", "quotes": ["Browser-native hive-mind for CLI coding agents - Claude Code, Codex, Gemini, and OpenCode collaborate as real PTY proces", "Plug EverOS memory into Claude Code, Codex, Claude Desktop or Cursor with `uvx everos-mcp`. Works with EverOS Cloud and ", "#### Claude Code Plugin"]}], "install": [{"term": "pypi", "rel": "support", "lines": [78, 79, 214], "quotes": ["uv pip install everos", "# or: pip install everos", "uv pip install 'everos[multimodal]'   # or: pip install 'everos[multimodal]'"]}, {"term": "brew", "rel": "mention", "lines": [231], "note": "LibreOffice 系统依赖的安装方式，非本产品安装", "quotes": ["brew install --cask libreoffice              # macOS"]}, {"term": "source", "rel": "support", "lines": [238, 240], "quotes": ["git clone https://github.com/EverMind-AI/EverOS.git", "uv sync                              # creates ./.venv and installs deps"]}], "hardware": [], "products": [{"term": "Hugging Face", "rel": "mention", "lines": [4], "quotes": [" HuggingFace"]}, {"term": "Dify", "rel": "mention", "lines": [63], "note": "生态集成平台之一", "quotes": [" Dify Dify"]}, {"term": "Claude Code", "rel": "mention", "lines": [282, 446, 448], "note": "可接入的产品对象，非替代/竞品", "quotes": ["Plug EverOS memory into Claude Code, Codex, Claude Desktop or Cursor with `uvx everos-mcp`. Works with EverOS Cloud and ", "#### Claude Code Plugin", "Persistent memory for Claude Code. Automatically saves and recalls context from past coding sessions."]}, {"term": "Cursor", "rel": "mention", "lines": [282], "quotes": ["Plug EverOS memory into Claude Code, Codex, Claude Desktop or Cursor with `uvx everos-mcp`. Works with EverOS Cloud and "]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": true, "lines": [414, 416], "note": "Legacy OpenClaw Agent Memory 为 pre-1.0.0 存档插件，新集成应使用当前 API"}}}, "e37c2d12ba2a": {"fn": "JCodesMore/ai-website-cloner-template", "sha": "e37c2d12ba2a", "source": "readme", "identity": {"one_liner": "给 AI 编码代理的模板：一条命令把网站复刻为 Next.js 应用", "review": "一个 Next.js 模板项目，核心是一个可移植的 Agent Skill（/clone-website）：用户给 AI 编码代理一个 URL，代理按 Map→Observe→Build→Compare 四步将目标网站复刻为可编辑的 Next.js 应用，产出路由映射、运行说明与对比截图。要求 Node.js 24+ 与具备浏览器访问能力的 AI 编码代理；Framer 页面与动效站点有专门的检查指引。README 明确声明不用于钓鱼、冒充或违反目标站点服务条款的场景。", "highlights": ["/clone-website 技能按四步流程复刻网站为 Next.js 应用", "同一技能文件供 Codex、Cursor、OpenCode 直接读取，Claude Code 经命令桥接使用", "复刻产出含路由映射、运行说明、对比截图与差距清单", "对 Framer 页面与动效站点提供专门检查指引"], "use_cases": ["把自有的 WordPress/Webflow/Squarespace 站点迁移到 Next.js 代码库", "源码丢失但站点仍在线时找回可用的现代格式代码", "通过真实站点代码学习其布局、动画与响应式实现"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "YouTube demo 链接（L19/L21 指向）", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["网站复刻", "AI编码代理", "Next.js模板", "逆向工程"], "domain": "开发者工具/AI 辅助开发", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L5: Give your AI coding agent a URL and watch it recreate the website as a clean Next.js app.", "L57: |Claude Code|**Recommended** — Opus 5.5|", "L125: The project keeps one portable Agent Skill at `.agents/skills/clone-website/`. Codex, Cursor, and OpenCode read it direc"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [7, 57], "note": "提及 Claude Code 搭配 Opus 模型，非接入其 API", "quotes": ["**Best results with Claude Code + Opus 5.5. Also supports Codex, Cursor, and OpenCode.**", "|Claude Code|**Recommended** — Opus 5.5|"]}], "install": [{"term": "docker", "rel": "support", "lines": [119, 120], "note": "提供 docker compose 运行方式", "quotes": ["docker compose up app --build # build and run the app", "docker compose up dev --build # run the app in dev mode on port 3001"]}], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [7, 27, 45, 57, 125], "note": "受支持的编码代理之一，非替代/竞品对象", "quotes": ["**Best results with Claude Code + Opus 5.5. Also supports Codex, Cursor, and OpenCode.**", "**Recommended: ask your agent.** Paste this into Codex, Claude Code, or your coding agent:", "Open the project in your agent with browser access enabled. In Claude Code or Cursor, run:", "|Claude Code|**Recommended** — Opus 5.5|", "The project keeps one portable Agent Skill at `.agents/skills/clone-website/`. Codex, Cursor, and OpenCode read it direc"]}, {"term": "Cursor", "rel": "mention", "lines": [7, 45, 60, 125], "note": "受支持的编码代理之一", "quotes": ["**Best results with Claude Code + Opus 5.5. Also supports Codex, Cursor, and OpenCode.**", "Open the project in your agent with browser access enabled. In Claude Code or Cursor, run:", "|Cursor|Supported|", "The project keeps one portable Agent Skill at `.agents/skills/clone-website/`. Codex, Cursor, and OpenCode read it direc"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "30b92eac4816": {"fn": "LibreChat-AI/LibreChat", "sha": "30b92eac4816", "source": "readme", "identity": {"one_liner": "自托管多模型 AI 聊天平台：统一接入多家服务商", "review": "自托管的 AI 对话平台，将多家模型服务商统一在一个界面中，支持自定义端点（任何 OpenAI 兼容 API）。提供 Agent 构建与市场、MCP 工具接入、SKILL.md 技能包、代码解释器沙箱（Python/Node.js/Go 等多语言）、联网搜索、图像生成、Artifacts、语音输入输出、消息搜索与导入导出。多用户场景支持 OAuth2/LDAP/邮箱登录、管理面板与按角色权限配置，可单机或配合 Redis 水平扩展部署，提供 Docker Compose 一键部署栈。", "highlights": ["统一界面接入多家模型服务商，支持任意 OpenAI 兼容自定义端点", "Agent 体系：无代码构建、市场分享、子代理、MCP 与 SKILL.md 技能", "沙箱化代码解释器支持 Python、Node.js、Go、C/C++ 等语言", "多用户安全认证（OAuth2/LDAP）、管理面板与 Token 用量工具"], "use_cases": ["自建一个统一管理多家模型接口的私有聊天界面", "为团队部署带用户权限与用量统计的多用户 AI 助手", "通过 MCP 和 Agent 给 AI 接入自定义工具与文件搜索", "导入既有 ChatGPT 对话记录做统一管理"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "desktop", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["聊天界面", "多模型接入", "自托管", "AI Agen