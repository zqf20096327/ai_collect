igh", "evidence": ["L6: * Serena provides essential **semantic code retrieval, editing, refactoring and debugging tools** that are akin to an ID", "L58: Serena can extend the functionality of your existing AI client via the **model context protocol (MCP)**.", "L95: When using Serena's language server backend, we provide **support for over 40 programming languages**, including"], "xcheck": {"license_from_readme": "GPL-3.0"}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [60, 62], "note": "Claude Code/Claude Desktop 作为可接入的 MCP 客户端被提及，非专门适配通道", "quotes": ["* terminal-based clients like Claude Code, Codex, OpenCode, or Gemini-CLI,", "* desktop and web clients like Claude Desktop, Codex App, or OpenWebUI."]}], "install": [], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [34, 60, 167, 226], "note": "评测与客户端配置示例中提及，非替代/竞品", "quotes": ["**Opus 4.6 (high) in Claude Code on a large Python codebase:**", "* terminal-based clients like Claude Code, Codex, OpenCode, or Gemini-CLI,", "When Serena is used inside an agentic harness such as Claude Code or Codex, these tools are typically disabled by defaul", "Follow the link for specific instructions on how to set up Serena for Claude Code, Codex, Claude Desktop, MCP-enabled ID"]}, {"term": "GitHub Copilot", "rel": "mention", "lines": [42, 61], "note": "评测场景与 IDE 插件提及", "quotes": ["**GPT 5.4 (medium) in Copilot CLI on a large, multi-language monorepo:**", "* IDEs and IDE assistant plugins for VSCode, Cursor and JetBrains IDEs (Copilot, Junie, JetBrains AI Assistant, etc.),"]}, {"term": "Cursor", "rel": "mention", "lines": [61], "note": "支持的 IDE 列表中提及", "quotes": ["* IDEs and IDE assistant plugins for VSCode, Cursor and JetBrains IDEs (Copilot, Junie, JetBrains AI Assistant, etc.),"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "1077897fe034": {"fn": "jackwener/OpenCLI", "sha": "1077897fe034", "source": "readme", "identity": {"one_liner": "把任意网站变成 CLI 命令、供 AI agent 操作登录态浏览器的工具", "review": "OpenCLI 是面向 AI agent 的通用浏览器自动化 CLI，同时自称 agent-browser 的一款替代工具。它通过 Browser Bridge 扩展与本地守护进程连接用户已登录的 Chrome/Chromium，无需站点适配器即可导航、点击、填表、提取与截图；内置 Bilibili、知乎、Reddit、HackerNews 等站点适配器提供确定性命令。所有命令默认输出 JSON 并配退出码约定，便于 agent 消费。安装方式包括 macOS/Windows 桌面应用 OpenCLIApp 和 npm 全局安装（需 Node.js ≥ 20.18.1），并通过 npx skills 向 Claude Code、Cursor 等 agent 安装四个技能。", "highlights": ["内置 Bilibili、知乎、小红书、Reddit 等站点适配器，提供确定性 CLI 命令", "命令默认 JSON 输出（ok/data/error 结构）并配非零退出码约定", "四个可安装技能：opencli-browser、adapter-author、autofix、usage", "支持多 Chrome profile 别名管理与 --session 页面会话路由"], "use_cases": ["让 AI agent 借用我的登录态浏览器抓取页面或填写表单", "为无 API 的网站编写可复用的命令行适配器", "在 CI/服务器环境用 npm 安装 CLI 做确定性网页自动化"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "desktop", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["浏览器自动化", "CLI工具", "AI agent 技能", "网页抓取"], "domain": "开发者工具/浏览器自动化", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["内置 Bilibili、知乎、小红书、微博适配器", "提供中文文档入口"]}, "trust": {"confidence": "high", "evidence": ["L12: OpenCLI is a **general-purpose browser automation CLI for AI agents** and an **agent-browser alternative**. Navigate, in", "L17: - **Let AI Agents operate any website** — install the `opencli-browser` skill in your AI agent (Claude Code, Cursor, etc", "L60: npm install -g @jackwener/opencli"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [17, 148], "note": "通过 Claude Code 间接涉及，README 未直接提及 