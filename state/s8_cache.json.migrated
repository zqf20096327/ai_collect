I"]}], "hardware": [], "products": [], "dual_license": {"flag": true, "lines": [32, 33, 34, 35], "quotes": ["- NLTK source code is distributed under the Apache 2.0 License.", "- NLTK documentation is distributed under the Creative Commons", " Attribution-Noncommercial-No Derivative Works 3.0 United States license.", "- NLTK corpora are provided under the terms given in the README file for each"]}, "deprecation": {"flag": false, "lines": []}}}, "6493008e6f17": {"fn": "casdoor/casdoor", "sha": "6493008e6f17", "source": "readme", "identity": {"one_liner": "为应用与 AI agent 提供自托管 SSO/IAM 的认证服务器", "review": "自托管的单点登录与身份认证服务器，带 Web 管理控制台。支持 OAuth 2.0、OIDC、SAML 2.0、CAS、LDAP、SCIM 2.0、WebAuthn、TOTP/MFA、Face ID 等协议，并可对接 Google Workspace、Entra ID、GitHub 等身份提供方。组织、应用、登录方式等均在控制台配置，无需改动配置文件重新部署；授权策略基于 Casbin（ACL/RBAC/ABAC）。AI 相关部分包括 MCP 网关与 A2A 通信支持。提供 Docker、Docker Compose、Helm、源码四种安装路径及商业托管版 Casdoor Cloud。", "highlights": ["多协议认证：OAuth 2.0/OIDC、SAML 2.0、CAS、LDAP、SCIM 2.0、WebAuthn、TOTP/MFA、Face ID", "MCP 网关：暴露 Model Context Protocol 服务器并控制访问，另支持 A2A 通信", "Casbin 策略授权（ACL/RBAC/ABAC）与多租户组织管理", "四种安装路径：Docker all-in-one、Docker Compose+MySQL、Helm、源码构建"], "use_cases": ["为多个新旧应用统一接入单点登录", "为 AI agent 的 MCP 服务器做访问控制", "企业内对接 Google/GitHub/Entra ID 等登录方式", "以 Git 文件或 Terraform 管理组织、用户与权限配置"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://demo.casdoor.com", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["IAM/SSO", "认证服务器", "MCP网关", "自托管", "Web控制台"], "domain": "身份认证与访问管理", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L7:  Casdoor is a single sign-on (SSO) and authentication server with a web console.", "L225: - **MCP gateway** — expose Model Context Protocol servers and control access to them", "L226: - **A2A** — agent-to-agent communication support"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "docker", "rel": "support", "lines": [64, 107, 110, 119], "quotes": ["docker run -p 8000:8000 casbin/casdoor-all-in-one", "### Docker — all-in-one (evaluation)", "docker run -p 8000:8000 casbin/casdoor-all-in-one", "`docker-compose.yml` starts Casdoor next to a MySQL 8 container."]}, {"term": "helm", "rel": "support", "lines": [144, 149], "quotes": ["### Kubernetes — Helm", "helm install casdoor oci://ghcr.io/casdoor/helm-charts/casdoor"]}, {"term": "source", "rel": "support", "lines": [173, 178], "quotes": ["### From source — for development", "git clone https://github.com/casdoor/casdoor.git"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "0e3af236d0b8": {"fn": "gunthercox/ChatterBot", "sha": "0e3af236d0b8", "source": "readme", "identity": {"one_liner": "面向开发者的 Python 机器学习对话引擎，用于创建聊天机器人", "review": "基于机器学习的对话引擎 Python 库：从已知对话集合中生成回复，输入语句会被保存并与对应回复关联，随输入增多可回复的数量与准确度提升；通过搜索最匹配的已知语句、按回复出现频率选出最可能的回应。语言无关设计，可训练为任意语言，内置十余种语言的训练数据模块（chatterbot-corpus），社区欢迎提交语料。通过 PyPI 安装，BSD 3-clause 许可。", "highlights": ["从已知对话集合生成匹配回复，随输入累积提升准确度", "语言无关设计，可训练为任意语言", "内置十余种语言的训练数据模块", "提供 ChatterBotCorpusTrainer 训练接口"], "use_cases": ["为应用接入基于已知对话语料的自动回复机器人", "用自有语料训练特定语言的对话机器人", "向 chatterbot-corpus 贡献多语言训练数据"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["聊天机器人", "对话引擎", "机器学习", "NLP"], "domain": "对话系统/NLP", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L5: ChatterBot is a machine-learning based conversational dialog engine built in", "L25: An untrained instance of ChatterBot starts off with no knowledge of how to communicate. Each time a user enters a statem", "L81: ChatterBot is licensed under the BSD 3-clause license."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [34, 37], "quotes": ["This package can be installed from PyPi by running:", "pip install chatterbot"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "50eeea47084a": {"fn": "nidhinjs/prompt-master", "sha": "50eeea47084a", "source": "readme", "identity": {"one_liner": "给各 AI 工具写精准提示词的 Claude skill", "review": "以 Claude skill 形式分发的提示词生成器：对用户请求运行结构化流水线——检测目标工具、提取 9 维意图、最多 3 个澄清问题、自动路由到 13 个提示词模板之一、应用 5 种声明为安全的技术、做 token 效率审计后输出单个可复制提示词。内置 30+ 工具 profile，未收录的工具用 4 问 Universal Fingerprint 处理。明确排除 Tree of Thought 等易幻觉方法。面向使用多个 AI 工具的普通用户。", "highlights": ["覆盖推理、编码、图像、视频、语音、自动化等 30+ 工具的专用 profile", "13 个提示词模板自动选择并对用户隐藏框架名", "检测 37 种浪费额度的提示词模式并给出改写", "max 3 个澄清问题与 token 效率审计机制"], "use_cases": ["为 Claude Code / Cursor 等编码工具生成任务提示词", "为 Midjourney、Stable Diffusion 生成图像提示词", "把写坏的提示词拆解并改写成适配其他工具的版本"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": null, "model_dep": "locked-api", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "消费者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["提示词工程", "Claude skill", "生产力工具"], "domain": "提示词工程/生产力工具", "alternative_to": [], "competitors_mentioned": [], "ecosys