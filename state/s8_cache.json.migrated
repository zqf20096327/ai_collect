idual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L28: SurfSense is a free, open-source desktop app for documents you can't upload. A privacy-focused, NotebookLM-style AI agen", "L91: |Open source|No|**Apache-2.0**|", "L97: Apache-2.0. See LICENSE."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": true, "lines": [37], "note": "托管网页版将于 2026 年 10 月 18 日前停止服务，需导出迁移"}}}, "fa5958956746": {"fn": "huggingface/transformers.js", "sha": "fa5958956746", "source": "readme", "identity": {"one_liner": "Web 开发者在浏览器中运行 Transformer 预训练模型的 JS 库", "review": "Transformers.js 是 Hugging Face transformers Python 库在 JavaScript 上的功能等价实现，通过 ONNX Runtime 在浏览器内运行预训练模型，无需服务器。API 与 Python 版一致，提供 pipeline 接口；任务覆盖 NLP、计算机视觉、音频与多模态共数十种。模型默认通过 WASM 在 CPU 上运行，可设置 device: 'webgpu' 切换到 GPU；在浏览器等资源受限环境中可通过 dtype 选项选择 fp32/fp16/q8/q4 量化以降低带宽。经 NPM 安装，也可通过 CDN 直接引入。", "highlights": ["基于 ONNX Runtime 在浏览器运行预训练模型，无需服务器", "支持 NLP、视觉、音频、多模态等多类任务（含任务/架构支持清单）", "默认 WASM/CPU 运行，可配置 WebGPU", "支持 fp32/fp16/q8/q4 量化以适配资源受限环境"], "use_cases": ["在网页中做文本分类、问答、翻译等 NLP 推理", "浏览器端图像分类、目标检测与背景移除", "网页内语音识别与文字转语音", "将已有 PyTorch 模型经 Optimum 转为 ONNX 后在 Web 上运行"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["浏览器推理", "WebML", "JavaScript", "ONNX", "Transformer模型"], "domain": "机器学习/Web 端推理框架", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["