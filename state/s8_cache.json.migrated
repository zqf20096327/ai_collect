-ecosystem", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://puckeditor.com", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["低代码/无代码", "页面搭建", "React", "可视化编辑器"], "domain": "Web 开发工具/低代码", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L15: Puck is a modular, open-source visual editor for React.js. You can use Puck to build custom drag-and-drop experiences wi", "L17: Because Puck is just a React component, it plays well with all React.js environments, including Next.js. You own your da", "L19: Puck is also licensed under MIT, making it suitable for both internal systems and commercial applications."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "npm", "rel": "support", "lines": [26, 54], "quotes": ["npm i @puckeditor/core --save # or npx create-puck-app my-app", "npx create-puck-app my-app"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "257fc72c751d": {"fn": "huggingface/speech-to-speech", "sha": "257fc72c751d", "source": "readme", "identity": {"one_liner": "用开源模型在本机搭建低延迟语音对话 agent 的框架", "review": "以可插拔级联管道（Silero VAD → Parakeet TDT → Qwen3.5-4B → Qwen3-TTS）在本地运行语音对话，无 API key、无云端依赖；服务端实现 OpenAI Realtime 协议（WebSocket/WebRTC），为 OpenAI Realtime API 构建的应用可指向本机服务器。各阶段提供多种可替换后端，经 CLI 标志选择，支持工具调用、流式说话人分离与可视化口型输出；并作为 Reachy Mini 机器人的对话后端运行。", "highlights": ["四级级联管道（VAD/STT/LLM/TTS），每级均有多个可互换后端", "服务端实现 OpenAI Realtime 协议，兼容 OpenAI Realtime 客户端与 Agents SDK、LiveKit Agents", "默认本地模型，首次下载后可完全离线运行", "提供工具调用扩展与可选 viseme/说话人分离组件"], "us