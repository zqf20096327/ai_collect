red_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["AI编程", "提示词工程", "开发工作流", "教程/知识库"], "domain": "开发者工具/AI 编程方法论", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["全中文 README", "Telegram 中文交流群 glue_coding", "人民币语境的打赏地址与中文社区链接"]}, "trust": {"confidence": "high", "evidence": ["L3: **以Pi Agent与OpenAI GPT为主体底座，将既有Context、Skills和Extensions组合成可验证的工作流。**", "L46: - `vibe-coding-cn` 是Vibe Coding工具箱，主体底座为Pi Agent与OpenAI GPT；本次只整理已有资产，不增加业务Skill。", "L109: 一句话：Vibe Coding = **规划驱动 + 上下文固定 + AI 结对执行**，让「从想法到可维护代码」变成一条可审计的流水线，而不是一团无法迭代的巨石文件。"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": [96], "note": "原 Actions 定义移入 Extensions，自动 CI 流程已停用"}, "products": [{"term": "ChatGPT", "rel": "mention", "lines": [65], "note": "提示 ChatGPT 订阅不自动等同于 API 权限，仅提及", "quotes": ["1. 准备当前系统可用的Pi Agent及已授权OpenAI GPT模型，通过Pi原生模型选择配置；不把ChatGPT订阅自动等同于API权限，也不在仓内保存凭据。"]}]}}, "884449f4b35c": {"fn": "arc53/DocsGPT", "sha": "884449f4b35c", "source": "readme", "identity": {"one_liner": "面向企业与开发者的自托管文档问答与 AI Agent 平台", "review": "DocsGPT 将文档、网站与已连接的应用转为可引用出处的 AI Agent：支持可视化工作流编排、知识同步（Google Drive、SharePoint、Confluence、GitHub、S3 等）与 GraphRAG，每个回答附带来源引用。模型可任选云端（OpenAI、Anthropic、Groq 等）或本地（Ollama、vLLM），整个栈运行在用户自身环境内。提供一键安装脚本、`docsgpt` CLI 管理命令，另有 Docker Compose、pip、Kubernetes 及离线部署途径；MIT 许可，包含 SSO、团队与配额等团队功能。", "highlights": ["Agent 与深度研究模式：自定义提示、知识与工具，支持多步回答", "拖拽式可视化工作流：串联 Agent、条件与沙箱代码", "答案带来源引用，知识源可从多平台持续同步", "OpenAI 兼容 API、MCP server、网站 widget、Discord/Slack/Telegram 机器人与 CLI 多种接入方式"], "use_cases": ["在企业内网自建文档问答与知识检索系统", "把产品手册做成嵌入网站的客服 Agent", "需要数据不出本地环境的私有化 LLM 应用部署", "通过可视化工作流串联多个 Agent 处理业务流程"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive",