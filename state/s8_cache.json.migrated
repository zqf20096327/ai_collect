, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "消费者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["系统优化", "隐私", "debloat", "PowerShell 脚本", "Windows 11"], "domain": "系统工具/隐私", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L3: In Windows 11 22H2 Microsoft began adding AI features like Copilot and Recall. Since then, additional AI driven componen", "L65:  > Running the script with PowerShell 7 is no longer supported and it WILL cause issues, to avoid this ensure you are ru", "L70:  & ([scriptblock]::Create((irm \"https://raw.githubusercontent.com/zoicware/RemoveWindowsAI/main/RemoveWindowsAi.ps1\")))"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [{"term": "GitHub Copilot", "rel": "none", "lines": [9, 19, 20], "note": "误命中：指 Windows 系统内置 Copilot（含 Gaming Copilot、Office 内 Copilot），非 GitHub Copilot", "quotes": [" - Disable Copilot", " - Disable Gaming Copilot", " - Disable Copilot in All Office Apps"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "2fa0690c213b": {"fn": "NVIDIA/TensorRT", "sha": "2fa0690c213b", "source": "readme", "identity": {"one_liner": "面向开发者的 NVIDIA GPU 深度学习推理 SDK 开源组件仓库", "review": "本仓库包含 NVIDIA TensorRT 的开源组件（OSS）：TensorRT 插件、ONNX 解析器的源码，以及演示平台用法与能力的示例应用。这些开源组件是 TensorRT GA 发布版本的子集，含部分扩展与修复。仓库提供预编译 Python 包的 pip 安装途径，也可通过 Docker 构建容器或本机 CMake 从源码构建，支持 x86-64 与 aarch64（含 Jetson、DriveOS 交叉编译）目标。企业支持通过 NVIDIA AI Enterprise 提供。", "highlights": ["包含 TensorRT 插件与 ONNX 解析器源码及示例应用", "提供 pip install tensorrt 预编译 Python 包安装途径", "支持 Docker 构建容器与本机 CMake 源码构建，覆盖 x86-64/aarch64 与 Jetson、DriveOS、QNX 交叉编译", "提供与编码代理（coding agent）配合使用的 TensorRT 使用与基准测试技能"], "use_cases": ["为部署在 NVIDIA GPU 上的模型准备推理所需的插件与解析器组件", "参考官方示例应用了解 TensorRT 的使用方式", "为 Jetson 或 DriveOS 等 aarch64 平台交叉编译 TensorRT OSS 组件"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["深度学习推理", "GPU加速", "SDK", "模型部署"], "domain": "AI 基础设施/推理引擎", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L16: This repository contains the Open Source Software (OSS) components of NVIDIA TensorRT. It includes the sources for Tenso", "L34: We provide the TensorRT Python package for an easy installation. \\", "L56: - CUDA"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [38], "quotes": ["pip install tensorrt"]}, {"term": "source", "rel": "support", "lines": [95, 97, 177], "quotes": ["   git clone -b main https://github.com/nvidia/TensorRT TensorRT", "   git submodule update --init --recursive", "  cmake .. -DCMAKE_PREFIX_PATH=$TRT_ROOT \\"]}, {"term": "docker", "rel": "support", "lines": [128, 135, 159], "quotes": ["For Linux platforms, we recommend that you generate a docker container for building TensorRT OSS as described below. For", "   ./docker/build.sh --file docker/ubuntu-24.04.Dockerfile --tag tensorrt-ubuntu24.04-cuda13.4", "   ./docker/launch.sh --tag tensorrt-ubuntu24.04-cuda13.4 --gpus all"]}], "hardware": [], "products": [{"term": "Hugging Face", "rel": "mention", "lines": [18], "note": "作为导入路径之一被提及，非替代/竞品对象", "quotes": ["- For step-by-step walkthroughs of the TensorRT import paths (ONNX, Torch-TensorRT, HuggingFace/Optimum, Network Definit"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": true, "lines": [8, 9, 10, 11, 12]}}}, "46282335117d": {"fn": "cloudwego/eino", "sha": "46282335117d", "source": "readme", "identity": {"one_liner": "Go 语言的 LLM/AI 应用开发框架", "review": "Eino 是面向 Golang 的 LLM 应用开发框架，设计上参照 LangChain、Google ADK 等开源框架并遵循 Go 语言惯例。核心提供：可复用组件抽象（ChatModel、Tool、Retriever、ChatTemplate 等，官方实现含 OpenAI、Ollama 等）、Agent 开发工具包 ADK（工具调用、多 Agent 协作、人机协同的中断/恢复、编排为图与工作流）、全链路流式处理与回调切面（日志/追踪/指标注入）。框架由本仓库与 EinoExt、Eino Devops、EinoExamples 四部分组成，依赖 Go 1.18+，采用 Apache-2.0 许可。", "highlights": ["组件抽象带官方实现（OpenAI、Claude、Gemini、Ark、Ollama、Elasticsearch 等）", "ADK 支持工具调用、多 Agent 协作与人机协同的中断/恢复", "compose 将组件编排为图/工作流，可作为工具暴露给 Agent", "编排全程自动处理流式拼接、合并与复制"], "use_cases": ["用 Go 构建基于 LLM 的应用与 Agent 服务", "需要精确控制执行流程的领域工作流与 LLM 组合", "搭建需要人机协同审批、可从检查点恢复的 Agent 流程"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": null, "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["LLM框架", "Agent开发", "Go语言", "编排/工作流"], "domain": "LLM 应用开发框架", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["ollama", "anthropic"]}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["README 提供中文版本入口", "维护方为 Byte/CloudWeGo 生态（安全联系指向 Bytedance Security）"]}, "trust": {"confidence": "high", "evidence": ["L17: **Eino['aino]** is an LLM application development framework in Golang. It draws from LangChain, Google ADK, and other op", "L20: - **Components**: reusable building blocks like `ChatModel`, `Tool`, `Retriever`, and `ChatTemplate`, with official impl", "L21: - **Agent Development Kit (ADK)**: build AI agents with tool use, multi-agent coordination, context management, interrup"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "ollama", "rel": "support", "lines": [20, 94], "quotes": ["- **Components**: reusable building blocks like `ChatModel`, `Tool`, `Retriever`, and `ChatTemplate`, with official impl", "Eino defines component abstractions (ChatModel, Tool, Retriever, Embedding, etc.) with official implementations for Open"]}, {"term": "anthropic", "rel": "support", "lines": [94], "note": "README 以 Claude 名称列出官方实现", "quotes": ["Eino defines component abstractions (ChatModel, Tool, Retriever, Embedding, etc.) with official implementations for Open"]}], "install": [], "hardware": [], "products": [{"term": "LangChain", "rel": "mention", "lines": [17], "note": "设计参考的开源框架之一，未自称替代或竞品", "quotes": ["**Eino['aino]** is an LLM application development framework in Golang. It draws from LangChain, Google ADK, and other op"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "51e13754f074": {"fn": "YaoFANGUK/video-subtitle-remover", "sha": "51e13754f074", "source": "readme", "identity": {"one_liner": "给需要去除视频硬字幕/文本水印的用户，本地AI修复填充", "review": "基于AI的视频/图片硬字幕与文本水印去除工具：对字幕区域进行填充（非相邻像素填充），以无损分辨率输出去除后的文件。支持自定义字幕位置或全视频自动去除所有文本，支持图片批量去水印。内置 GUI 与 CLI 两种使用方式，去除算法含 STTN、LAMA、ProPainter 三种可配置模式，模型可通过 backend/tools/train 自行训练替换。本地运行，无需申请第三方 API。Windows 提供多个预构建包，也可源码安装。", "highlights": ["无损分辨率去除硬字幕/文本水印，本地运行无需第三方 API", "三种填充算法可选（STTN/LAMA/ProPainter），参数可调", "支持 CUDA、DirectML、CPU、macOS Apple Silicon 四种运行模式", "提供 GUI、CLI、Docker 三种使用方式"], "use_cases": ["去除视频中嵌入的硬字幕并保留原分辨率", "批量去除图片上的文本水印", "无 NVIDIA 显卡时用 DirectML 或 CPU 模式运行", "对去字幕效果不满意时自行训练替换模型"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "消费者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["视频处理", "字幕去除", "水印去除", "图像修复"], "domain": "视频/图像处理工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["全中文 README", "QQ群讨论"]}, "trust": {"confidence": "high", "evidence": ["L15: Video-subtitle-remover (VSR) 是一款基于AI技术，将视频中的硬字幕去除的软件。", "L115: 本项目支持 CUDA (NVIDIA显卡加速)、CPU (无 GPU)、 DirectML (AMD、Intel等GPU/APU加速) 和 macOS (Apple Silicon) 四种运行模式。", "L19: - 提取原视频字幕，可配合：video-subtitle-extractor (VSE)"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "docker", "rel": "support", "lines": [45, 48], "quotes": ["**Docker版本：**", "  docker run -it --name vsr --gpus all eritpchy/video-subtitle-remover:1.4.0-cuda11.8 python backend/main.py -i test/tes"]}, {"term": "brew", "rel": "mention", "lines": [75, 77], "note": "Python 依赖的安装方式，非本产品安装途径", "quotes": ["- MacOS 用户可以使用 Homebrew 安装：", "  brew install python@3.12"]}, {"term": "pypi", "rel": "support", "lines": [139, 143, 148, 155, 157], "note": "pip 安装项目依赖", "quotes": ["  pip install paddlepaddle-gpu==3.0.0 -i https://www.paddlepaddle.org.cn/packages/stable/cu118/", "  pip install torch==2.7.0 torchvision==0.22.0 --index-url https://download.pytorch.org/whl/cu118", "  pip install -r requirements.txt", "  pip install onnxruntime-gpu==1.22.0", "  pip install onnxruntime-gpu==1.20.1 --index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxru"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "3578e578d1ee": {"fn": "dair-ai/AI-Papers-of-the-Week", "sha": "3578e578d1ee", "source": "readme", "identity": {"one_liner": "面向 ML 从业者的每周 AI 论文精选清单", "review": "DAIR.AI 维护的每周 AI 论文精选仓库：按周汇总当周值得关注的 AI/ML 论文链接，列表自 2023 年 1 月起持续更新至 2026 年，按年份分组归档；另有 newsletter 订阅渠道将每周清单发送至邮箱，并通过 Twitter 与 Discord 进行发布和社区交流。仓库本身为索引型内容，不包含安装或运行步骤。", "highlights": ["按周归档的 AI 论文清单（2023 年至今，按年份分组）", "提供 newsletter 邮件订阅渠道", "配套 Twitter 与 Discord 发布/交流渠道"], "use_cases": ["每周追踪 AI/ML 领域新论文", "按时间线回溯某段时间的代表性论文", "通过邮件订阅定期获取论文列表"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "none", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "科研", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["论文推荐", "AI资讯", "newsletter", "知识聚合"], "domain": "AI/学术资讯聚合", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L3: Subscribe to our newsletter to get a weekly list of top AI papers in your inbox.", "L5: At DAIR.AI we ❤️ reading AI papers so we've created this repo to highlight the top AI papers of every week.", "L7: Here is the weekly series:"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "48cc8a8b92f2": {"fn": "halfrost/Halfrost-Field", "sha": "48cc8a8b92f2", "source": "readme", "identity": {"one_liner": "开发者阅读开源源码与协议的技术文章集", "review": "个人技术笔记仓库，记录作者阅读开源项目源码后的分析与心得，内容按 LLM、Go、机器学习、JavaScript、网络协议等主题以目录表形式组织，每条对应具体项目版本与系列文章。受众为希望深入理解框架源码与底层协议的开发者。仓库持续更新，支持中英双语，接受 PR/issue 勘误，文章以 Creative Commons BY 4.0 许可转载。", "highlights": ["LLM 专题收录 vLLM v1 源码系列解析（调度器、KV Cache、进程架构等）", "覆盖 Go 内部实现、Google S2 空间索引、TLS 1.3/HTTP2/QUIC 等 RFC 级协议文章", "中英双语内容，接受社区 PR 与 issue 勘误"], "use_cases": ["系统学习 vLLM 源码与推理引擎架构", "查阅 HTTP/2、TLS 1.3、QUIC 等协议的中文详解", "参考 Go 语言切片、interface、并发原语等内部实现分析"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "viral", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["技术博客", "源码解析", "网络协议", "LLM推理", "系统设计"], "domain": "开发者教育/技术内容", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["作者 halfrost 为中文开发者，含微信公众号入口", "README 提供中英双语"]}, "trust": {"confidence": "high", "evidence": ["L11: People often say that reading the source code of open-source frameworks can significantly improve one’s skills, so I hav", "L15: # 🔥 LLM"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "vllm", "rel": "mention", "lines": [19], "note": "作为源码解析对象的文章主题，非接入的服务提供方", "quotes": ["|vLLM|v1 @ 6cf7b26bd|vLLM Source Walkthrough: From `generate()` to the First Token Entrypoints: `LLM`, CLI, and the Open"]}], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "dad933cbf1db": {"fn": "langchain4j/langchain4j", "sha": "dad933cbf1db", "source": "readme", "identity": {"one_liner": "给 JVM/Java 开发者的 LLM 应用开发库", "review": "LangChain4j 是一个面向 JVM 的开源 Java 库，目标是简化在 Java 应用中集成 LLM 的过程。它提供统一 API 屏蔽各 LLM 提供商与向量数据库的专有接口，支持在 20+ LLM 提供商与 30+ 嵌入存储之间切换而无需重写代码。工具箱覆盖提示词模板、聊天记忆管理、函数调用，直至 Agents 与 RAG 等高层模式，每个抽象都带接口与多种实现。该库按 Java 惯例从零设计（类型安全、POJO、注解、依赖注入），与 Quarkus、Spring Boot、Helidon、Micronaut 一级集成，与 Python 版 LangChain 的 API 与发布周期相互独立。", "highlights": ["统一 API 覆盖 20+ LLM 提供商与 30+ 嵌入存储，可切换实现", "工具箱从提示词模板、聊天记忆、函数调用到 Agents 与 RAG", "按 Java 惯例原生设计，一级集成 Quarkus/Spring Boot/Helidon/Micronaut", "MCP 相关工具调用支持"], "use_cases": ["在 Spring Boot/Quarkus 等 Java 企业应用中接入 LLM", "构建从数据摄取到检索的完整 RAG 管线", "开发带工具调用的聊天机器人或 Agent", "在不重写代码的前提下试验和更换不同 LLM 提供商"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": true, "lines": [37, 38]}}, "links": {"scenario_tags": ["LLM框架", "Java", "RAG", "Agent", "向量数据库"], "domain": "LLM 基础设施/应用开发框架", "alternative_to": [], "competitors_mentioned": ["LangChain"], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L16: The goal of LangChain4j is to simplify integrating LLMs into Java applications.", "L23:  LangChain4j currently supports 20+ popular LLM providers", "L43: type safety, POJOs, annotations, interfaces, dependency injection, fluent APIs, and first-class integrations with Quarku"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [{"term": "LangChain", "rel": "competitor", "lines": [41, 44], "note": "明确声明并非 LangChain 的 Java 移植，API 与发布周期独立", "quotes": ["**Despite the name, LangChain4j is not a Java port of LangChain (Python) — it is built for Java, not ported to it.**", "Its API, internals, and release cycle are independent of the Python LangChain project."]}, {"term": "ChatGPT", "rel": "mention", "lines": [37], "note": "作为 2023 年发展背景提及", "quotes": ["LangChain4j began development in early 2023 amid the ChatGPT hype."]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "5720e9a8cadf": {"fn": "modelscope/DiffSynth-Studio", "sha": "5720e9a8cadf", "source": "readme", "identity": {"one_liner": "为开发者提供的开源 Diffusion 模型推理与训练引擎", "review": "由 ModelScope 社区团队维护的 Diffusion 模型引擎，集成图像生成、视频生成、音频生成与图像质量评估类开源模型。框架提供跨磁盘/内存/显存的动态参数调度，使低显存消费级 GPU 可运行大模型推理；支持 NF4、INT8 等量化以降低推理与 LoRA 训练的显存需求；推理支持的模型基本均可训练，训练过程可拆分为两阶段。相关派生项目包括 ComfyUI 节点包与 LoRA 训练 WebUI。README 说明开发人力有限，旧版本功能不再维护。", "highlights": ["集成图像/视频/音频生成与图像质量评估模型", "跨磁盘、内存、显存的动态参数调度，低显存 GPU 可推理大模型", "NF4/INT8 等量化后端（含自研 EntroPack 压缩库）", "提供 Agent Skills 用于自动化模型集成流程"], "use_cases": ["在消费级 GPU 上运行大参数量扩散模型的推理与 LoRA 训练", "通过 ComfyUI 节点搭建扩散模型工作流", "对音乐、视频、图像生成模型做量化与低显存部署"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "research"}, "eval": {"target_user": "开发者", "paper_url": "https://arxiv.org/abs/2609.34185", "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["Diffusion模型", "图像生成", "视频生成", "音频生成", "LoRA训练"], "domain": "AIGC/生成模型框架", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["ModelScope 社区团队维护", "提供中文版文档切换", "模型托管于 modelscope.cn"]}, "trust": {"confidence": "high", "evidence": ["L16: Welcome to the magical world of Diffusion models! DiffSynth-Studio is an open-source Diffusion model engine developed an", "L20: * Model Support: The framework integrates mainstream open-source Diffusion models, covering image generation, video gene", "L21: * VRAM Management: Dynamically schedules model parameters across disk, memory, and VRAM, allowing consumer-grade GPUs wi"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [5, 294], "quotes": ["PyPI", "pip install -e ."]}, {"term": "source", "rel": "support", "lines": [292], "quotes": ["git clone https://github.com/modelscope/DiffSynth-Studio.git"]}], "hardware": [{"term": "24GB VRAM", "rel": "mention", "lines": [224], "quotes": ["- **December 19, 2024** We implemented advanced VRAM management for HunyuanVideo, enabling video generation with resolut"]}], "products": [{"term": "通义千问", "rel": "mention", "lines": [53, 55, 72], "quotes": [" * Example Code: Z-Image-Turbo, Qwen-Image-2.1, MiniMax-H3, LoRA Training Example", "- **September 20, 2026** Qwen-Image-2.1 was open-sourced. The model supports text-to-image generation, image editing, an", "- **August 31, 2026** We have integrated Qwen-Video-Edit, a video editing model developed by open-source community contr"]}, {"term": "Hugging Face", "rel": "mention", "lines": [115, 116], "quotes": [" * Model collections: ModelScope | ModelScope International | HuggingFace", " * Datasets: ModelScope | ModelScope International | HuggingFace"]}, {"term": "文心一言", "rel": "mention", "lines": [343, 612, 613], "quotes": [" - ERNIE-Image: Documentation, Example code", "|ERNIE-Image|PaddlePaddle/ERNIE-Image|code|code|code|code|code|code|", "|ERNIE-Image|PaddlePaddle/ERNIE-Image-Turbo|code|code|—|—|—|—|"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": true, "lines": [40]}}}, "b58b1702c64a": {"fn": "Portkey-AI/gateway", "sha": "b58b1702c64a", "source": "readme", "identity": {"one_liner": "为开发者提供统一的 AI 网关，路由 1600+ 模型并集成 guardrails", "review": "开源 AI Gateway，通过单一 API 将请求路由到 1600+ 语言、视觉、音频与图像模型。核心机制包括自动重试与 fallback、负载均衡与条件路由、40+ 预置 guardrails、虚拟密钥管理与用量分析；另提供 MCP Gateway 作为组织级 MCP 服务器的集中控制平面（认证、访问控制、可观测性）。通过 npx 本地运行，支持 Docker、Cloudflare 等多种部署方式；部分功能（语义缓存、prompt 管理等）仅 hosted/企业版提供。", "highlights": ["单一 API 路由 1600+ 多模态模型，支持 45+ provider", "fallback、自动重试、负载均衡等可靠路由机制", "40+ 预置 guardrails 验证 LLM 输入输出", "MCP Gateway 提供集中认证、访问控制与调用日志"], "use_cases": ["在多个 LLM provider 之间做故障切换与负载均衡", "为 AI 应用统一添加输入输出 guardrails", "集中管理组织的 MCP 服务器访问权限与调用日志", "本地或私有化部署 LLM 网关"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "library", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_ur