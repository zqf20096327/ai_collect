: "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["agent-skills", "图表生成", "开发者工具", "架构可视化"], "domain": "开发者工具/图表生成", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["README 提供简体中文渠道", "微信/QQ 群", "量子位报道", "上海 CityWalk 社区案例"]}, "trust": {"confidence": "high", "evidence": ["L9:  Start with an idea, a question, or a plan. Describe it to your AI agent, and Archify turns it into an interactive HTML ", "L26:  Works with Claude Code, Codex, Cursor, and OpenCode", "L48: npx skills add tt-a1i/archify -g"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [74, 77, 80], "note": "仅在赞助商与产品提及语境出现 Claude，非专门适配通道", "quotes": [" Thank you to OpenLux for sponsoring this project! OpenLux is an all-in-one AI platform for businesses, bringing togethe", " Access leading AI models through PackyCode with one API endpoint and one API key. Enjoy automatic failover and dedicate", " Thank you to AICodeMirror for sponsoring Archify! AICodeMirror provides API relay services for Claude, Codex, and Gemin"]}, {"term": "deepseek", "rel": "mention", "lines": [83], "note": "赞助商列举的模型之一", "quotes": [" Thank you to Infistar.cc for sponsoring Archify! One API key covers text, image, and video creation with GPT, Claude, G"]}], "install": [{"term": "npm", "rel": "support", "lines": [48, 171, 179, 185], "quotes": ["npx skills add tt-a1i/archify -g", "npx skills add tt-a1i/archify -g", "npx -y skills add tt-a1i/archify --skill archify --agent cursor --global --copy --yes", "npx skills use tt-a1i/archify@archify --agent codex"]}], "hardware": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}, "products": [{"term": "Claude Code", "rel": "mention", "lines": [26, 45, 190], "quotes": [" Works with Claude Code, Codex, Cursor, and OpenCode", "Works with Cursor, Claude Code, Codex CLI, and OpenCode. See installation options below for additional integrations.", "The agent switcher covers `cursor`, `codex`, `claude-code`, and `opencode`."]}, {"term": "Cursor", "rel": "mention", "lines": [26, 45, 176], "quotes": [" Works with Claude Code, Codex, Cursor, and OpenCode", "Works with Cursor, Claude Code, Codex CLI, and OpenCode. See installation options below for additional integrations.", "For an explicit, non-interactive Cursor install:"]}, {"term": "Kimi", "rel": "mention", "lines": [68], "note": "插件商店合作渠道，非替代/竞品", "quotes": ["**Archify × Kimi Work.** Find Archify in the Kimi Work plugin store as **Interactive Architecture Diagram**. Describe yo"]}, {"term": "通义千问", "rel": "mention", "lines": [83], "note": "赞助商列举的模型之一", "quotes": [" Thank you to Infistar.cc for sponsoring Archify! One API key covers text, image, and video creation with GPT, Claude, G"]}]}}, "8990ace3aed3": {"fn": "rtk-ai/rtk", "sha": "8990ace3aed3", "source": "readme", "identity": {"one_liner": "压缩开发命令输出的 CLI 代理，降低 agent 读取的 token 消耗", "review": "RTK 以 shell hook 方式拦截 agent 的命令调用，在输出进入 LLM 上下文前按命令类型做过滤、分组、截断与去重，覆盖 git、cargo、npm、pytest、docker 等 100+ 命令。单个 Rust 二进制、无运行时依赖，安装后通过 `rtk init` 为各编码 agent 配置集成；`rtk gain` 提供节省统计。部分版本含 BUSL-1.1 授权的可选 proxy 守护进程，将压缩扩展到 provider API 流量。注意 README 明确节省比例仅针对 bash 输出部分，不等于整体账单降幅。", "highlights": ["支持 18 个 AI 编码工具的 hook/规则集成（Claude Code、Copilot、Cursor、Gemini CLI 等）", "覆盖 100+ 开发命令的输出过滤，宣称 <10ms 开销", "按 Apache-2.0 与 BUSL-1.1 双版本分发（oss 版无压缩引擎）", "可选 rtk-proxy 守护进程处理 provider API 流量并支持模型路由"], "use_cases": ["为 Claude Code 等 agent 减少命令输出占用的上下文", "统计并可视化 agent 会话的 token 节省情况", "通过代理压缩 agent 的 provider API 请求流量"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "dual", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["开发者工具", "token优化", "agentic-coding", "CLI"], "domain": "LLM 基础设施/开发工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["README 提供中文等多语言版本链接(L21)"]}, "trust": {"confidence": "high", "evidence": ["L31: rtk filters and compresses command outputs before they reach your LLM context. Single Rust binary, 100+ supported comman", "L143: RTK supports 18 AI coding tools. Each integration rewrites shell commands to `rtk` equivalents, reducing the bash output", "L147: |**Claude Code**|`rtk init -g`|PreToolUse hook (native binary)|"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [126, 139], "note": "README 中的 Claude 指向 Anthropic 模型使用场景，非 provider 接入通道", "quotes": ["  Claude  --git status-->  shell  -->  git         Claude  --git status-->  RTK  -->  git", "> **Does RTK break Claude's prompt cache?** No. RTK filters output once per command. The result is stored in history and"]}], "install": [{"term": "brew", "rel": "support", "lines": [66, 101], "quotes": ["brew install rtk                                              # macOS / Linux", "brew install rtk-ai/tap/rtk-oss"]}, {"term": "cargo", "rel": "support", "lines": [78], "note": "L78 提及 Cargo 为安装途径之一（详见安装指南）", "quotes": ["> Cargo, pre-built binaries, native Windows, WSL, and uninstall: **Installation guide**"]}], "hardware": [], "products": [{"term": "GitHub Copilot", "rel": "mention", "lines": [110, 148, 149], "quotes": ["rtk init -g                     # Claude Code / Copilot (default)", "|**GitHub Copilot (VS Code)**|`rtk init -g --copilot`|PreToolUse hook — transparent rewrite|", "|**GitHub Copilot CLI**|`rtk init -g --copilot`|PreToolUse deny-with-suggestion (CLI limitation)|"]}, {"term": "Claude Code", "rel": "mention", "lines": [110, 147], "quotes": ["rtk init -g                     # Claude Code / Copilot (default)", "|**Claude Code**|`rtk init -g`|PreToolUse hook (native binary)|"]}, {"term": "Cursor", "rel": "mention", "lines": [150], "quotes": ["|**Cursor**|`rtk init -g --agent cursor`|preToolUse hook (hooks.json)|"]}, {"term": "Windsurf", "rel": "mention", "lines": [153], "quotes": ["|**Windsurf**|`rtk init -g --agent windsurf`|.windsurfrules (project-scoped)|"]}, {"term": "Kimi", "rel": "mention", "lines": [163], "quotes": ["|**Kimi AI**|`rtk init --agent kimi`|AGENTS.md (project-scoped)|"]}], "dual_license": {"flag": true, "lines": [9, 93, 94, 95, 97, 210], "quotes": [" License: Apache-2.0 and BUSL-1.1", "|`rtk-<target>`|Apache-2.0 + BUSL-1.1|Hook core, every command filter, **and** the compression engine|", "|`rtk-oss-<target>`|Apache-2.0 only|Hook core and every command filter. No engine.|", "|`rtk-proxy-<target>`|BUSL-1.1|The RTK Proxy daemon. Never bundled with either `rtk`.|", "**Production use is free**, engine and daemon included. What the BUSL grant does not cover is offering RTK or a derivati", "It is a separate binary under a separate licence (BUSL-1.1), shipped as its own `rtk-proxy-<target>` archive — `rtk` nev"]}, "deprecation": {"flag": false, "lines": []}}}, "a00599a59470": {"fn": "mlabonne/llm-course", "sha": "a00599a59470", "source": "readme", "identity": {"one_liner": "面向 LLM 学习者的三阶段课程：路线图与 Colab 笔记本", "review": "按三部分组织的学习路线：LLM Fundamentals（数学、Python、神经网络、NLP 基础）、The LLM Scientist（构建模型的技术）、The LLM Engineer（构建与部署 LLM 应用）。作者附赠一组可运行的 Colab 笔记本，覆盖自动评估、模型合并、云上微调（Unsloth/Axolotl/TRL）、量化（GGUF/GPTQ/EXL2/AWQ/HQQ）、去重与消融等工具流程，并配套文章与基于该课程合著的 LLM Engineer's Handbook。课程本身声明永久免费。", "highlights": ["三部分路线图：基础、LLM Scientist、LLM Engineer", "8 个自动化工具笔记本（LLM AutoEval、LazyMergekit、AutoQuant 等）", "6 个微调教程笔记本覆盖 Llama/Mistral/CodeLlama", "量化教程覆盖 GGUF、GPTQ、EXL2、AWQ、HQQ 格式"], "use_cases": ["系统学习大语言模型从数学基础到应用部署的路线", "在 Google Colab 中一键运行微调、合并、量化笔记本", "查找微调与量化技术的入门文章与资源清单"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["课程/路线图", "LLM学习", "微调", "量化", "Colab笔记本"], "domain": "教育/LLM 学习资源", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L8: LLM EngineerThe LLM course is divided into three parts:", "L21: A list of notebooks and articles I wrote about LLMs.", "L29: |🧐 LLM AutoEval|Automatically evaluate your LLMs using RunPod|Open In Colab|"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "llama.cpp", "rel": "mention", "lines": [55], "note": "量化教程内容中提及，非产品接入", "quotes": ["|Quantization with GGUF and llama.cpp|Quantize Llama 2 models with llama.cpp and upload GGUF versions to the HF Hub.|Art"]}], "install": [{"term": "colab", "rel": "support", "lines": [29, 30, 31, 32, 33], "note": "笔记本以 Open In Colab 提供，为使用途径", "quotes": ["|🧐 LLM AutoEval|Automatically evaluate your LLMs using RunPod|Open In Colab|", "|🥱 LazyMergekit|Easily merge models using MergeKit in one click.|Open In Colab|", "|🦎 LazyAxolotl|Fine-tune models in the cloud using Axolotl in one click.|Open In Colab|", "|⚡ AutoQuant|Quantize LLMs in GGUF, GPTQ, EXL2, AWQ, and HQQ formats in one click.|Open In Colab|", "|🌳 Model Family Tree|Visualize the family tree of merged models.|Open In Colab|"]}], "hardware": [{"term": "no GPU required", "rel": "mention", "lines": [62], "note": "MergeKit 合并模型教程的说明，非课程自身要求", "quotes": ["|Merge LLMs with MergeKit|Create your own models easily, no GPU required!|Article|Open In Colab|"]}], "products": [{"term": "ChatGPT", "rel": "mention", "lines": [65], "note": "教程笔记本的对象，非竞品/替代关系", "quotes": ["|Improve ChatGPT with Knowledge Graphs|Augment ChatGPT's answers with knowledge graphs.|Article|Open In Colab|"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "921f4d5ae80e": {"fn": "bytedance/deer-flow", "sha": "921f4d5ae80e", "source": "readme", "identity": {"one_liner": "面向开发者的长时程 SuperAgent 编排框架：研究、编码与创作", "review": "DeerFlow 是字节跳动开源的 super agent harness，通过编排子代理、记忆、沙箱与可扩展技能来处理耗时数分钟到数小时的任务。安装提供 make setup 交互式向导，引导选择 LLM 提供商、可选网络搜索及沙箱/bash/文件写入等安全偏好，生成 config.yaml 与 .env；另有面向编码代理的一句话引导安装说明。README 详述多种搜索/抓取后端（Brave、Tavily、DuckDuckGo、Serper、InfoQuest、Jina 等）对畸形响应的结构化错误处理，并提供 make doctor 自检与 make support-bundle 问题诊断包。v2.0 为完全重写，v1.x 分支继续维护原 Deep Research 框架。", "highlights": ["编排子代理、记忆与沙箱的长时程任务 harness", "make setup 交互式向导配置 LLM 提供商与安全偏好", "多种网络搜索与抓取后端的结构化错误处理", "make doctor 自检与 support-bundle 问题诊断流程"], "use_cases": ["搭建能自主完成研究、编码与内容创作的长时程代理", "为代理任务配置沙箱、bash 访问与文件写入等安全选项", "接入多种网络搜索/抓取后端做深度调研"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "desktop", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": true, "lines": [10]}}, "links": {"scenario_tags": ["agent框架", "deep-research", "编排/harness", "LLM基础设施"], "domain": "LLM 基础设施/Agent 框架", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["字节跳动（bytedance）维护", "提供中文 README", "面向中国大陆开发者的指引"]}, "trust": {"confidence": "mid", "evidence": ["L12: DeerFlow (**D**eep **E**xploration and **E**fficient **R**esearch **Flow**) is an open-source **super agent harness** th", "L17: > **DeerFlow 2.0 is a ground-up rewrite.** It shares no code with v1. If you're looking for the original Deep Research f", "L103:  This launches an interactive wizard that guides you through choosing an LLM provider, optional web search, and executio"], "xcheck": {"install_missing": ["docker", "npm", "pypi"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "deepseek", "rel": "mention", "lines": [32], "note": "推荐用于运行 DeerFlow 的模型之一", "quotes": ["- We strongly recommend using Doubao-Seed-2.0-Code, DeepSeek v3.2 and Kimi 2.5 to run DeerFlow"]}, {"term": "anthropic", "rel": "mention", "lines": [75], "note": "提及 Claude 适配器的重试行为", "quotes": ["Enabling it disables exposed SDK retries and the Claude and Codex adapters'"]}], "install": [{"term": "source", "rel": "support", "lines": [91, 100], "quotes": ["   git clone https://github.com/bytedance/deer-flow.git", "   make setup"]}], "hardware": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": [17]}, "products": [{"term": "Kimi", "rel": "mention", "lines": [32], "quotes": ["- We strongly recommend using Doubao-Seed-2.0-Code, DeepSeek v3.2 and Kimi 2.5 to run DeerFlow"]}, {"term": "豆包", "rel": "mention", "lines": [32], "quotes": ["- We strongly recommend using Doubao-Seed-2.0-Code, DeepSeek v3.2 and Kimi 2.5 to run DeerFlow"]}, {"term": "Claude Code", "rel": "mention", "lines": [54], "quotes": ["If you use Claude Code, Codex, Cursor, Windsurf, or another coding agent, you can hand it the setup instructions in one "]}, {"term": "Cursor", "rel": "mention", "lines": [54], "quotes": ["If you use Claude Code, Codex, Cursor, Windsurf, or another coding agent, you can hand it the setup instructions in one "]}, {"term": "Windsurf", "rel": "mention", "lines": [54], "quotes": ["If you use Claude Code, Codex, Cursor, Windsurf, or another coding agent, you can hand it the setup instructions in one "]}]}}, "589877fccf3d": {"fn": "datawhalechina/hello-agents", "sha": "589877fccf3d", "source": "readme", "identity": {"one_liner": "面向开发者的从零构建智能体系统开源教程", "review": "Datawhale 社区出品的系统性智能体学习教程，共 16 章，覆盖智能体基础、经典范式（ReAct、Plan-and-Solve、Reflection）、低代码平台使用、主流框架应用、自研框架 HelloAgents 构建、RAG 与记忆、上下文工程、MCP 等通信协议、Agentic RL 训练与性能评估，并附智能旅行助手、DeepResearch 复现、赛博小镇等实战案例。提供在线阅读、PDF 下载与配套代码。要求读者具备基础 Python 能力与 LLM 概念性了解，采用 CC BY-NC-SA 4.0 协议。", "highlights": ["16 章教程覆盖从 LLM 基础到多智能体应用的全流程", "基于 OpenAI 原生 API 从零构建自研框架 HelloAgents", "提供配套代码仓库与社区贡献章节（面试题、踩坑经验等）", "提供在线阅读、国内加速访问与 PDF 下载渠道"], "use_cases": ["系统学习智能体原理与经典范式并动手实现", "了解 Dify、Coze 等低代码平台与 LangGraph 等框架的使用", "跟随实战章节开发旅行助手、深度研究智能体等多智能体项目", "准备 Agent 岗位求职面试"]}, "filters": {"ai_role": "ai-native", "license_risk": "none", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://www.datawhale.cn/learn/summary/239", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["智能体教程", "LLM", "RAG", "Agentic RL", "开源课程"], "domain": "教育/AI 学习教程", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "media", "zh_origin": true, "zh_origin_signals": ["全中文 README", "Datawhale 社区项目", "国内加速下载地址 datawhale.cn"]}, "trust": {"confidence": "high", "evidence": ["L22: &emsp;&emsp;Hello-Agents 是 Datawhale 社区的 系统性智能体学习教程 。如今 Agent 构建主要分为两派，一派是 Dify，Coze，n8n 这类软件工程类 Agent，其本质是流程驱动的软件开发，LLM", "L37: - 🛠️ 自研框架 HelloAgents 基于 Openai 原生 API 从零构建一个自己的智能体框架", "L103: &emsp;&emsp;本项目内容兼顾理论与实战，旨在帮助你系统性地掌握从单个智能体到多智能体系统的设计与开发全流程。因此，尤其适合有一定编程基础的 AI 开发者、软件工程师、在校学生 以及对前沿 AI 技术抱有浓厚兴趣的 自学者 。在学习"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [{"term": "Dify", "rel": "mention", "lines": [22, 54, 80], "note": "教程中介绍的低代码平台之一，非替代/竞品关系", "quotes": ["&emsp;&emsp;Hello-Agents 是 Datawhale 社区的 系统性智能体学习教程 。如今 Agent 构建主要分为两派，一派是 Dify，Coze，n8n 这类软件工程类 Agent，其本质是流程驱动的软件开发，LLM", "|第五章 基于低代码平台的智能体搭建|了解 Coze、Dify、n8n 等低代码智能体平台使用|✅|", "|03-Dify智能体创建保姆级教程|Dify智能体创建保姆级教程|"]}, {"term": "Coze", "rel": "mention", "lines": [22, 54, 109], "note": "教程中介绍的低代码平台之一，非替代/竞品关系", "quotes": ["&emsp;&emsp;Hello-Agents 是 Datawhale 社区的 系统性智能体学习教程 。如今 Agent 构建主要分为两派，一派是 Dify，Coze，n8n 这类软件工程类 Agent，其本质是流程驱动的软件开发，LLM", "|第五章 基于低代码平台的智能体搭建|了解 Coze、Dify、n8n 等低代码智能体平台使用|✅|", "- 第二部分：构建你的大语言模型智能体 （第四章～第七章），这是你动手实践的起点。你将亲手实现 ReAct 等经典范式，体验 Coze 等低代码平台的便捷，并掌握 Langgraph 等主流框架的应用。最终，我们还会带你从零开始构建一个属于"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "172814a07ce7": {"fn": "Developer-Y/cs-video-courses", "sha": "172814a07ce7", "source": "readme", "identity": {"one_liner": "为学生收录带视频讲授的计算机科学课程链接清单", "review": "以列表形式收录大学（学院）级别的计算机科学课程及其视频讲授链接，覆盖计算机科学导论、数据结构与算法、系统编程、操作系统等方向，条目标注学校、教师、学期并附视频播放列表、讲义或课程网站链接。收录标准为正式的大学级别课程，明确排除小型 MOOC、基础教程与站点广告。项目通过 CONTRIBUTING.md 接受 PR 贡献，并对空 issue 等行为设有限制规则。", "highlights": ["按学科分类组织大学级别课程链接清单", "每条附视频播放列表/课程网站/讲义链接", "收录 UNSW、MIT、Stanford、Berkeley、IIT 等多校课程", "PR 贡献制并设有收录标准（排除基础教程与广告）"], "use_cases": ["按方向查找含视频讲授的大学公开课", "自学计算机科学核心课程时选择不同学校版本", "为课程收录贡献新的大学级公开课链接"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "none", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "消费者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["课程清单", "计算机科学", "公开课/视频课程", "学习资源"], "domain": "教育/计算机科学学习资源", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L1: # Computer Science courses with video lectures", "L8: - You are welcome to contribute, please create PR for actual college/University level courses. Please do not add links f", "L14: ## Courses"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "93a11e8cdb2d": {"fn": "lobehub/lobehub", "sha": "93a11e8cdb2d", "source": "readme", "identity": {"one_liner": "多智能体协作平台：像团队一样雇佣、调度、汇报 AI 代理", "review": "LobeHub 是一个面向多智能体协作的工作空间：以 Agent 为工作单元，提供 Agent Builder 一键生成智能体配置、Agent Groups 并行协作、Pages 共享上下文协作写作、Schedule 定时运行、Workspace 团队空间，以及结构化可编辑的 Personal Memory 持续学习机制。声称支持 10,000+ 技能工具与 MCP 兼容插件。支持通过 Vercel、Zeabur、Sealos、阿里云或 Docker 镜像自行部署，配置 OPENAI_API_KEY 等环境变量后使用。README 注明项目仍在活跃开发中。", "highlights": ["Agent Builder 一句话生成智能体配置", "Agent Groups 多智能体并行协作与定时调度", "10,000+ 工具/MCP 兼容插件库", "结构化、可编辑的白盒 Personal Memory"], "use_cases": ["把多个 AI 智能体组成团队按项目协作", "通过定时任务让代理在离线时执行工作", "在团队工作区中与智能体共享上下文协作", "自托管私人聊天机器人服务"]}, "filters": {"ai_role": "ai-native", "license_risk": "none", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": true, "lines": [56]}}, "links": {"scenario_tags": ["多智能体", "AI 工作台", "自托管", "MCP插件", "团队协作"], "domain": "AI 应用/多智能体平台", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["README 提供简体中文版本"]}, "trust": {"confidence": "mid", "evidence": ["L76: LobeHub is a work-and-lifestyle space to find, build, and collaborate with agent teammates that grow with you. In LobeHu", "L93: - **Unified Intelligence**: Seamlessly access any model and any modality—all under your control.", "L128: LobeHub provides Self-Hosted Version with Vercel, Alibaba Cloud, and [Docker Image][docker-release-link]. This allows yo"], "xcheck": {"install_missing": ["npm"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [229], "quotes": ["||**AIHubMix**|Uses the OpenAI enterprise API; all models site-wide at **14% off** the official price (incl. GPT-5.6 and"]}], "install": [{"term": "docker", "rel": "support", "lines": [159, 165, 182], "quotes": ["### `B` Deploying with Docker", "We provide a Docker image for deploying the LobeHub service on your own private device. Use the following command to sta", "docker compose up -d"]}, {"term": "source", "rel": "mention", "lines": [280], "quotes": ["$ git clone https://github.com/lobehub/lobehub.git"]}, {"term": "npm", "rel": "mention", "lines": [282], "quotes": ["$ pnpm install"]}], "hardware": [], "products": [{"term": "通义千问", "rel": "mention", "lines": [197], "quotes": ["|`OPENAI_MODEL_LIST`|No|Used to control the model list. Use `+` to add a model, `-` to hide a model, and `model_name=dis"]}, {"term": "Midjourney", "rel": "mention", "lines": [331], "quotes": ["- **[⛵️ Lobe Midjourney WebUI][lobe-midjourney-webui]:** WebUI for Midjourney, leverages AI to quickly generate a wide a"]}, {"term": "ChatGPT", "rel": "mention", "lines": [332, 333], "quotes": ["- **[🌏 Lobe i18n][lobe-i18n] :** Lobe i18n is an automation tool for the i18n (internationalization) translation process", "- **[💌 Lobe Commit][lobe-commit]:** Lobe Commit is a CLI tool that leverages Langchain/ChatGPT to generate Gitmoji-based"]}, {"term": "LangChain", "rel": "mention", "lines": [333], "quotes": ["- **[💌 Lobe Commit][lobe-commit]:** Lobe Commit is a CLI tool that leverages Langchain/ChatGPT to generate Gitmoji-based"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "33b770a937ec": {"fn": "netdata/netdata", "sha": "33b770a937ec", "source": "readme", "identity": {"one_liner": "为基础设施团队提供每秒级实时监控与 ML 异常检测", "review": "Netdata 是开源实时基础设施监控平台，Agent 部署在被监控节点上执行采集、存储、边缘 ML 训练与告警，覆盖系统资源、存储、网络、容器、虚拟机、日志、云服务与 800+ 集成；采用 Parent-Child 架构实现集中化与横向扩展，可选连接 Netdata Cloud 获得多节点视图与 RBAC，数据保留在本地基础设施。存储约 0.5 字节/样本，生产环境默认资源占用约 5% CPU、150MiB RAM。", "highlights": ["每秒级指标采集与实时可视化（1 秒延迟）", "边缘训练 ML 模型做每指标无监督异常检测", "800+ 集成，自动发现节点上的指标", "指标可导出至 Prometheus、InfluxDB、OpenTSDB、Graphite 等"], "use_cases": ["监控服务器、容器与 Kubernetes 集群的实时性能", "无需中心化采集地保留监控数据在本地", "通过内置 ML 自动发现指标异常", "把多节点指标导出到既有时间序列数据库"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "viral", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "企业", "paper_url": null, "demo_url": "https://www.netdata.cloud（L183-L196 列出多个 Live Demo 站点链接）", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["可观测性", "基础设施监控", "异常检测", "DevOps"], "domain": "DevOps/可观测性", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L42: Netdata is an open-source, real-time infrastructure monitoring platform. Monitor, detect, and act across your entire inf", "L83: |**ML-Powered**|Unsupervised anomaly detection|Trains multiple ML models per metric at the edge|", "L232: |**Edge-Based ML**|• ML models trained at the edge • Automatic anomaly detection per metric • Pattern recognition based "], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "77be4acb6abb": {"fn": "dair-ai/Prompt-Engineering-Guide", "sha": "77be4acb6abb", "source": "readme", "identity": {"one_liner": "面向研究者与开发者的提示工程指南：论文、课程、笔记本与资源合集", "review": "由 DAIR.AI 维护的提示工程指南，汇集提示工程相关论文、学习指南、讲座、引用与工具，覆盖零样本/少样本、思维链、ReAct、RAG 等技术主题，并按模型（ChatGPT、LLaMA、Mistral 等）与应用场景组织章节；提供网页版与 13 种语言翻译，配套 DAIR.AI Academy 的付费课程。本地运行需 Node >=18 与 pnpm，以 Next.js/Nextra 构建文档站点。", "highlights": ["覆盖零样本、思维链、ReAct、ToT、RAG 等提示技术章节", "支持 13 种语言的翻译版本", "提供 1 小时视频讲座及配套 notebook 与幻灯片", "含模型、应用、风险、论文、工具、数据集等分类指引"], "use_cases": ["系统学习提示工程技术与最佳实践", "为 LLM 应用开发查找提示相关论文与工具", "本地运行文档站点校对翻译内容"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "permissive", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://www.promptingguide.ai/", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["提示工程", "学习资源", "LLM", "RAG", "文档站点"], "domain": "AI 教育与知识聚合", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "team", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L5: Prompt engineering is a relatively new discipline for developing and optimizing prompts to efficiently use language mode", "L7: Motivated by the high interest in developing with LLMs, we have created this new prompt engineering guide that contains ", "L123: 1. Install the dependencies: `pnpm i next react react-dom nextra nextra-theme-docs`"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "mistral", "rel": "mention", "lines": [91, 92], "quotes": [" - Prompt Engineering - Mistral 7B", " - Prompt Engineering - Mixtral"]}], "install": [{"term": "npm", "rel": "support", "lines": [123], "note": "通过 pnpm（npm 生态）安装依赖运行本地站点", "quotes": ["1. Install the dependencies: `pnpm i next react react-dom nextra nextra-theme-docs`"]}], "hardware": [], "products": [{"term": "ChatGPT", "rel": "mention", "lines": [85, 129], "note": "作为指南章节主题与媒体报道语境提及，非竞品关系", "quotes": [" - Prompt Engineering - ChatGPT", "- Wall Street Journal - ChatGPT Can Give Great Answers. But Only If You Know How to Ask the Right Question"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "7b9872d74f8a": {"fn": "tensorflow/models", "sha": "7b9872d74f8a", "source": "readme", "identity": {"one_liner": "TensorFlow 用户的 SOTA 模型与建模方案实现仓库", "review": "TensorFlow Model Garden 仓库，包含四部分：official（官方维护、基于 TF2 高层 API 的 SOTA 模型示例实现）、research（研究者维护的 TF1/TF2 研究模型）、community（社区模型仓库清单）与 orbit（自定义训练循环库，集成 tf.distribute，支持 CPU/GPU/TPU）。面向用 TensorFlow 做研究与产品开发的用户，提供训练日志（TensorBoard.dev），可通过 pip 包或克隆源码安装。", "highlights": ["official/research/community/orbit 四类模型集合", "orbit 训练循环库支持 CPU、GPU 与 TPU", "提供 tf-models-official 稳定版与 tf-models-nightly 每日构建包", "部分模型提供 TensorBoard.dev 训练日志"], "use_cases": ["查找 TensorFlow 2 官方维护的 SOTA 模型实现", "为研究复现模型训练并参考官方建模实践", "基于 orbit 库编写自定义分布式训练循环"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "none", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "科研", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["模型库", "深度学习", "TensorFlow", "研究复现"], "domain": "机器学习/模型实现", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L7: implementations of state-of-the-art (SOTA) models and modeling solutions for", "L9: TensorFlow users can take full advantage of TensorFlow for their research and", "L21: |orbit|• A flexible and lightweight library that users can easily use or fork when writing customized training loop code"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "pypi", "rel": "support", "lines": [2, 34, 47, 79, 86], "quotes": ["tf-models-official PyPI", "pip3 install tf-models-official", "pip3 install tf-models-nightly", "pip3 install --user -r models/official/requirements.txt", "pip3 install tensorflow-text-nightly"]}, {"term": "source", "rel": "support", "lines": [55], "quotes": ["git clone https://github.com/tensorflow/models.git"]}, {"term": "colab", "rel": "mention", "lines": [69], "quotes": ["If you are using a Colab notebook, please set the Python path with os.environ."]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "784e42fd7095": {"fn": "unslothai/unsloth", "sha": "784e42fd7095", "source": "readme", "identity": {"one_liner": "在本地运行和微调 LLM 与扩散模型的桌面应用", "review": "Unsloth 提供三种使用形态：桌面应用（Unsloth Desktop）、Web UI（Unsloth Studio）与代码库（Unsloth Core）。功能覆盖本地运行与训练 LLM、GGUF、MLX、扩散、嵌入、音频等模型；微调支持 LoRA、QLoRA、GRPO、DPO、FP8 等；提供 OpenAI 兼容 API、RAG/搜索、LAN 与 Cloudflare 远程访问；通过 unsloth start 一条命令将 Claude Code、Codex 等 agent 接到本地模型。支持 Windows/macOS/Linux，含 Docker 镜像与免费 Colab 类 notebook。", "highlights": ["运行与训练 LLM、GGUF、MLX、扩散、嵌入、音频模型", "微调支持 RL、LoRA、QLoRA、GRPO、DPO、FP8，导出 GGUF/NVFP4/FP8", "unsloth start 命令连接 Claude Code、Codex、MCP 等本地 agent", "提供 OpenAI 兼容 API、RAG、LAN/Cloudflare 远程访问"], "use_cases": ["在本地桌面运行和微调大模型", "把 Claude Code/Codex 等 agent 接入本地模型", "从 PDF/CSV/DOCX 构建数据集并训练模型", "在局域网或远程安全访问本地模型服务"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "self-host", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["本地LLM", "微调", "桌面应用", "RAG", "AI Agent"], "domain": "LLM 基础设施/模型训练与推理", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["llama.cpp", "anthropic"]}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L6: Unsloth is the first desktop app to run and train models.", "L78: * Run and train LLMs, MLX, GGUF, diffusion, decision, embedding, audio models: Qwen3.8, GLM-5.3-Flash, Kimi K3, Qwen-Ima", "L86: * **Fine-tuning:** Train LLMs, diffusion, decision, TTS, and embedding models 2× faster with 70% less VRAM with no accur"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "deepseek", "rel": "mention", "lines": [78, 104], "note": "可运行的模型之一及 agent 命令，非推理服务商接入", "quotes": ["* Run and train LLMs, MLX, GGUF, diffusion, decision, embedding, audio models: Qwen3.8, GLM-5.3-Flash, Kimi K3, Qwen-Ima", "|DeepSeek Harness|`unsloth start dsh`|"]}, {"term": "llama.cpp", "rel": "compat", "lines": [373, 377, 381], "note": "可配置 llama.cpp 后端（vulkan/cpu/cuda/rocm）", "quotes": ["#### Vulkan, custom llama.cpp backends:", "export UNSLOTH_LLAMA_CPP_BACKEND=vulkan   # or cpu, cuda, rocm, auto", "$env:UNSLOTH_LLAMA_CPP_BACKEND=\"vulkan\"   # or cpu, cuda, rocm, auto"]}, {"term": "anthropic", "rel": "compat", "lines": [79, 93, 96, 101], "note": "支持将本地模型接到 Claude Code", "quotes": ["* **Agents & Tools:** Use local models with Claude Code, Codex, and MCP, including tool calling and code execution.", "Unsloth Start connects Claude Code, Codex and other agents to local models with one command.", "unsloth start claude --model unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL", "|Claude Code|`unsloth start claude`|"]}], "install": [{"term": "brew", "rel": "support", "lines": [58, 60], "quotes": ["#### Homebrew:", "brew install --cask unsloth"]}, {"term": "docker", "rel": "support", "lines": [54, 56, 153, 163], "quotes": ["#### Docker:", "The Unsloth Docker image `unsloth/unsloth` is available on Docker. Read guide.", "#### Docker", "docker run -d --name unsloth --gpus all --ipc=host \\"]}, {"term": "pypi", "rel": "support", "lines": [214, 223], "note": "uv pip install unsloth，Core 版安装途径", "quotes": ["uv pip install unsloth --torch-backend=auto", "uv pip install unsloth --torch-backend=auto"]}, {"term": "source", "rel": "support", "lines": [261, 281], "quotes": ["git clone https://github.com/