": []}, "trust": {"confidence": "mid", "evidence": ["L11: An AI-powered job application framework built on Claude Code. Fork it, fill in your profile, and let Claude evaluate job", "L34: A structured workflow that turns Claude Code into a full-stack job application assistant. The core workflow (self-profil", "L47: - Claude Code (CLI). Claude Code has no free tier: you need a Claude Pro/Max/Team subscription or Anthropic API credits "], "xcheck": {"install_missing": ["pypi"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [11, 47], "note": "依赖 Claude Code 订阅或 Anthropic API 额度作为运行前提；README 声明为独立项目、与 Anthropic 无关联", "quotes": ["An AI-powered job application framework built on Claude Code. Fork it, fill in your profile, and let Claude evaluate job", "- Claude Code (CLI). Claude Code has no free tier: you need a Claude Pro/Max/Team subscription or Anthropic API credits "]}], "install": [{"term": "pypi", "rel": "mention", "lines": [51], "note": "pip install pypdf 为可选依赖的安装方式，非本产品安装途径", "quotes": ["- Optional: `pip install pypdf` for `/apply`'s ATS parseability check (BSD; no Poppler required). Poppler `pdftotext` re"]}, {"term": "brew", "rel": "mention", "lines": [51], "note": "brew install poppler 为回退依赖的安装方式，非本产品安装途径", "quotes": ["- Optional: `pip install pypdf` for `/apply`'s ATS parseability check (BSD; no Poppler required). Poppler `pdftotext` re"]}], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [11, 13, 34, 47, 87], "note": "本框架构建其上的工具链，非替代/竞品对象", "quotes": ["An AI-powered job application framework built on Claude Code. Fork it, fill in your profile, and let Claude evaluate job", "> Note: This is an independent open-source project and is not affiliated with, endorsed by, sponsored by, or maintained ", "A structured workflow that turns Claude Code into a full-stack job application assistant. The core workflow (self-profil", "- Claude Code (CLI). Claude Code has no free tier: you need a Claude Pro/Max/Team subscription or Anthropic API credits ", "# Then inside Claude Code:"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "b8623f265e1d": {"fn": "GokuMohandas/Made-With-ML", "sha": "b8623f265e1d", "source": "readme", "identity": {"one_liner": "面向开发者的生产级 ML/MLOps 应用开发课程", "review": "一个以课程形式组织的仓库，配套站点 madewithml.com 提供课程内容，代码覆盖从实验（设计+开发）到生产（部署+迭代）的完整流程：Jupyter notebook 交互式讲解后重构为带测试、文档、日志的 Python 脚本，使用 MLflow 做实验跟踪，通过 Ray 本地或 Anyscale 集群运行训练、调参、评估、推理与服务，并演示 CI/CD 工作流。读者为各方向开发者、应届毕业生与想建立技术基础的产品/管理层。可在个人笔记本运行，也可按 Anyscale 配置使用 GPU 集群。", "highlights": ["从 notebook 交互式学习到软件工程化脚本（测试、日志、版本化）的完整工作流", "支持本地笔记本与 Anyscale 集群两种运行环境，并可部署到 AWS/GCP/K8s", "使用 MLflow 做实验跟踪与模型注册", "通过 Ray 提供模型服务，可用 cURL/Python 调用"], "use_cases": ["系统学习把 ML 模型从实验推进到生产部署的流程", "在本地或云集群上实践分布式训练与模型服务", "搭建 MLOps 各组件（跟踪、测试、服务、编排）的端到端练习项目"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://madewithml.com/", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["MLOps 教程", "机器学习课程", "LLMOps", "模型部署"], "domain": "教育/ML 基础设施", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L16: Learn how to combine machine learning with software engineering to design, develop, deploy and iterate on production-gra", "L27: In this course, we'll go from experimentation (design + development) to production (deployment + iteration). We'll do th", "L38: - **⚙️ MLOps**: connect MLOps components (tracking, testing, serving, orchestration, etc.) as we build an end-to-end mac"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "source", "rel": "support", "lines": [90, 112], "quotes": ["git clone https://github.com/GokuMohandas/Made-With-ML.git .", "  python3 -m venv venv  # recommend using Python 3.10"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "84b0d91a0720": {"fn": "microsoft/qlib", "sha": "84b0d91a0720", "source": "readme", "identity": {"one_liner": "面向量化研究的 AI 量化投资平台", "review": "Qlib 是微软开源的量化投资研究平台，覆盖数据处理、模型训练、回测的完整机器学习流水线，以及 Alpha 挖掘、风险建模、组合优化、订单执行的量化全链条。支持监督学习、市场动态建模（概念漂移适应）与强化学习等多种建模范式，内置多个已发表论文的量化模型。组件采用松耦合设计，可独立使用。安装方面提供 pip 与源码两种途径；官方数据集当前临时禁用，可使用社区数据源或自行从 Yahoo Finance 抓取数据。", "highlights": ["覆盖量化投资全链条：Alpha 挖掘、风险建模、组合优化、订单执行", "支持监督学习、市场动态建模、强化学习多种 ML 范式", "内置多个已发表量化模型（论文模型 Zoo）与嵌套交易决策框架", "提供 RD-Agent（LLM 自动因子挖掘与模型优化）集成"], "use_cases": ["搭建从数据处理到回测的完整量化研究工作流", "复现和实验已发表的量化论文模型", "用强化学习建模连续投资决策与交易执行"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "permissive", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": "research"}, "eval": {"target_user": "科研", "paper_url": "https://arxiv.org/abs/2009.11189", "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["量化投资", "机器学习平台", "金融数据", "回测"], "domain": "金融科技/量化投资", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L92: Qlib is an open-source, AI-oriented quantitative investment platform that aims to realize the potential, empower researc", "L96: It contains the full ML pipeline of data processing, model training, back-testing; and covers the entire chain of quanti", "L173:   pip install pyqlib"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18"