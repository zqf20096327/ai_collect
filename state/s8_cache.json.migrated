", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L15: **On-device machine learning for everyone**", "L40: MediaPipe Solutions provides a suite of libraries and tools for you to quickly", "L51: * **MediaPipe Tasks**: Cross-platform APIs and libraries for deploying"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": true, "lines": [67, 68, 71]}}}, "8903b674874b": {"fn": "1Panel-dev/1Panel", "sha": "8903b674874b", "source": "readme", "identity": {"one_liner": "面向自托管者的 Linux 服务器管理面板与轻量 AI 管理平台", "review": "通过 Web 界面提供 Linux 服务器一站式管理：主机监控、文件/数据库/容器管理、网站一键部署（与 WordPress、Halo 集成）、内置 165+ 开源应用的应用商店一键安装升级、基于容器的部署方式及 WAF 与日志审计等安全功能、一键备份恢复并对接多种云存储。AI 方面提供从裸金属到 agent 的统一管理平台，集成 AI 网关与 Skills Hub，支持集中管理 agent 与模型。通过官方脚本一行命令安装，GPL v3 开源，另有按功能分层收费的 Pro/Ent 版本。", "highlights": ["Web 界面管理主机、文件、数据库与容器", "内置应用商店提供 165+ 应用一键安装与升级", "AI 管理：AI 网关、Skills Hub 与 agent/模型集中管理", "一键备份恢复并集成多种云存储"], "use_cases": ["自托管场景下用面板管理 Linux 服务器与容器", "在服务器上快速建站并配置域名与 SSL 证书", "集中管理服务器上的 AI agent 与模型"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "dual", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "企业", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["服务器管理面板", "自托管", "Docker", "建站", "AI平台"], "domain": "运维/服务器管理", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["提供简体中文与繁体中文等 16 种语言文档", "主题标签含 deepseek/qwen 等中文 AI 相关词"]}, "trust": {"confidence": "high", "evidence": ["L31: 1Panel is a modern, open-source Linux server management panel and a lightweight AI management platform. Through an in