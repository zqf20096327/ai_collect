h_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L5: CLIP (Contrastive Language-Image Pre-Training) is a neural network trained on a variety of (image, text) pairs. It can b", "L13: First, install PyTorch 1.7.1 (or later) and torchvision, as well as small additional dependencies, and then install this", "L18: $ pip install git+https://github.com/openai/CLIP.git"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "colab", "rel": "support", "lines": [3], "quotes": ["[[Blog]](https://openai.com/blog/clip/) [[Paper]](https://arxiv.org/abs/2103.00020) [[Model Card]](model-card.md) [[Cola"]}, {"term": "pypi", "rel": "support", "lines": [17, 18], "quotes": ["$ pip install ftfy regex tqdm", "$ pip install git+https://github.com/openai/CLIP.git"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "621d075c935f": {"fn": "datawhalechina/happy-llm", "sha": "621d075c935f", "source": "readme", "identity": {"one_liner": "面向 LLM 学习者的大模型原理与训练系统教程", "review": "Datawhale 出品的系统性 LLM 学习教程，从 NLP 基础、Transformer 架构、预训练语言模型讲起，到基于 PyTorch 亲手实现 LLaMA2、训练 Tokenizer 并完成预训练、SFT 与 LoRA/QLoRA 微调，再延伸至 RAG、Agent 与 GRPO 等 Agentic RL 内容。提供在线阅读、PDF 与 PPT 资源，第5/6章训练代码按章节拆分依赖，需具备 Python 与深度学习基础。", "highlights": ["8 章覆盖从 NLP 基础到 Agentic-RL（GRPO、Search-R1、ReTool）的完整学习路径", "动手实现 LLaMA2 并完成预训练、SFT、LoRA/QLoRA 微调全流程", "提供教程 PDF 与配套 PPT 下载，附 ModelScope 模型与创空间体验", "Extra Chapter 开放社区 Blog 投稿（PR 贡献机制）"], "use_cases": ["系统学习 Transformer 与大语言模型原理", "按教程用 PyTorch 与 Transformers 框架动手训练小型 LLM", "了解 RAG、Agent 与 Agentic RL 的入门实践"]}, "filters": {"ai_role": "ai-knowledge", "license_risk": "none", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "科研", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["教程/课程", "LLM原理", "模型训练", "RAG", "Agent"], "domain": "AI 教育/学习教程", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "media", "zh_origin": true, "zh_origin_signals": ["全中文 README", "Datawhale 国内开源社区", "公众号二维码", "CCF × GitLink 联合课程"]}, "trust": {"confidence": "high", "evidence": ["L22: &emsp;&emsp;本项目是一个**系统性的 LLM 学习教程**，将从 NLP 的基本研究方法出发，根据 LLM 的思路及原理逐层深入，依次为读者剖析 LLM 的架构基础和训练过程。同时，我们会结合目前 LLM 领域最主流的代码框架，", "L97: &emsp;&emsp;本项目分为两部分——基础知识与实战应用。第1章～第4章是基础知识部分，从浅入深介绍 LLM 的基本原理。其中，第1章简单介绍 NLP 的基本任务和发展，为非 NLP 领域研究者提供参考；第2章介绍 LLM 的基本架构", "L145: 本作品采用知识共享署名-非商业性使用-相同方式共享 4.0 国际许可协议进行许可。"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "vllm", "rel": "mention", "lines": [64], "note": "Blog 标题提及 vLLM，非本教程接入的推理通道", "quotes": ["- S1: Thinking Budget with vLLM @不要葱姜蒜 2025-8-03"]}], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "34b2f6c57fe0": {"fn": "openai/codex-plugin-cc", "sha": "34b2f6c57fe0", "source": "readme", "identity": {"one_liner": "让 Claude Code 用户调用 Codex 做代码审查与任务委派的插件", "review": "OpenAI 官方发布的 Claude Code 插件，通过 /plugin marketplace 安装后，在 Claude Code 工作流内提供 /codex:review、/codex:adversarial-review 等斜杠命令调用 Codex 做只读代码审查，并提供 /codex:rescue、/codex:transfer 等命令把任务委派给 Codex、迁移会话上下文、管理后台作业。插件封装本地 Codex CLI 与 app server，复用已有安装、认证与 config.toml 配置；需要 ChatGPT 订阅或 OpenAI API key，以及 Node.js 18.18+。可选启用 review gate 在 Claude 停止前执行 Codex 审查。", "highlights": ["/codex:review 只读审查与 /codex:adversarial-review 可定向质询审查", "/codex:rescue 通过子代理把调查、修 bug 等任务委派给 Codex", "/codex:transfer 把 Claude Code 会话迁移为 Codex 线程，可在 App/TUI 续接", "复用本地 Codex CLI 的安装、认证与 config.toml 配置"], "use_cases": ["在 Claude Code 里对未提交改动或分支差异跑 Codex 代码审查", "把调试、修测试等任务委派给 Codex 后台运行并查看进度", "在 Claude Code 与 Codex 之间无缝续接同一会话上下文"]}, "filters": {"ai_ro