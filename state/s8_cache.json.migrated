isk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "medium", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "https://javaguide.cn", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["面试准备", "Java后端", "知识库", "学习路线"], "domain": "教育/职业求职", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["简体中文 README", "Gitee 镜像", "国内中大厂面试语境", "微信公众号"]}, "trust": {"confidence": "high", "evidence": ["L12: > - **大模型实战项目**： ⭐AI 智能面试辅助平台 + RAG 知识库（基于 Spring Boot 4.0 + Java 21 + Spring AI 2.0，非常适合作为学习和简历项目，学习门槛低）。", "L22: 面向后端开发者的 AI 应用开发、AI 编程实战与面试指南已开源，涵盖 LLM、Agent、RAG、MCP、Claude Code、Codex 等核心技术与工程实践。对标 JavaGuide！有帮助的话，欢迎 Star！", "L38: ## Java"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [22], "note": "仅在 AI 指南介绍中随 Claude Code 提及，无接入", "quotes": ["面向后端开发者的 AI 应用开发、AI 编程实战与面试指南已开源，涵盖 LLM、Agent、RAG、MCP、Claude Code、Codex 等核心技术与工程实践。对标 JavaGuide！有帮助的话，欢迎 Star！"]}], "install": [], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [22], "note": "作为 AI 指南覆盖的技术被列出，非替代/竞品", "quotes": ["面向后端开发者的 AI 应用开发、AI 编程实战与面试指南已开源，涵盖 LLM、Agent、RAG、MCP、Claude Code、Codex 等核心技术与工程实践。对标 JavaGuide！有帮助的话，欢迎 Star！"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "d4ba9a8f2849": {"fn": "DietrichGebert/ponytail", "sha": "d4ba9a8f2849", "source": "readme", "identity": {"one_liner": "给 AI 编码 agent 注入“极简优先”编码原则的提示词技能包", "review": "以单个 SKILL.md 提示词为核心的 agent 技能：在写代码前按七级阶梯依次判断“是否需要写、仓库已有、标准库、平台特性、已有依赖、能否一行”，只在必要时写最小实现；不做代码高尔夫，验证、错误处理、安全与可访问性不在裁剪范围，含分支/循环/解析/金钱/安全的逻辑要求附带小测试。提供 /ponytail-review（读 diff 之外被触碰的代码做审查）与 /ponytail-audit（全仓库按优先级排序）等命令，以及 Claude Code 中的成本/token/复用率状态条与本地统计面板。宣称在 20 个 agent 上可用。", "highlights": ["七级阶梯决策：优先复用仓库代码、标准库与平台特性", "/ponytail-review 读取变更触碰的全部代码而非仅 diff", "Claude Code 提示条展示成本、token、agent 时间与代码复用率", "/ponytail-debt 汇集 shortcut: 注释为技术债清单"], "use_cases": ["让编码 agent 复用仓库现有组件而不是重造轮子", "审查 diff 之外被改动波及的文件与安全隐患", "统计并追踪 AI 编码的成本、token 与复用率"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "permissive", "deploy": "desktop", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["prompt工程", "agent技能", "编码助手", "代码审查"], "domain": "开发者工具/AI 编码", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L96: Ponytail is one prompt: `skills/ponytail/SKILL.md`. The compact version, for agents that read a rules file, is `AGENTS.m", "L139: Commands need a skill-capable host (Claude Code, Codex, Devin CLI, OpenCode, Gemini, Antigravity CLI, pi, Hermes Agent, "], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [26, 78, 100], "note": "README 未直接点名 Anthropic，仅通过其产品 Claude Code 间接相关", "quotes": [" Benchmarked in Claude Code, the same agent with and without the skill: 39 tasks including a real FastAPI + React repo, ", "In Claude Code, ponytail now shows a band above the prompt: what the current task costs, how many tokens and how much ag", "**Claude Code**, as two separate prompts:"]}, {"term": "xai", "rel": "mention", "lines": [139], "note": "仅以宿主 'Grok Build' 形式出现，非模型接入声明", "quotes": ["Commands need a skill-capable host (Claude Code, Codex, Devin CLI, OpenCode, Gemini, Antigravity CLI, pi, Hermes Agent, "]}], "install": [], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [26, 76, 78, 100], "note": "主要支持宿主，非替代/竞品", "quotes": [" Benchmarked in Claude Code, the same agent with and without the skill: 39 tasks including a real FastAPI + React repo, ", " The ponytail band in Claude Code, above the prompt. Detail mode: cost $23.80, last turn $1.14, average $0.72 per turn; ", "In Claude Code, ponytail now shows a band above the prompt: what the current task costs, how many tokens and how much ag", "**Claude Code**, as two separate prompts:"]}, {"term": "GitHub Copilot", "rel": "mention", "lines": [118, 139], "note": "列出的可加载 agent 之一", "quotes": ["**Any other agent:** copy `AGENTS.md` into your project, or ask your agent to install `skills/ponytail/SKILL.md` as a sk", "Commands need a skill-capable host (Claude Code, Codex, Devin CLI, OpenCode, Gemini, Antigravity CLI, pi, Hermes Agent, "]}, {"term": "Cursor", "rel": "mention", "lines": [118, 139], "note": "支持的宿主，仅规则文件/等级切换", "quotes": ["**Any other agent:** copy `AGENTS.md` into your project, or ask your agent to install `skills/ponytail/SKILL.md` as a sk", "Commands need a skill-capable host (Claude Code, Codex, Devin CLI, OpenCode, Gemini, Antigravity CLI, pi, Hermes Agent, "]}, {"term": "Windsurf", "rel": "mention", "lines": [139], "note": "指令适配器宿主之一", "quotes": ["Commands need a skill-capable host (Claude Code, Codex, Devin CLI, OpenCode, Gemini, Antigravity CLI, pi, Hermes Agent, "]}, {"term": "Devin", "rel": "mention", "lines": [139], "note": "Devin CLI 作为技能宿主被提及", "quotes": ["Commands need a skill-capable host (Claude Code, Codex, Devin CLI, OpenCode, Gemini, Antigravity CLI, pi, Hermes Agent, "]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "11d3f69f4b32": {"fn": "langgenius/dify", "sha": "11d3f69f4b32", "source": "readme", "identity": {"one_liner": "给团队的 LLM 应用开发平台：可视化构建工作流、RAG 与 Agent", "review": "开源 LLM 应用开发平台，界面整合 AI 工作流、RAG 管道、Agent 能力、模型管理与可观测性（含 Opik、Langfuse、Arize Phoenix 集成）。工作流在可视化画布上构建；模型支持数百个专有/开源 LLM 及 OpenAI API 兼容模型；Agent 带独立沙箱，可运行命令、安装软件、处理文件，并接入 Marketplace 工具、MCP 服务器与自有 API。所有功能提供对应 API（Backend-as-a-Service）。部署方式：Docker Compose 自托管、Cloud 托管或企业版（SSO/RBAC）。最低要求 CPU 2 核、内存 4 GiB。", "highlights": ["可视化画布构建 AI 工作流，RAG 管道覆盖文档摄取到检索（支持 PDF/PPT 抽取）", "接入数百个专有/开源 LLM 及任意 OpenAI API 兼容模型", "Agent 自带沙箱，可执行命令、安装软件、连接 MCP 服务器与自有 API", "全部功能附 API，Cloud/VPC/自托管三种部署路径"], "use_cases": ["团队在协作工作区里从原型快速搭建到生产的 LLM 应用", "给文档知识库接入 RAG 问答管道", "用可视化编排把多个模型和工具串成自动化工作流"]}, "filters": {"ai_role": "ai-native", "license_risk": "none", "deploy": "self-host", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "企业", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["LLM应用平台", "工作流编排", "RAG", "Agent", "低代码"], "domain": "LLM 应用开发平台", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L58: Dify is an open-source LLM app development platform. Its intuitive interface combines AI workflow, RAG pipeline, agent c", "L90: Seamless integration with hundreds of proprietary / open-source LLMs from dozens of inference providers and self-hosted ", "L113: - **Self-hosting Dify Community Edition **"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "docker", "rel": "support", "lines": [67, 73], "quotes": ["The easiest way to start the Dify server is through Docker Compose. Before running Dify with the following commands, mak", "docker compose up -d"]}], "hardware": [{"term": "RAM >= 4 G", "rel": "support", "lines": [65], "quotes": ["> - RAM >= 4 GiB"]}], "products": [{"term": "Dify", "rel": "mention", "lines": [58, 113, 117], "note": "产品自身名称，非替代/竞品对象", "quotes": ["Dify is an open-source LLM app development platform. Its intuitive interface combines AI workflow, RAG pipeline, agent c", "- **Self-hosting Dify Community Edition **", "- **Dify Enterprise **"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "1788fe37f265": {"fn": "anthropics/claude-code", "sha": "1788fe37f265", "source": "readme", "identity": {"one_liner": "终端里的 agentic 编码工具，用自然语言操作代码库", "review": "Anthropic 出品的命令行编码代理：读取并理解代码库，通过自然语言执行例行任务、解释复杂代码、处理 git 工作流。可在终端、IDE 中使用，也可在 GitHub 上以 @claude 触发。仓库附带插件机制，以自定义命令和 agent 扩展功能。安装支持 macOS/Linux/Windows 的官方脚本、Homebrew 与 WinGet，npm 安装方式已被标注为弃用。使用数据（代码接受/拒绝、会话数据）会被收集用于反馈，官方声明有限保留期且不用于模型训练。", "highlights": ["终端内自然语言驱动的 agentic 编码，理解代码库上下文", "支持终端、IDE、GitHub @claude 多种使用入口", "插件机制通过自定义命令和 agent 扩展功能", "内置 /bug 命令直接上报问题"], "use_cases": ["在终端用自然语言完成例行编码任务", "让 AI 解释复杂代码逻辑", "用自然语言处理 git 工作流", "通过插件为工作流添加自定义命令和 agent"]}, "filters": {"ai_role": "ai-native", "license_risk": "none", "deploy": "library", "model_dep": "locked-api", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["编码代理", "CLI 工具", "git 工作流", "插件系统"], "domain": "开发者工具/AI 编码", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic"]}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "mid", "evidence": ["L5: Claude Code is an agentic coding tool that lives in your terminal, understands your codebase, and helps you code faster ", "L46: This repository includes several Claude Code plugins that extend functionality with custom commands and agents. See the "], "xcheck": {"install_missing": ["npm"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [3, 5], "quotes": [" [![npm]](https://www.npmjs.com/package/@anthropic-ai/claude-code)", "Claude Code is an agentic coding tool that lives in your terminal, understands your codebase, and helps you code faster "]}], "install": [{"term": "npm", "rel": "mention", "lines": [11, 37, 39], "note": "npm 安装方式已弃用，仅作为遗留途径提及", "quotes": ["> Installation via npm is deprecated. Use one of the recommended methods below.", " **NPM (Deprecated):**", "    npm install -g @anthropic-ai/claude-code"]}, {"term": "brew", "rel": "support", "lines": [22, 24], "quotes": [" **Homebrew (MacOS/Linux):**", "    brew install --cask claude-code"]}], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [1, 5, 15, 46, 50], "note": "本产品自身", "quotes": ["# Claude Code", "Claude Code is an agentic coding tool that lives in your terminal, understands your codebase, and helps you code faster ", "1. Install Claude Code:", "This repository includes several Claude Code plugins that extend functionality with custom commands and agents. See the ", "We welcome your feedback. Use the `/bug` command to report issues directly within Claude Code, or file a GitHub issue."]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": true, "lines": [11, 37]}}}, "346c3774f88b": {"fn": "open-webui/open-webui", "sha": "346c3774f88b", "source": "readme", "identity": {"one_liner": "自托管 AI 交互界面，接入本地与云端多模型", "review": "自托管 Web 平台，通过 Ollama 与 OpenAI 兼容 API 连接本地及云端模型，提供 RBAC 用户组、插件体系（Filters/Actions/Pipes/Tools/Skills）、MCP 与 OpenAPI 工具服务器接入、RAG（9 种向量数据库、混合检索）、网络搜索注入、图像生成、语音视频通话、日历与定时任务、企业认证（LDAP/SSO/SCIM）及 OpenTelemetry 可观测性。可通过 pip、Docker、Kubernetes 安装，支持纯 CPU 或 CUDA 镜像，另有 macOS/Windows/Linux 原生桌面应用。", "highlights": ["支持 Ollama 与任何 OpenAI 兼容 API（LMStudio、GroqCloud、Mistral、OpenRouter、vLLM 等）", "插件体系与 MCP/OpenAPI 工具服务器接入，可构建带终端与文件系统的 Agent", "RAG 支持 9 种向量数据库、BM25+向量混合检索与多家网络搜索提供商", "企业功能：RBAC、LDAP/SSO/SCIM、多节点水平扩展、OpenTelemetry"], "use_cases": ["在本地或私有服务器上部署多模型对话界面", "团队共享的 AI 工作台，带权限管理与用量统计", "基于文档知识库的检索增强问答", "给 Agent 配置