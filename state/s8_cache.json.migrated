[]}}}, "87bc1bf669d3": {"fn": "agentscope-ai/QwenPaw", "sha": "87bc1bf669d3", "source": "readme", "identity": {"one_liner": "可自托管部署的个人 AI 助手，多渠道接入", "review": "面向个人用户的 AI 助手，可部署在本地或云端。采用三层记忆机制（工作上下文、完整历史、基于 ReMe 的个人知识库），内置 QwenPaw-Flash 系列模型（2B–35B-A3B），也可接入 Ollama、LM Studio 或 14+ 云端模型服务。支持 DingTalk、Lark、WeChat、Discord、Telegram、iMessage、QQ 等多渠道接入，以及 Console、TUI、桌面应用访问。扩展能力包括 Skills、Plugin 市场、MCP 集成、多 Agent 并行与 ACP 协议编排。安全机制含沙箱、Tool Guard、File Guard、Skill Scanner 与访问策略。", "highlights": ["三层记忆：工作上下文、全量历史、自演化个人知识库（ReMe）", "内置 QwenPaw-Flash 模型，本地运行无需 API key；兼容 Ollama/LM Studio/14+ 云服务", "多渠道接入：DingTalk/Lark/WeChat/Discord/Telegram/iMessage/QQ 单实例全覆盖", "Kernel 级沙箱、Tool Guard、Skill Scanner 等安全机制"], "use_cases": ["本地部署一个数据不出机器的个人 AI 助手", "把新闻摘要、报告生成等定时任务推送到多个聊天渠道", "通过 Skills/插件/MCP 扩展专属工作流", "在代码项目里进行文件读写、审查与测试"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "desktop", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": true, "lines": [213, 231]}}, "links": {"scenario_tags": ["个人AI助手", "多渠道接入", "自托管", "MCP", "多Agent"], "domain": "个人 AI 助手/Agent 平台", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["ollama"]}, "intel": {"maintainer_type": "company", "zh_origin": true, "zh_origin_signals": ["DingTalk/QQ/微信/Lark 渠道支持", "阿里云 ACR 镜像与阿里云 ECS 一键部署", "ModelScope 部署选项"]}, "trust": {"confidence": "high", "evidence": ["L26: Your personal AI assistant — deploy locally or in the cloud, extend with Skills & Plugins, connect across every channel.", "L31: |**Local or cloud, runs free**|QwenPaw-Flash models (2B / 4B / 9B / 35B-A3B / 27B) trained for agent tasks. Built-in Qwe", "L36: |**Reachable anywhere**|DingTalk, Lark, WeChat, Discord, Telegram, iMessage, QQ — one instance, all channels. Console, T"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "ollama", "rel": "support", "lines": [31, 171, 173, 184], "quotes": ["|**Local or cloud, runs free**|QwenPaw-Flash models (2B / 4B / 9B / 35B-A3B / 27B) trained for agent tasks. Built-in Qwe", "> **Connecting to Ollama or other services on the host machine**", "> Inside a Docker container, `localhost` refers to the container itself, not your host machine. If you run Ollama (or ot", "> Then in QwenPaw **Settings → Models**, change the Base URL to `http://host.docker.internal:<port>` — for example, `htt"]}, {"term": "deepseek", "rel": "mention", "lines": [279], "quotes": ["If you use a **cloud LLM API** (e.g., DashScope / Qwen, OpenAI, Anthropic, Google Gemini, DeepSeek, Kimi, OpenRouter, an"]}, {"term": "openrouter", "rel": "mention", "lines": [279], "quotes": ["If you use a **cloud LLM API** (e.g., DashScope / Qwen, OpenAI, Anthropic, Google Gemini, DeepSeek, Kimi, OpenRouter, an"]}], "install": [{"term": "pypi", "rel": "support", "lines": [66, 71], "quotes": ["### Option 1: Pip Install", "pip install qwenpaw"]}, {"term": "binary", "rel": "support", "lines": [122], "quotes": ["> - **Manually install uv**: Refer to the GitHub Release to download `uv.exe` and place it in `%USERPROFILE%\\.local\\bin`"]}, {"term": "docker", "rel": "support", "lines": [159, 160, 169], "quotes": ["docker pull agentscope/qwenpaw:latest", "docker run -p 127.0.0.1:8088:8088 \\", "Then open **http://127.0.0.1:8088/** for the Console. Config, memory, and skills are stored in the `qwenpaw-data` volume"]}, {"term": "source", "rel": "mention", "lines": [360], "quotes": ["git clone https://github.com/agentscope-ai/QwenPaw.git"]}], "hardware": [], "products": [{"term": "通义千问", "rel": "mention", "lines": [279, 373], "quotes": ["If you use a **cloud LLM API** (e.g., DashScope / Qwen, OpenAI, Anthropic, Google Gemini, DeepSeek, Kimi, OpenRouter, an", "QwenPaw stands for Qwen Personal Agent Workstation, and also embodies the wisdom of Qwen and the warmth of a Paw."]}, {"term": "Kimi", "rel": "mention", "lines": [279], "quotes": ["If you use a **cloud LLM API** (e.g., DashScope / Qwen, OpenAI, Anthropic, Google Gemini, DeepSeek, Kimi, OpenRouter, an"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "93ca03e3f937": {"fn": "esengine/DeepSeek-Reasonix", "sha": "93ca03e3f937", "source": "readme", "identity": {"one_liner": "开源终端/桌面编码 Agent：读写代码、跑命令与测试", "review": "Reasonix 是开源 AI 编码助手，程序运行在用户本地，模型由用户自行配置并直接付费。用户用自然语言描述任务，它在指定项目文件夹内读取代码、编辑文件、运行命令与测试，并展示每步操作；支持权限分级、plan 模式与按会话回合的文件回滚（仅覆盖其编辑工具改动的文件）。分发形态包括 Studio 桌面应用、终端 CLI/TUI、浏览器界面与 VS Code 等 ACP 编辑器扩展，四者为同一引擎。2.x 处于活跃开发，1.x 处于维护状态。", "highlights": ["DeepSeek 内置预设，任意 OpenAI 兼容端点经一条配置即可接入", "MCP 服务器提供工具/提示/资源，Extension Protocol 可拦截运行时事件", "CGO_ENABLED=0 单二进制静态分发，一条命令交叉编译六个目标", "编辑工具改动的文件按会话回合可回滚，不触碰 git 历史"], "use_cases": ["在终端里用自然语言让 Agent 完成改代码、跑测试的任务", "通过 VS Code 扩展在编辑器内使用带审批的编码助手", "接入自有 OpenAI 兼容模型服务做本地编码代理"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "desktop", "model_dep": "locked-api", "hardware": null, "install_friction": "low", "maturity": "idea"}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": true, "lines": [96, 104]}}, "links": {"scenario_tags": ["编码Agent", "CLI工具", "桌面应用", "LLM基础设施", "插件系统"], "domain": "开发者工具/AI 编码", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["deepseek"]}, "intel": {"maintainer_type": "individual", "zh_origin": true, "zh_origin_signals": ["双语 README（简体中文）", "QQ 群 1093562660", "抖音账号 做游戏的小鱼"]}, "trust": {"confidence": "high", "evidence": ["L37:  An open-source coding agent for your terminal, desktop, browser and editor.", "L54: Reasonix is an open-source AI coding assistant. The program runs on your computer; the AI model is a service you configu", "L113: - **Multi-model & composable.** DeepSeek ships as a preset; any"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "deepseek", "rel": "support", "lines": [56, 113], "quotes": ["You pick the model: a DeepSeek preset is built in, any OpenAI-compatible service is one config entry, and you pay the mo", "- **Multi-model & composable.** DeepSeek ships as a preset; any"]}, {"term": "anthropic", "rel": "mention", "lines": [50], "note": "赞助商路由服务提及 Claude，非本产品接入 Anthropic", "quotes": [" Right Code Thanks to Right Code for sponsoring this project! Right Code reliably provides routing services for models s"]}], "install": [{"term": "binary", "rel": "support", "lines": [68, 147], "quotes": ["1. Download and install the desktop app, Reasonix Studio, from the releases page.", "The same release also carries the 2.x `reasonix` CLI as archives for"]}, {"term": "npm", "rel": "support", "lines": [91, 156], "quotes": ["|**Reasonix 1.x**|`main-v2`|Maintenance / stable|`npm i -g reasonix` · desktop download|", "npm i -g reasonix                  # any OS; pulls the prebuilt native binary"]}, {"term": "brew", "rel": "support", "lines": [157], "quotes": ["brew install esengine/reasonix/reasonix   # macOS"]}, {"term": "source", "rel": "support", "lines": [179, 190], "quotes": ["git clone https://github.com/esengine/DeepSeek-Reasonix.git", "make build      # -> bin/reasonix(.exe)"]}], "hardware": [], "products": [{"term": "Claude Code", "rel": "mention", "lines": [50], "note": "赞助商描述中提及，非替代/竞品表述", "quotes": [" Right Code Thanks to Right Code for sponsoring this project! Right Code reliably provides routing services for models s"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "7428f882f746": {"fn": "DayuanJiang/next-ai-draw-io", "sha": "7428f882f746", "source": "readme", "identity": {"one_liner": "通过对话生成与编辑 draw.io 图表的 AI 工具", "review": "以自然语言描述生成 draw.io 图表的工具，支持手动编辑、选中局部让 AI 修改、每次 AI 变更生成可对比/恢复/撤销的版本卡片，导出 .drawio/.png/.svg。内置 AWS/Azure/GCP/Kubernetes 图标库，可上传截图、草图、PDF、Markdown 等由 AI 重绘为图表。提供 Web 应用、Windows/macOS/Linux 桌面应用及面向 Claude Code、Cursor、VS Code 等 agent 的 MCP 服务器；支持 25 家模型服务商，API key 存于本地浏览器。自托管需配置服务商与 API key。", "highlights": ["对话生成与局部选中编辑，每次 AI 变更为可对比/恢复的版本卡片", "MCP 服务器形式接入 Claude Code、Cursor、VS Code 等客户端", "内置 AWS、Azure、GCP、Kubernetes 图标库与连接线流动动画", "支持 25 家模型服务商及 OpenAI 兼容自定义 URL，key 保留在本地"], "use_cases": ["一句话生成云架构图、流程图、时序图", "把截图、草图或代码文件重绘为图表", "在 Cursor/VS Code 等 agent 中直接绘制图表", "自托管部署给团队内部使用"]}, "filters": {"ai_role": "ai-native", "license_risk": "permissive", "deploy": "desktop", "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": "next-ai-drawio.jiang.jp", "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["图表生成", "draw.io", "MCP服务器", "对话式编辑", "架构图"], "domain": "开发者工具/图表生成", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["anthropic", "ollama", "deepseek", "openrouter", "azure", "bedrock"]}, "intel": {"maintainer_type": "individual", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L3: **Draw and edit draw.io diagrams by chatting with an AI.**", "L18: Available as a web app, a desktop app for Windows, macOS and Linux, and an MCP server for AI agents such as Claude Code,", "L150: 25 providers are supported: AWS Bedrock (default), OpenAI, Anthropic, Google AI, Google Vertex AI, Azure OpenAI, Ollama,"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [150], "quotes": ["25 providers are supported: AWS Bedrock (default), OpenAI, Anthropic, Google AI, Google Vertex AI, Azure OpenAI, Ollama,"]}, {"term": "ollama", "rel": "support", "lines": [150], "quotes": ["25 providers are supported: AWS Bedrock (default), OpenAI, Anthropic, Google AI, Google Vertex AI, Azure OpenAI, Ollama,"]}, {"term": "de