ned": [], "ecosystem_compat": ["bedrock", "ollama"]}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L8: Free multi-platform database tool for developers, SQL programmers, database administrators and analysts.", "L64: - All DBeaver products contain AI Chat view similar to classic LLM chats.", "L71: - Pro versions provide additional AI tools + native support of Anthropic/Grok/Azure/Bedrock/Gemini/Ollama providers."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "xai", "rel": "mention", "lines": [71], "note": "以 Grok 名义出现在 Pro 版原生支持列表中", "quotes": ["- Pro versions provide additional AI tools + native support of Anthropic/Grok/Azure/Bedrock/Gemini/Ollama providers."]}, {"term": "bedrock", "rel": "support", "lines": [71], "note": "Pro 版原生支持 Bedrock", "quotes": ["- Pro versions provide additional AI tools + native support of Anthropic/Grok/Azure/Bedrock/Gemini/Ollama providers."]}, {"term": "ollama", "rel": "support", "lines": [71], "note": "Pro 版原生支持 Ollama", "quotes": ["- Pro versions provide additional AI tools + native support of Anthropic/Grok/Azure/Bedrock/Gemini/Ollama providers."]}], "install": [], "hardware": [], "products": [{"term": "GitHub Copilot", "rel": "mention", "lines": [70], "note": "作为社区版可选 AI provider 列出，非替代/竞品表述", "quotes": [" - Copilot"]}], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "6bc64dfd7ac5": {"fn": "roboflow/supervision", "sha": "6bc64dfd7ac5", "source": "readme", "identity": {"one_liner": "计算机视觉开发者的可复用工具集：模型接入、标注、数据集处理", "review": "面向计算机视觉应用的 Python 工具库：提供模型无关的检测/分类/分割结果封装（sv.Detections），内置 Ultralytics、Transformers、MMDetection、Inference、rfdetr 等库的连接器；提供可自定义的图像标注器，以及 YOLO 等（含 COCO）格式的数据集加载、拆分、合并、转换与保存工具。需 Python>=3.10，通过 pip 安装，含教程与文档。使用 Inference 模型需 Roboflow API KEY。", "highlights": ["模型无关设计，内置多框架检测结果连接器