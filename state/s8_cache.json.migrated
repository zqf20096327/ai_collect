ative", "license_risk": "none", "deploy": "library", "model_dep": "locked-api", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["代码生成", "AI开发者", "多Agent", "开发者工具", "CLI"], "domain": "开发者工具/代码生成", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": ["groq", "openrouter"]}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "mid", "evidence": ["L40: GPT Pilot is the core technology for the Pythagora VS Code extension that aims to provide **the first real AI developer ", "L46: GPT Pilot aims to research how much LLMs can be utilized to generate fully working, production-ready apps while the deve", "L151: # 🕴How's GPT Pilot different from _Smol developer_ and _GPT engineer_?"], "xcheck": {"install_missing": ["pypi"]}, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "groq", "rel": "support", "lines": [74], "quotes": [" - LLM Provider (`openai`, `anthropic` or `groq`) key and endpoints (leave `null` for default) (note that Azure and Open"]}, {"term": "openrouter", "rel": "compat", "lines": [74], "note": "经 openai 设置接入，非专属通道", "quotes": [" - LLM Provider (`openai`, `anthropic` or `groq`) key and endpoints (leave `null` for default) (note that Azure and Open"]}], "install": [{"term": "source", "rel": "support", "lines": [67, 68, 69, 70, 71, 72, 73, 78], "quotes": ["1. `git clone https://github.com/Pythagora-io/gpt-pilot.git` (clone the repo)", "2. `cd gpt-pilot` (go to the repo folder)", "3. `python3 -m venv venv` (create a virtual environment)", "4. `source venv/bin/activate` (or on Windows `venv\\Scripts\\activate`) (activate the virtual environment)", "5. `pip install -r requirements.txt` (install the dependencies)", "6. `cp example-config.json config.json` (cr