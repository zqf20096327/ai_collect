osystem_compat": ["anthropic"]}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L1: # Claude Cookbooks", "L3: The Claude Cookbooks provide code and guides designed to help developers build with Claude, offering copy-able code snip", "L7: To make the most of the examples in this cookbook, you'll need a Claude API key (sign up for free here)."], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "support", "lines": [1, 3, 7], "note": "Anthropic 官方仓库，围绕 Claude API 构建", "quotes": ["# Claude Cookbooks", "The Claude Cookbooks provide code and guides designed to help developers build with Claude, offering copy-able code snip", "To make the most of the examples in this cookbook, you'll need a Claude API key (sign up for free here)."]}], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "04f78afe5974": {"fn": "CherryHQ/cherry-studio", "sha": "04f78afe5974", "source": "readme", "identity": {"one_liner": "多模型桌面 AI 客户端：统一接入云/本地 LLM 与助手", "review": "支持多 LLM 提供商的桌面客户端，覆盖 Windows、Mac 和 Linux。核心功能包括：接入主流云服务（OpenAI、Gemini、Anthropic 等）与本地模型（Ollama、LM Studio）；300+ 预配置助手与自定义助手、多模型同时对话；支持文本/图片/Office/PDF 文档处理、WebDAV 备份、Mermaid 图表；集成搜索、翻译、MCP 服务器等工具。安装后即用，无需环境配置。另有企业版提供私有部署、统一模型管理与知识库（非完全开源）。社区版采用 AGPL-3.0 许可，商业豁免需联系官方。", "highlights": ["支持 OpenAI、Gemini、Anthropic 等云服务与 Ollama、LM Studio 本地模型", "300+ 预配置 AI 助手，支持多模型同时对话", "支持 MCP（Model Context Protocol）服务器与小程序", "跨平台桌面应用，开箱即用无需环境配置"], "use_cases": ["在一个桌面客户端中统一使用多家云 LLM 与本地模型", "调用预配置助手处理文档、翻译和代码任务", "企业私有部署集中管理团队模型访问与知识库"]}, "filters": {"ai_role": "ai-ecosystem", "license_risk": "dual", "deploy": null, "model_dep": "local-ok", "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "消费者", "paper_url": null, "demo_url"