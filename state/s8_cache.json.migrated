, "highlights": ["通过 RPC 暴露多语言 API，读取图像/状态并控制载具", "支持 PX4、ArduPilot 软件在环与 PX4 硬件在环仿真", "ComputerVision 模式可采集深度、视差、表面法线、分割图像", "录制按钮一键生成位姿+图像训练数据"], "use_cases": ["在仿真中实验深度学习/强化学习的自主驾驶与飞行算法", "采集带位姿标注的图像数据训练模型", "在仿真器中写代码再迁移到真实载具（伴随计算机部署）", "切换天气条件做计算机视觉实验"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "none", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "科研", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["仿真器", "自动驾驶", "无人机", "强化学习", "计算机视觉"], "domain": "机器人/自动驾驶仿真", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L3: AirSim is a simulator for drones, cars and more, built on Unreal Engine (we now also have an experimental Unity release)", "L7: Our goal is to develop AirSim as a platform for AI research to experiment with deep learning, computer vision and reinfo", "L55: AirSim exposes APIs so you can interact with the vehicle in the simulation programmatically. You can use these APIs to r"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "5b6e896c9ed9": {"fn": "teambit/bit", "sha": "5b6e896c9ed9", "source": "readme", "identity": {"one_liner": "为开发者提供组件化代码构建系统并让 AI agent 复用组件", "review": "Bit 是一个连接组件与应用、覆盖开发到 CI 的构建系统：将源码组织为可组合的组件，支持创建可复用 UI 组件、定义组件蓝图模板、组合应用外壳、部署应用与服务。通过 MCP 让 AI agent 创建和复用组件。支持 monorepo、polyrepo 或无仓库结构，提供 NodeJS、React、Angular、Vue、React Native、NextJS 等官方开发环境，原生支持 TypeScript 与 ESM。通过 npx 安装器装到 PATH，组件可通过标准包管理器安装；托管 scope 需使用 Bit Cloud 或自托管。", "highlights": ["通过 MCP 使 AI agent 能创建和复用组件", "提供 NodeJS、React、Angular、Vue、React Native、NextJS 等官方开发环境", "支持 monorepo、polyrepo 或无仓库的代码结构", "组件可用 npm 等标准包管理器安装"], "use_cases": ["在 monorepo 或多仓库中管理可复用的 UI 组件与模块", "组合可复用组件构建应用外壳并部署", "让 AI agent 在开发流程中复用已有组件避免重复创建"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "none", "deploy": "library", "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["组件化开发", "monorepo", "前端", "构建系统", "AI agent"], "domain": "软件开发工具/前端工程", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L12: Bit is the build system to connect components and apps from development to CI in the AI era. Bit organizes source code i", "L21: Bit supports all tooling in the JS ecosystem and comes out of the box with official dev environments for NodeJS, React, "], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [], "install": [{"term": "npm", "rel": "support", "lines": [32, 108], "note": "npx 安装器安装 Bit；组件通过 npm install 安装", "quotes": ["npx @teambit/bvm install", "npm install @my-org/users.pages.login"]}], "hardware": [], "products": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}}}, "a4e7126f9696": {"fn": "browser-use/browser-harness", "sha": "a4e7126f9696", "source": "readme", "identity": {"one_liner": "让编码 Agent 驱动真实 Chrome，以登录态完成浏览器操作", "review": "通过一段 setup prompt 将 Claude Code、Codex 或 Cursor 连接到用户本机已登录的 Chrome：经 DevTools Protocol（CDP）通信，支持打开页面、点击、输入、读取与下载。Agent 运行时在本地工作区补写可复用 helper，`SKILL.md` 提供工作流说明，`src/` 目录保持受保护。另提供 `browser-harness-mcp`，经 stdio 将浏览器控制 helper 暴露为 MCP 工具供任意 MCP 客户端调用。MIT 许可。", "highlights": ["通过 CDP 连接用户真实已登录 Chrome 执行操作", "Agent 运行时自动补写可复用 helper", "提供 browser-harness-mcp，支持任意 MCP 客户端驱动浏览器", "setup prompt 一步安装（uv + Python 3.12）"], "use_cases": ["让编码 Agent 以我的登录态抓取或下载网页内容", "自动化日常网页操作而无需自己打开浏览器", "通过 MCP 客户端直接驱动浏览器任务"]}, "filters": {"ai_role": "ai-enhanced", "license_risk": "permissive", "deploy": null, "model_dep": null, "hardware": null, "install_friction": "low", "maturity": null}, "eval": {"target_user": "开发者", "paper_url": null, "demo_url": null, "self_declared_early": {"flag": false, "lines": []}}, "links": {"scenario_tags": ["浏览器自动化", "AI Agent", "CDP", "MCP"], "domain": "浏览器自动化/AI Agent 工具", "alternative_to": [], "competitors_mentioned": [], "ecosystem_compat": []}, "intel": {"maintainer_type": "company", "zh_origin": false, "zh_origin_signals": []}, "trust": {"confidence": "high", "evidence": ["L5: Browser Harness lets Claude Code, Codex or Cursor use your real Chrome browser: open pages, click, type, read and downlo", "L45: Use your local browser for logged-in, personal work. When you want many browsers in parallel—with live previews, proxies", "L49: `browser-harness-mcp` exposes the browser control helpers as MCP tools over"], "xcheck": null, "ver": 1, "prompt_ver": "1.4", "generated_at": "2026-10-18", "softened": null}, "raw_verdicts": {"providers": [{"term": "anthropic", "rel": "mention", "lines": [5, 26, 50], "note": "提及 Claude Code 等客户端，非模型接入说明", "quotes": ["Browser Harness lets Claude Code, Codex or Cursor use your real Chrome browser: open pages, click, type, read and downlo", "Paste into Claude Code or Codex:", "stdio, so any MCP client (Claude Code, Devin, Cursor, etc.) can drive the"]}], "install": [], "hardware": [], "dual_license": {"flag": false, "lines": [], "quotes": []}, "deprecation": {"flag": false, "lines": []}, "products": [{"term": "Claude Code", "rel": "mention", "lines": [5, 26, 50], "quotes": ["Browser Harness lets Claude Code, Codex or Cursor use your real Chrome browser: open pages, click, type, read and downlo", "Paste into Claude Code or Codex:", "st